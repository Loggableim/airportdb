---
import blogPosts from '../../data/blog-posts.json';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const pageTitle = `${post.title} - World Airport Database Blog`;
const pageDesc = post.excerpt;
const pageUrl = `https://world-airport-database.com/blog/${post.slug}/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="article">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="World Airport Database">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={pageDesc}>
  <script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "datePublished": post.date,
    "author": {"@type":"Organization","name":"World Airport Database"},
    "publisher": {"@type":"Organization","name":"World Airport Database"}
  }, null, 2)}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Open Sans',Arial,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.8}
    :root{--primary:#2ca4dc;--navy:#0B1D3A;--border:#D4E0E8}
    .wrap{max-width:800px;margin:0 auto;padding:0 20px}
    .ah{background:linear-gradient(135deg,var(--navy),#142b4f);padding:36px 0;border-bottom:4px solid var(--primary)}
    .ah h1{color:#fff;font-size:28px;margin-bottom:6px;line-height:1.4}
    .ah .meta{color:#8899aa;font-size:13px}
    .ah .tags{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
    .ah .tags span{background:rgba(44,164,220,.2);color:#2ca4dc;padding:3px 10px;border-radius:3px;font-size:11px;font-weight:600}
    .content{padding:30px 0}
    .content h2{font-size:22px;color:var(--navy);margin:28px 0 12px;border-bottom:2px solid var(--primary);padding-bottom:6px}
    .content h3{font-size:18px;color:var(--navy);margin:20px 0 8px}
    .content p{margin-bottom:16px;font-size:15px;color:#333}
    .content ul,.content ol{margin:0 0 16px 24px;font-size:15px;color:#333}
    .content li{margin-bottom:4px}
    .content table{width:100%;border-collapse:collapse;margin:16px 0;background:#fff;font-size:13px}
    .content table th{background:var(--navy);color:#fff;padding:8px 12px;text-align:left;font-size:12px;text-transform:uppercase}
    .content table td{padding:8px 12px;border:1px solid var(--border)}
    .content table tr:nth-child(even) td{background:#F0F6FC}
    .content .iata-badge{display:inline-block;background:var(--primary);color:#fff;padding:2px 8px;border-radius:3px;font-size:11px;font-weight:700}
    .content a{color:var(--primary)}
    footer{background:var(--navy);color:#8899aa;padding:36px 0 24px;margin-top:40px;font-size:13px;text-align:center}
    footer a{color:var(--primary)}
    .bb{display:inline-block;margin:20px 0;color:var(--primary);font-weight:600;font-size:14px}
  </style>
</head>
<body>
  <div class="ah">
    <div class="wrap">
      <div class="meta">{new Date(post.date).toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})}</div>
      <h1>{post.title}</h1>
      <div class="tags">
        {post.tags.map(tag => <span>{tag}</span>)}
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="content">
      <div set:html={post.content_html} />
    </div>
    <a href="/blog/" class="bb">&larr; Back to Blog</a>
  </div>
  <footer>
    <div class="wrap">
      <div><strong>World Airport Database since 2008</strong> based on open data from <a href="https://ourairports.com/" target="_blank">OurAirports</a></div>
      <div style="margin-top:8px">Not affiliated with IATA or ICAO.</div>
      <div style="margin-top:10px"><a href="/impressum/">Impressum</a></div>
    </div>
  </footer>
</body>
</html>
