---
import blogPosts from '../../data/blog-posts.js';
import { blogCategories, getCategoryBySlug, getSubcategoryBySlug, getAllSubcategories } from '../../data/blog-categories.js';
import { navItems } from '../../data/nav.js';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Helpers
function readingTime(html) {
  const text = (html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = text.split(' ').length;
  return Math.max(1, Math.ceil(words / 200));
}

const category = getCategoryBySlug(post.category);
const subcategory = category ? getSubcategoryBySlug(post.category, post.subcategory) : null;
const readTime = readingTime(post.content_html);
const dateFormatted = new Date(post.date).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
const pageTitle = `${post.title} — World Airport Database Blog`;
const pageUrl = `https://world-airport-database.com/blog/${post.slug}/`;

// Sorted posts for prev/next
const sorted = [...blogPosts].sort((a, b) => new Date(b.date) - new Date(a.date));
const currentIdx = sorted.findIndex(p => p.slug === post.slug);
const prevPost = currentIdx < sorted.length - 1 ? sorted[currentIdx + 1] : null;
const nextPost = currentIdx > 0 ? sorted[currentIdx - 1] : null;

// Related posts: same category, exclude current
const related = sorted.filter(p => p.category === post.category && p.slug !== post.slug).slice(0, 3);

// Recent posts for sidebar (exclude current)
const recentPosts = sorted.filter(p => p.slug !== post.slug).slice(0, 5);

// Categories with counts for sidebar
const catsWithCounts = blogCategories.map(c => ({
  ...c,
  count: sorted.filter(p => p.category === c.slug).length
})).filter(c => c.count > 0);

// Generate ToC from content_html h2/h3
function generateTOC(html) {
  const headings = [];
  const regex = /<h([23])\s*[^>]*id="?([^"]*)"?[^>]*>([\s\S]*?)<\/h[23]>/gi;
  let match;
  while ((match = regex.exec(html)) !== null) {
    headings.push({
      level: parseInt(match[1]),
      id: match[2] || match[3].replace(/<[^>]+>/g, '').toLowerCase().replace(/\s+/g, '-'),
      text: match[3].replace(/<[^>]+>/g, '')
    });
  }
  return headings;
}
const tocItems = generateTOC(post.content_html);

// Add IDs to content_html headings for ToC anchors
function addHeadingIds(html) {
  return html.replace(/<h([23])\s*([^>]*)>/gi, (match, level, attrs) => {
    if (/id=/.test(attrs)) return match;
    const text = match.replace(/<[^>]+>/g, '');
    const id = text.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');
    return `<h${level} ${attrs} id="${id}">`;
  });
}

const processedContent = addHeadingIds(post.content_html);

const activeNav = '/blog/';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.date,
  "author": { "@type": "Organization", "name": "World Airport Database" },
  "publisher": { "@type": "Organization", "name": "World Airport Database" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl }
};
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={post.excerpt}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="article">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={post.excerpt}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="World Airport Database">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={post.excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ── Reset & Base ── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.8;font-size:15px}
    :root{--primary:#2ca4dc;--navy:#0B1D3A;--border:#D4E0E8;--card-bg:#fff;--text:#202c39;--text-light:#5A6B7F;--text-muted:#8899aa;--radius:10px;--shadow:0 1px 4px rgba(11,29,58,.06)}
    a{color:var(--primary);text-decoration:none;transition:color .15s}
    a:hover{color:#1e85b8}

    /* ── Top Nav ── */
    .top-nav{position:sticky;top:0;z-index:100;background:var(--navy);border-bottom:3px solid var(--primary)}
    .nav-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;gap:4px;padding:0 24px;height:56px}
    .nav-inner .brand{font-weight:800;font-size:16px;color:#fff;margin-right:24px;white-space:nowrap}
    .nav-inner .brand span{color:var(--primary)}
    .nav-inner a{color:#d0d8e0;font-size:13px;font-weight:500;padding:6px 14px;border-radius:6px;transition:all .15s}
    .nav-inner a:hover{color:#fff;background:rgba(255,255,255,.08)}
    .nav-inner a.active{color:#fff;background:var(--primary);font-weight:600}
    .nav-inner .spacer{flex:1}
    @media(max-width:768px){.nav-inner{gap:2px;padding:0 12px;overflow-x:auto}.nav-inner .brand{font-size:13px;margin-right:12px}.nav-inner a{font-size:11px;padding:4px 8px;white-space:nowrap}}

    /* ── Breadcrumbs ── */
    .breadcrumbs{max-width:1280px;margin:0 auto;padding:14px 24px 0;font-size:12px;color:var(--text-muted)}
    .breadcrumbs a{color:var(--text-muted)}
    .breadcrumbs a:hover{color:var(--primary)}
    .breadcrumbs .sep{margin:0 6px;color:var(--border)}

    /* ── Layout ── */
    .page-wrap{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;gap:32px;align-items:flex-start}
    @media(max-width:1024px){.page-wrap{flex-direction:column;padding:0 16px;gap:24px}}
    .article-wrap{flex:1;min-width:0}

    /* ── Article ── */
    article{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:28px 32px;margin-bottom:24px}
    @media(max-width:600px){article{padding:16px}}

    /* ── Hero Block ── */
    .article-hero{margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border)}
    .article-hero .ah-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12px;color:var(--text-muted);margin-bottom:8px}
    .article-hero .ah-badges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
    .article-hero .ah-badges .badge{padding:3px 10px;border-radius:4px;font-size:11px;font-weight:600}
    .article-hero .ah-badges .badge.cat{background:var(--navy);color:#fff}
    .article-hero .ah-badges .badge.sub{background:rgba(44,164,220,.12);color:var(--primary)}
    .article-hero h1{font-size:28px;font-weight:800;line-height:1.35;color:var(--navy);margin-bottom:10px}
    .article-hero .ah-meta-bottom{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--text-muted)}

    /* ── Article Content ── */
    .article-content h2{font-size:22px;font-weight:700;color:var(--navy);margin:32px 0 12px;border-bottom:2px solid var(--primary);padding-bottom:6px;scroll-margin-top:80px}
    .article-content h3{font-size:17px;font-weight:600;color:var(--navy);margin:22px 0 8px;scroll-margin-top:80px}
    .article-content p{margin-bottom:14px;font-size:15px;color:#333}
    .article-content ul,.article-content ol{margin:0 0 14px 24px;font-size:15px;color:#333}
    .article-content li{margin-bottom:4px}
    .article-content table{width:100%;border-collapse:collapse;margin:14px 0;background:#fff;font-size:13px;border-radius:6px;overflow:hidden}
    .article-content table th{background:var(--navy);color:#fff;padding:8px 12px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.3px}
    .article-content table td{padding:8px 12px;border:1px solid var(--border)}
    .article-content table tr:nth-child(even) td{background:#F0F6FC}
    .article-content strong{color:var(--navy)}
    .article-content a{color:var(--primary);text-decoration:underline;text-underline-offset:2px}
    .article-content blockquote{border-left:3px solid var(--primary);padding:10px 16px;margin:14px 0;background:#F0F6FC;border-radius:0 6px 6px 0;font-style:italic;color:var(--text-light)}
    .article-content code{background:#e8f0f7;padding:2px 6px;border-radius:4px;font-size:13px;color:var(--navy)}
    .article-content pre{background:var(--navy);color:#e8e8e8;padding:14px 18px;border-radius:6px;overflow-x:auto;font-size:13px;margin:14px 0}

    /* ── Tags ── */
    .article-tags{display:flex;gap:6px;flex-wrap:wrap;margin:20px 0 0;padding-top:16px;border-top:1px solid var(--border)}
    .article-tags .tag{padding:4px 12px;background:#e3f0f7;color:var(--primary);border-radius:4px;font-size:12px;font-weight:600;transition:all .15s}
    .article-tags .tag:hover{background:var(--primary);color:#fff}

    /* ── Author Box ── */
    .author-box{display:flex;align-items:center;gap:14px;margin:24px 0;padding:16px 20px;background:#F0F6FC;border-radius:var(--radius);border:1px solid var(--border)}
    .author-box .av{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--primary));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:18px;flex-shrink:0}
    .author-box .info{font-size:13px;color:var(--text-light)}
    .author-box .info strong{color:var(--navy);font-size:14px}

    /* ── Share Buttons ── */
    .share-buttons{display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap}
    .share-buttons .share-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border:none;border-radius:6px;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s;color:#fff}
    .share-buttons .share-btn.twitter{background:#1DA1F2}
    .share-buttons .share-btn.twitter:hover{background:#1a91da}
    .share-buttons .share-btn.facebook{background:#4267B2}
    .share-buttons .share-btn.facebook:hover{background:#365899}
    .share-buttons .share-btn.copy{background:var(--text-light)}
    .share-buttons .share-btn.copy:hover{background:var(--text)}
    .share-buttons .share-btn.copied{background:#27ae60}

    /* ── ToC ── */
    .toc-wrap{position:sticky;top:80px;width:240px;flex-shrink:0;max-height:calc(100vh - 100px);overflow-y:auto;padding:0 0 0 8px}
    .toc-wrap::-webkit-scrollbar{width:4px}
    .toc-wrap::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
    .toc-wrap h3{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:10px}
    .toc-wrap nav ul{list-style:none}
    .toc-wrap nav ul li{margin-bottom:2px}
    .toc-wrap nav ul li a{display:block;padding:4px 10px;font-size:12px;color:var(--text-light);border-radius:4px;border-left:2px solid transparent;transition:all .12s}
    .toc-wrap nav ul li a:hover{color:var(--primary);background:rgba(44,164,220,.06);border-left-color:var(--primary)}
    .toc-wrap nav ul li.h3 a{padding-left:20px}
    .toc-wrap nav ul li.active a{color:var(--primary);border-left-color:var(--primary);font-weight:600}
    @media(max-width:1024px){.toc-wrap{display:none}}

    /* ── Related Posts ── */
    .related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:20px 0 28px}
    @media(max-width:700px){.related-grid{grid-template-columns:1fr}}
    .related-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:14px;transition:all .15s}
    .related-card:hover{border-color:var(--primary);box-shadow:0 2px 12px rgba(44,164,220,.1)}
    .related-card .rc-date{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.3px;margin-bottom:4px}
    .related-card h4{font-size:13px;line-height:1.4;margin-bottom:4px}
    .related-card h4 a{color:var(--navy)}
    .related-card h4 a:hover{color:var(--primary)}
    .related-card .rc-excerpt{font-size:12px;color:var(--text-light);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .related-card .rc-read{font-size:10px;color:var(--text-muted);margin-top:6px}
    .related-heading{font-size:18px;font-weight:700;color:var(--navy);margin-bottom:12px;display:flex;align-items:center;gap:8px}

    /* ── Prev/Next ── */
    .pn-wrap{display:flex;gap:14px;margin-bottom:28px}
    .pn-wrap .pn-card{flex:1;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;transition:all .15s}
    .pn-wrap .pn-card:hover{border-color:var(--primary)}
    .pn-wrap .pn-card.next{text-align:right}
    .pn-wrap .pn-card .pn-label{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px}
    .pn-wrap .pn-card .pn-title{font-size:13px;font-weight:600;color:var(--navy);margin-top:2px}
    .pn-wrap .pn-card:hover .pn-title{color:var(--primary)}
    .pn-wrap .pn-card.disabled{opacity:.4;pointer-events:none}

    /* ── Sidebar ── */
    .article-sidebar{width:260px;flex-shrink:0}
    @media(max-width:1024px){.article-sidebar{width:100%}}
    .sb-widget{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:16px}
    .sb-widget h3{font-size:13px;text-transform:uppercase;letter-spacing:1px;color:var(--text-muted);margin-bottom:10px}
    .sb-widget .sb-search input{width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;outline:none;transition:border .15s}
    .sb-widget .sb-search input:focus{border-color:var(--primary)}
    .sb-widget .sb-cats{list-style:none}
    .sb-widget .sb-cats li a{display:flex;align-items:center;gap:8px;padding:6px 8px;font-size:13px;color:var(--text);border-radius:4px;transition:all .1s}
    .sb-widget .sb-cats li a:hover{background:#e8f0f7;color:var(--primary)}
    .sb-widget .sb-cats li a .count{font-size:11px;color:var(--text-muted);margin-left:auto}
    .sb-widget .sb-recent{list-style:none}
    .sb-widget .sb-recent li{padding:6px 0;border-bottom:1px solid var(--border);font-size:13px}
    .sb-widget .sb-recent li:last-child{border-bottom:none}
    .sb-widget .sb-recent li a{color:var(--text)}
    .sb-widget .sb-recent li a:hover{color:var(--primary)}
    .sb-widget .sb-recent li .r-date{font-size:10px;color:var(--text-muted);display:block}

    /* ── Footer ── */
    footer{background:var(--navy);color:#8899aa;margin-top:40px;font-size:13px}
    .footer-inner{max-width:1280px;margin:0 auto;padding:36px 24px 24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
    footer a{color:var(--primary)}
    footer a:hover{color:#60c0e8}
    @media(max-width:600px){.footer-inner{flex-direction:column;text-align:center;gap:8px}}
  </style>
</head>
<body>

  <!-- ═══ Top Navigation ═══ -->
  <nav class="top-nav">
    <div class="nav-inner">
      <a href="/" class="brand">🌍 <span>Airport</span>DB</a>
      {navItems.map(item => (
        <a href={item.href} class:list={{active: item.href === activeNav}}>{item.label}</a>
      ))}
      <div class="spacer"></div>
    </div>
  </nav>

  <!-- ═══ Breadcrumbs ═══ -->
  <div class="breadcrumbs">
    <a href="/">Home</a>
    <span class="sep">›</span>
    <a href="/blog/">Blog</a>
    <span class="sep">›</span>
    {category && <><a href={`/blog/?category=${category.slug}`}>{category.name}</a><span class="sep">›</span></>}
    <span style="color:var(--text)">{post.title}</span>
  </div>

  <!-- ═══ Page Layout ═══ -->
  <div class="page-wrap" style="padding-top:20px">

    <!-- ═══ Main Article ═══ -->
    <div class="article-wrap">
      <article>

        <!-- Hero Block -->
        <header class="article-hero">
          <div class="ah-badges">
            {category && <span class="badge cat">{category.icon} {category.name}</span>}
            {subcategory && <span class="badge sub">{subcategory.name}</span>}
          </div>
          <h1>{post.title}</h1>
          <div class="ah-meta">
            <span>📅 {dateFormatted}</span>
          </div>
          <div class="ah-meta-bottom">
            <span>📖 {readTime} Min. Lesezeit</span>
          </div>
        </header>

        <!-- Article Content -->
        <div class="article-content">
          <div set:html={processedContent} />
        </div>

        <!-- Tags -->
        <div class="article-tags">
          {post.tags.map(tag => (
            <a href={`/blog/?tag=${tag}`} class="tag">{tag}</a>
          ))}
        </div>

      </article>

      <!-- Author Box -->
      <div class="author-box">
        <div class="av">🌐</div>
        <div class="info">
          <strong>World Airport Database</strong><br>
          Deine Quelle für Flughafendaten, IATA/ICAO-Codes und Aviation-Wissen seit 2008.
        </div>
      </div>

      <!-- Share Buttons -->
      <div class="share-buttons">
        <button class="share-btn twitter" onclick="shareTwitter()">🐦 Twitter</button>
        <button class="share-btn facebook" onclick="shareFacebook()">📘 Facebook</button>
        <button class="share-btn copy" id="copyLinkBtn" onclick="copyLink()">🔗 Link kopieren</button>
      </div>

      <!-- Related Posts -->
      {related.length > 0 && (
        <>
          <h3 class="related-heading">📎 Verwandte Beiträge</h3>
          <div class="related-grid">
            {related.map(rp => (
              <div class="related-card">
                <div class="rc-date">{new Date(rp.date).toLocaleDateString('de-DE', {year:'numeric',month:'short',day:'numeric'})}</div>
                <h4><a href={`/blog/${rp.slug}/`}>{rp.title}</a></h4>
                <div class="rc-excerpt">{rp.excerpt}</div>
                <div class="rc-read">📖 {readingTime(rp.content_html)} min</div>
              </div>
            ))}
          </div>
        </>
      )}

      <!-- Prev/Next -->
      <div class="pn-wrap">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}/`} class="pn-card">
            <div class="pn-label">← Vorheriger Beitrag</div>
            <div class="pn-title">{prevPost.title}</div>
          </a>
        ) : (
          <div class="pn-card disabled">
            <div class="pn-label">← Vorheriger Beitrag</div>
            <div class="pn-title">—</div>
          </div>
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}/`} class="pn-card next">
            <div class="pn-label">Nächster Beitrag →</div>
            <div class="pn-title">{nextPost.title}</div>
          </a>
        ) : (
          <div class="pn-card disabled next">
            <div class="pn-label">Nächster Beitrag →</div>
            <div class="pn-title">—</div>
          </div>
        )}
      </div>

    </div>

    <!-- ═══ Right Sidebar ═══ (shown on desktop) -->
    <aside class="article-sidebar">

      <!-- ToC -->
      {tocItems.length > 0 && (
        <div class="toc-wrap">
          <h3>📑 Inhaltsverzeichnis</h3>
          <nav>
            <ul>
              {tocItems.map(item => (
                <li class:list={{h3: item.level === 3}}>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}

      <!-- Search -->
      <div class="sb-widget">
        <h3>🔍 Suche</h3>
        <div class="sb-search">
          <input type="text" id="sbSearchInput" placeholder="Beiträge durchsuchen…" onkeydown="if(event.key==='Enter') window.location.href='/blog/?q='+encodeURIComponent(this.value)">
        </div>
      </div>

      <!-- Categories -->
      <div class="sb-widget">
        <h3>📂 Kategorien</h3>
        <ul class="sb-cats">
          {catsWithCounts.map(c => (
            <li><a href={`/blog/?category=${c.slug}`}>{c.icon} {c.name} <span class="count">({c.count})</span></a></li>
          ))}
        </ul>
      </div>

      <!-- Recent Posts -->
      <div class="sb-widget">
        <h3>📰 Neueste Beiträge</h3>
        <ul class="sb-recent">
          {recentPosts.map(rp => (
            <li>
              <a href={`/blog/${rp.slug}/`}>{rp.title}</a>
              <span class="r-date">{new Date(rp.date).toLocaleDateString('de-DE', {year:'numeric',month:'short',day:'numeric'})}</span>
            </li>
          ))}
        </ul>
      </div>

    </aside>

    <!-- ═══ Mobile: move ToC inside sidebar ═══ -->
    {tocItems.length > 0 && (
      <div style="display:none" class="toc-mobile-placeholder"></div>
    )}

  </div>

  <!-- ═══ Footer ═══ -->
  <footer>
    <div class="footer-inner">
      <div><strong>World Airport Database</strong> seit 2008 — basierend auf <a href="https://ourairports.com/" target="_blank">OurAirports</a></div>
      <div style="display:flex;gap:16px;align-items:center">
        <span>Nicht verbunden mit IATA oder ICAO.</span>
        <a href="/impressum/">Impressum</a>
      </div>
    </div>
  </footer>

  <!-- ═══ JS ═══ -->
  <script is:inline>
    // ── Share Twitter ──
    function shareTwitter() {
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(document.title);
      window.open('https://twitter.com/intent/tweet?text=' + text + '&url=' + url, '_blank', 'width=600,height=400');
    }

    // ── Share Facebook ──
    function shareFacebook() {
      const url = encodeURIComponent(window.location.href);
      window.open('https://www.facebook.com/sharer/sharer.php?u=' + url, '_blank', 'width=600,height=400');
    }

    // ── Copy Link ──
    function copyLink() {
      const btn = document.getElementById('copyLinkBtn');
      navigator.clipboard.writeText(window.location.href).then(() => {
        btn.textContent = '✅ Link kopiert!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = '🔗 Link kopieren';
          btn.classList.remove('copied');
        }, 2500);
      }).catch(() => {
        // Fallback
        const input = document.createElement('input');
        input.value = window.location.href;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        btn.textContent = '✅ Link kopiert!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = '🔗 Link kopieren';
          btn.classList.remove('copied');
        }, 2500);
      });
    }

    // ── ToC Active Highlight on Scroll ──
    document.addEventListener('DOMContentLoaded', function() {
      const headings = document.querySelectorAll('.article-content h2, .article-content h3');
      const tocLinks = document.querySelectorAll('.toc-wrap nav ul li');
      if (headings.length === 0 || tocLinks.length === 0) return;

      function updateActiveToc() {
        let current = '';
        headings.forEach(h => {
          const rect = h.getBoundingClientRect();
          if (rect.top <= 120) {
            current = h.id;
          }
        });
        tocLinks.forEach(li => {
          const link = li.querySelector('a');
          if (link) {
            const href = link.getAttribute('href').replace('#', '');
            li.classList.toggle('active', href === current);
          }
        });
      }

      window.addEventListener('scroll', updateActiveToc, { passive: true });
      updateActiveToc();
    });
  </script>

</body>
</html>
