---
import blogPosts from '../../../data/blog-posts.js';
import { blogCategories, getCategoryBySlug } from '../../../data/blog-categories.js';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';

export async function getStaticPaths() {
  return blogCategories.map(cat => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug);
if (!category) return Astro.redirect('/blog/');

const posts = blogPosts
  .filter(p => p.category === slug)
  .sort((a, b) => new Date(b.date) - new Date(a.date));

const subMap = {};
for (const sub of category.subcategories) {
  subMap[sub.slug] = { ...sub, posts: posts.filter(p => p.subcategory === sub.slug) };
}

function readingTime(html) {
  const text = (html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = text.split(' ').length;
  return Math.max(1, Math.ceil(words / 200));
}

const totalWords = posts.reduce((s, p) => s + (p.content_html || '').replace(/<[^>]+>/g, ' ').split(/\s+/).length, 0);
const pageTitle = `${category.name} — ${posts.length} Articles | World Airport Database Blog`;
const pageDesc = `${category.description} Browse ${posts.length} in-depth articles across ${category.subcategories.length} subcategories.`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={`https://world-airport-database.com/blog/category/${slug}/`}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={`https://world-airport-database.com/blog/category/${slug}/`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.7;font-size:15px}
    :root{--primary:#2ca4dc;--navy:#0B1D3A;--border:#D4E0E8;--card-bg:#fff;--text:#202c39;--text-light:#5A6B7F;--text-muted:#8899aa}
    a{color:var(--primary);text-decoration:none;transition:color .15s}
    a:hover{color:#1e85b8}
    .wrap{max-width:1280px;margin:0 auto;padding:0 20px}

    .breadcrumb{padding:14px 0;background:#fff;border-bottom:1px solid var(--border);font-size:13px;color:var(--text-muted)}
    .breadcrumb a{color:var(--text-muted)}
    .breadcrumb a:hover{color:var(--primary)}
    .breadcrumb .sep{margin:0 6px;opacity:.5}
    .breadcrumb .current{color:var(--navy);font-weight:600}

    .hero{background:linear-gradient(135deg,#0B1D3A 0%,#1a3a5f 100%);color:#fff;padding:48px 0 40px;position:relative;overflow:hidden}
    .hero::before{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(44,164,220,.15) 0%,transparent 70%)}
    .hero h1{font-size:38px;font-weight:800;letter-spacing:-.8px;margin-bottom:10px;position:relative;z-index:1;display:flex;align-items:center;gap:14px}
    .hero h1 .icon{font-size:42px}
    .hero h1 span{color:#60a5fa}
    .hero .desc{color:rgba(255,255,255,.75);font-size:15px;max-width:680px;margin-bottom:18px;position:relative;z-index:1}
    .hero-stats{display:flex;gap:24px;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,.6);position:relative;z-index:1}
    .hero-stats strong{color:#60a5fa;font-weight:700}

    .content{padding:40px 0}
    .layout{display:grid;grid-template-columns:280px 1fr;gap:32px}
    @media(max-width:900px){.layout{grid-template-columns:1fr;gap:16px}}

    /* Subcategory nav (sticky) */
    .sub-nav{position:sticky;top:80px;align-self:start;background:#fff;border:1px solid var(--border);border-radius:10px;padding:16px;max-height:calc(100vh - 100px);overflow-y:auto}
    .sub-nav h2{font-size:11px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-muted);margin-bottom:12px;font-weight:700}
    .sub-nav ul{list-style:none;padding:0;margin:0}
    .sub-nav li a{display:flex;align-items:center;gap:6px;padding:7px 10px;font-size:13.5px;color:var(--text);border-radius:6px;transition:background .15s}
    .sub-nav li a:hover{background:#f0f6fc;color:var(--primary);text-decoration:none}
    .sub-nav li a .ct{font-size:10.5px;color:var(--text-muted);background:#f0f6fc;padding:1px 6px;border-radius:10px;margin-left:auto}

    /* Main */
    .subcat-section{background:#fff;border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:24px}
    .subcat-section h2{font-size:20px;color:var(--navy);font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px}
    .subcat-section h2 .ct{font-size:11px;color:var(--text-muted);background:#f0f6fc;padding:2px 8px;border-radius:10px;font-weight:500}
    .subcat-section .sub-desc{color:var(--text-light);font-size:14px;margin-bottom:16px;max-width:600px}
    .post-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
    .post-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:16px;transition:all .15s;display:block;text-decoration:none;color:inherit}
    .post-card:hover{border-color:var(--primary);text-decoration:none;box-shadow:0 4px 12px rgba(44,164,220,.08);transform:translateY(-1px)}
    .post-card .meta{display:flex;gap:8px;font-size:11px;color:var(--text-muted);margin-bottom:6px;flex-wrap:wrap;align-items:center}
    .post-card h3{font-size:15px;color:var(--navy);font-weight:700;line-height:1.35;margin-bottom:6px}
    .post-card .excerpt{font-size:13px;color:var(--text-light);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:8px}
    .post-card .tags{display:flex;gap:4px;flex-wrap:wrap}
    .post-card .tag{font-size:10px;color:var(--primary);background:rgba(44,164,220,.08);padding:1px 6px;border-radius:3px;font-weight:600}

    .related-cats{margin-top:32px;padding-top:24px;border-top:1px solid var(--border)}
    .related-cats h3{font-size:14px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;font-weight:700}
    .related-cats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
    .related-cats a{display:flex;align-items:center;gap:8px;padding:10px 14px;background:#fff;border:1px solid var(--border);border-radius:8px;color:var(--navy);text-decoration:none;font-size:13.5px;font-weight:600;transition:all .15s}
    .related-cats a:hover{border-color:var(--primary);text-decoration:none}
    .related-cats a .ic{font-size:18px}
    .related-cats a .ct{font-size:10.5px;color:var(--text-muted);background:#f0f6fc;padding:1px 6px;border-radius:10px;margin-left:auto;font-weight:500}

    @media(max-width:640px){
      .hero h1{font-size:26px}
      .hero{padding:32px 0 24px}
    }
  </style>
</head>
<body>

<SiteNav active="blog" />

<!-- Breadcrumb -->
<div class="breadcrumb">
  <div class="wrap">
    <a href="/">Home</a>
    <span class="sep">›</span>
    <a href="/blog/">Blog</a>
    <span class="sep">›</span>
    <span class="current">{category.name}</span>
  </div>
</div>

<!-- Hero -->
<section class="hero">
  <div class="wrap">
    <h1><span class="icon">{category.icon}</span> {category.name}</h1>
    <p class="desc">{category.description}</p>
    <div class="hero-stats">
      <span><strong>{posts.length}</strong> articles</span>
      <span><strong>{category.subcategories.length}</strong> subcategories</span>
      <span><strong>{Math.round(totalWords/1000)}K</strong> words</span>
      <span>Updated regularly</span>
    </div>
  </div>
</section>

<div class="wrap">
<div class="content">
<div class="layout">

  <!-- Subcategory nav -->
  <aside class="sub-nav">
    <h2>📂 Subcategories</h2>
    <ul>
      {category.subcategories.filter(s => subMap[s.slug]?.posts.length > 0).map(sub => (
        <li>
          <a href={`#${sub.slug}`}>
            <span>{sub.name}</span>
            <span class="ct">{subMap[sub.slug].posts.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>

  <!-- Posts -->
  <main>
    {category.subcategories.filter(s => subMap[s.slug]?.posts.length > 0).map(sub => {
      const subPosts = subMap[sub.slug].posts;
      return (
        <section class="subcat-section" id={sub.slug}>
          <h2>{sub.name} <span class="ct">{subPosts.length} article{subPosts.length !== 1 ? 's' : ''}</span></h2>
          <div class="sub-desc">{sub.desc}</div>
          <div class="post-grid">
            {subPosts.map(post => {
              const rt = readingTime(post.content_html);
              return (
                <a href={`/blog/${post.slug}/`} class="post-card">
                  <div class="meta">
                    <span>{new Date(post.date).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'})}</span>
                    <span>📖 {rt} min</span>
                  </div>
                  <h3>{post.title}</h3>
                  <div class="excerpt">{post.excerpt}</div>
                  <div class="tags">
                    {(post.tags || []).slice(0, 3).map(t => <span class="tag">{t}</span>)}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
  </main>

</div>

<!-- Related categories -->
<div class="related-cats">
  <h3>Explore other categories</h3>
  <div class="related-cats-grid">
    {blogCategories.filter(c => c.slug !== slug).slice(0, 8).map(c => (
      <a href={`/blog/category/${c.slug}/`}>
        <span class="ic">{c.icon}</span>
        <span>{c.name}</span>
        <span class="ct">{blogPosts.filter(p => p.category === c.slug).length}</span>
      </a>
    ))}
  </div>
</div>

</div>
</div>

<SiteFooter />
</body>
</html>
