---
import blogPosts from '../../data/blog-posts.js';
import { blogCategories, getCategoryBySlug, getSubcategoryBySlug } from '../../data/blog-categories.js';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

// Helper: reading time from HTML content
function readingTime(html) {
  const text = (html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  const words = text.split(' ').length;
  return Math.max(1, Math.ceil(words / 200));
}

const allPosts = [...blogPosts].sort((a, b) => new Date(b.date) - new Date(a.date));

// Category counts
const categoryCounts = {};
for (const cat of blogCategories) {
  categoryCounts[cat.slug] = allPosts.filter(p => p.category === cat.slug).length;
}

// Featured posts: 3 newest
const featuredPosts = allPosts.slice(0, 3);

// Categories with posts
const categoriesWithPosts = blogCategories.filter(c => categoryCounts[c.slug] > 0);

const pageTitle = `Blog — ${allPosts.length} Articles on Airports, IATA Codes & Travel Tips | World Airport Database`;
const pageDesc = `In-depth guides, code lookups, travel tips, and aviation news. ${allPosts.length} articles across ${categoriesWithPosts.length} categories.`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href="https://world-airport-database.com/blog/">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content="https://world-airport-database.com/blog/">
  <meta property="og:image" content="https://world-airport-database.com/logo-icon.svg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.7;font-size:15px}
    :root{--primary:#2ca4dc;--navy:#0B1D3A;--border:#D4E0E8;--card-bg:#fff;--text:#202c39;--text-light:#5A6B7F;--text-muted:#8899aa;--radius:10px;--shadow:0 1px 4px rgba(11,29,58,.06)}
    a{color:var(--primary);text-decoration:none;transition:color .15s}
    a:hover{color:#1e85b8}

    .wrap{max-width:1280px;margin:0 auto;padding:0 20px}

    /* Layout */
    .layout{display:grid;grid-template-columns:280px 1fr;gap:32px;padding:32px 0}
    @media(max-width:900px){.layout{grid-template-columns:1fr;gap:16px}}

    /* Sidebar */
    .sidebar{position:sticky;top:80px;align-self:start;max-height:calc(100vh - 100px);overflow-y:auto;background:#fff;border:1px solid var(--border);border-radius:12px;padding:16px}
    .sidebar h2{font-size:11px;text-transform:uppercase;letter-spacing:1.2px;color:var(--text-muted);margin-bottom:14px;font-weight:700;padding:0 4px}
    .cat-list{list-style:none;padding:0;margin:0}
    .cat-item{margin-bottom:4px}
    .cat-header{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:7px;cursor:pointer;transition:background .15s;user-select:none}
    .cat-header:hover{background:#f0f6fc}
    .cat-header .icon{font-size:18px;width:22px;text-align:center;flex-shrink:0}
    .cat-header .name{flex:1;font-size:13.5px;font-weight:600;color:var(--navy)}
    .cat-header .count{font-size:11px;color:var(--text-muted);background:#f0f6fc;padding:1px 6px;border-radius:10px;flex-shrink:0}
    .cat-header .arrow{font-size:10px;color:var(--text-muted);transition:transform .2s;flex-shrink:0}
    .cat-header.open .arrow{transform:rotate(90deg)}
    .subcat-list{list-style:none;padding:0 0 0 32px;margin:0;max-height:0;overflow:hidden;transition:max-height .3s}
    .subcat-list.open{max-height:500px}
    .subcat-list li a{display:block;padding:6px 10px;font-size:12.5px;color:var(--text-light);border-radius:5px}
    .subcat-list li a:hover{background:#f0f6fc;color:var(--primary)}

    /* Hero */
    .hero{background:linear-gradient(135deg,#0B1D3A 0%,#1a3a5f 100%);color:#fff;padding:48px 0 40px;position:relative;overflow:hidden}
    .hero::before{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(44,164,220,.15) 0%,transparent 70%)}
    .hero h1{font-size:36px;font-weight:800;letter-spacing:-.8px;margin-bottom:10px;position:relative;z-index:1}
    .hero h1 span{color:#60a5fa}
    .hero .subtitle{color:rgba(255,255,255,.7);font-size:15px;margin-bottom:18px;position:relative;z-index:1}
    .hero-stats{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;color:rgba(255,255,255,.6);position:relative;z-index:1}
    .hero-stats strong{color:#60a5fa;font-weight:700}

    .search-wrap{position:relative;max-width:480px;margin-top:8px}
    .search-wrap input{width:100%;padding:11px 14px 11px 42px;border:1px solid rgba(255,255,255,.15);border-radius:8px;font-size:14px;background:rgba(255,255,255,.1);color:#fff;outline:none;font-family:inherit;transition:background .2s}
    .search-wrap input::placeholder{color:rgba(255,255,255,.5)}
    .search-wrap input:focus{background:rgba(255,255,255,.18);border-color:var(--primary)}
    .search-wrap .search-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,.5);font-size:16px;pointer-events:none}

    /* Main */
    .main{min-width:0}
    .section-block{margin-bottom:32px}
    .section-block h2{font-size:20px;font-weight:800;color:var(--navy);margin-bottom:14px;display:flex;align-items:center;gap:10px}
    .section-block h2 .meta{font-size:12px;color:var(--text-muted);font-weight:500;margin-left:8px}

    /* Featured */
    .featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    @media(max-width:900px){.featured-grid{grid-template-columns:1fr}}
    .featured-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:20px;transition:all .2s;position:relative;overflow:hidden;display:block;text-decoration:none;color:inherit}
    .featured-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),#60c0e8)}
    .featured-card:hover{box-shadow:0 4px 20px rgba(44,164,220,.15);border-color:var(--primary);transform:translateY(-2px);text-decoration:none}
    .featured-card .fc-badge{display:inline-block;background:rgba(44,164,220,.1);color:var(--primary);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:2px 8px;border-radius:4px;margin-bottom:8px}
    .featured-card .fc-date{font-size:11px;color:var(--text-muted);margin-bottom:4px}
    .featured-card h3{font-size:16px;line-height:1.4;margin-bottom:6px;color:var(--navy);font-weight:700}
    .featured-card .fc-excerpt{font-size:13px;color:var(--text-light);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .featured-card .fc-meta{display:flex;gap:8px;margin-top:10px;font-size:11px;color:var(--text-muted);align-items:center;flex-wrap:wrap}
    .sub-badge{background:rgba(44,164,220,.08);color:var(--primary);padding:2px 8px;border-radius:4px;font-weight:600;font-size:10.5px}

    /* Category sections */
    .cat-section{background:#fff;border:1px solid var(--border);border-radius:10px;padding:20px 24px;margin-bottom:20px}
    .cat-section.hidden{display:none}
    .cat-section h3{font-size:16px;color:var(--navy);font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px}
    .cat-section h3 .cat-count{font-size:11px;color:var(--text-muted);background:#f0f6fc;padding:2px 8px;border-radius:10px;font-weight:500}
    .post-list{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
    .post-item{padding:12px 0;border-top:1px solid var(--border)}
    .post-item:first-child{border-top:0}
    .post-item .pi-top{display:flex;gap:8px;font-size:11px;color:var(--text-muted);margin-bottom:4px;align-items:center;flex-wrap:wrap}
    .post-item h4{font-size:14px;font-weight:600;line-height:1.4;margin-bottom:4px}
    .post-item h4 a{color:var(--navy)}
    .post-item h4 a:hover{color:var(--primary)}
    .post-item .pi-excerpt{font-size:12.5px;color:var(--text-light);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

    /* No results */
    .no-results{background:#fff;border:1px solid var(--border);border-radius:10px;padding:48px 20px;text-align:center;display:none}
    .no-results.show{display:block}
    .no-results .emoji{font-size:48px;margin-bottom:8px}
    .no-results h3{font-size:18px;color:var(--navy);margin-bottom:4px}
    .no-results p{color:var(--text-muted);font-size:14px}

    /* Pagination */
    .pagination{display:flex;align-items:center;justify-content:center;gap:12px;padding:16px 0}
    .pagination button{padding:8px 18px;border:1px solid var(--border);background:#fff;border-radius:6px;font-size:13px;font-weight:500;color:var(--text);cursor:pointer;transition:all .15s;font-family:inherit}
    .pagination button:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
    .pagination button:disabled{opacity:.4;cursor:not-allowed}
    .pagination .page-info{font-size:13px;color:var(--text-muted);min-width:140px;text-align:center}

    @media(max-width:640px){
      .hero h1{font-size:26px}
      .hero{padding:32px 0 24px}
    }
  </style>
</head>
<body>

<SiteNav active="blog" />

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <h1>📖 Aviation <span>Blog</span></h1>
    <p class="subtitle">Airport guides, IATA/ICAO code insights, travel tips, and aviation news.</p>
    <div class="hero-stats">
      <span><strong>{allPosts.length}</strong> articles</span>
      <span><strong>{categoriesWithPosts.length}</strong> categories</span>
      <span><strong>{categoriesWithPosts.reduce((s,c) => s + c.subcategories.length, 0)}</strong> subcategories</span>
      <span>Updated daily</span>
    </div>
    <div class="search-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" placeholder="Search articles..." oninput="filterPosts()">
    </div>
  </div>
</section>

<div class="wrap">
<div class="layout">

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar">
    <h2>📂 Categories</h2>
    <ul class="cat-list">
      {categoriesWithPosts.map(cat => {
        const catCount = categoryCounts[cat.slug];
        return (
          <li class="cat-item">
            <div class="cat-header" data-cat={cat.slug} onclick="toggleCat(this)">
              <span class="icon">{cat.icon}</span>
              <span class="name">{cat.name}</span>
              <span class="count">{catCount}</span>
              <span class="arrow">▶</span>
            </div>
            <ul class="subcat-list">
              {cat.subcategories.map(sub => {
                const subCount = allPosts.filter(p => p.category === cat.slug && p.subcategory === sub.slug).length;
                if (subCount === 0) return null;
                return <li><a href={`/blog/category/${cat.slug}/#${sub.slug}`}>{sub.name} ({subCount})</a></li>;
              })}
            </ul>
          </li>
        );
      })}
    </ul>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <main class="main">

    <!-- Featured -->
    <div class="section-block">
      <h2>⭐ Featured</h2>
      <div class="featured-grid">
        {featuredPosts.map(post => {
          const cat = getCategoryBySlug(post.category);
          const sub = cat ? getSubcategoryBySlug(post.category, post.subcategory) : null;
          const rt = readingTime(post.content_html);
          return (
            <a href={`/blog/${post.slug}/`} class="featured-card">
              <div class="fc-badge">⭐ Featured</div>
              <div class="fc-date">{new Date(post.date).toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})}</div>
              <h3>{post.title}</h3>
              <div class="fc-excerpt">{post.excerpt}</div>
              <div class="fc-meta">
                {sub && <span class="sub-badge">{sub.name}</span>}
                <span>📖 {rt} min read</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- All posts by category -->
    <div id="postsContainer">
      {categoriesWithPosts.map(cat => {
        const catPosts = allPosts.filter(p => p.category === cat.slug);
        return (
          <section class="cat-section" data-category={cat.slug} id={`cat-${cat.slug}`}>
            <h3>
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
              <span class="cat-count">{catPosts.length} articles</span>
            </h3>
            <ul class="post-list">
              {catPosts.map(post => {
                const sub = getSubcategoryBySlug(post.category, post.subcategory);
                const rt = readingTime(post.content_html);
                return (
                  <li class="post-item">
                    <div class="pi-top">
                      <span>{new Date(post.date).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'})}</span>
                      {sub && <span class="sub-badge">{sub.name}</span>}
                      <span>📖 {rt} min</span>
                    </div>
                    <h4><a href={`/blog/${post.slug}/`}>{post.title}</a></h4>
                    <div class="pi-excerpt">{post.excerpt}</div>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </div>

    <!-- No Results -->
    <div class="no-results" id="noResults">
      <div class="emoji">🔍</div>
      <h3>No articles found</h3>
      <p>Try a different search term or browse the categories in the sidebar.</p>
    </div>
  </main>
</div>
</div>

<SiteFooter />

<script is:inline>
  // ── Search filter ──
  function filterPosts() {
    const q = document.getElementById('searchInput').value.toLowerCase().trim();
    const sections = document.querySelectorAll('.cat-section');
    let visible = 0;
    sections.forEach(sec => {
      let secVisible = 0;
      sec.querySelectorAll('.post-item').forEach(item => {
        const text = (item.textContent || '').toLowerCase();
        const match = !q || text.includes(q);
        item.style.display = match ? '' : 'none';
        if (match) secVisible++;
      });
      sec.classList.toggle('hidden', secVisible === 0);
      visible += secVisible;
    });
    document.getElementById('noResults').classList.toggle('show', visible === 0);
  }

  // ── Sidebar category toggle ──
  function toggleCat(el) {
    el.classList.toggle('open');
    const sub = el.nextElementSibling;
    if (sub) sub.classList.toggle('open');
  }

  // Auto-open if hash present
  window.addEventListener('DOMContentLoaded', () => {
    if (location.hash) {
      const el = document.querySelector(`[data-cat]`);
      if (el) {
        // Find the matching category header
        document.querySelectorAll('.cat-header').forEach(h => {
          if (location.hash.startsWith('#') && h.parentElement.querySelector(`[href*="${h.dataset.cat}"]`)) {
            h.classList.add('open');
            h.nextElementSibling.classList.add('open');
          }
        });
      }
    }
  });
</script>
</body>
</html>
