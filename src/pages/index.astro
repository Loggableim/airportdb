<section class="section section-alt">
  <div class="wrap">
    <h2 class="section-title">Browse by <span class="accent">Topic</span></h2>
    <p class="section-desc">12 categories and 100+ subcategories covering every aspect of airports and aviation.</p>
    <div class="cat-cloud">
      {blogCategories.map(cat => (
        <a href={`/blog/category/${cat.slug}/`} class="cat-cloud-item">
          <span class="cat-icon">{cat.icon}</span>
