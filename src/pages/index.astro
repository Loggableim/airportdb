// ║  FRA MAP + MAP STYLE SWITCH                             ║
// ══════════════════════════════════════════════════════════════
let fraMap = null;
function initFraMap() {
  if (fraMap) return;
  fraMap = L.map('fra-map').setView([50.033, 8.561], 10);
  addTileLayer('light');
  L.marker([50.033, 8.561]).addTo(fraMap)
    .bindPopup('<b>Frankfurt Airport (FRA)</b><br>EDDF')
    .openPopup();
}

function addTileLayer(style) {
  if (!fraMap) return;
  fraMap.eachLayer(l => { if (l._url) fraMap.removeLayer(l); });
  L.tileLayer(style === 'dark'
    ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
    : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
    { attribution: '&copy; CARTO', maxZoom: 19 }
  ).addTo(fraMap);
}

function switchMapStyle(style) {
  document.getElementById('map-light-btn').classList.toggle('active', style === 'light');
  document.getElementById('map-dark-btn').classList.toggle('active', style === 'dark');
  addTileLayer(style);
}

// Init map when section is visible
(function fraMapObserver() {
  const obs = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      initFraMap();
      obs.disconnect();
    }
  }, { threshold: 0.3 });
  obs.observe(document.getElementById('fra-map'));
})();

