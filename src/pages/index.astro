// ║  SCROLL ANIMATIONS                                       ║
// ══════════════════════════════════════════════════════════════
(function scrollAnim() {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.fade-in, .slide-up, .scale-in, .stagger').forEach(el => observer.observe(el));
})();

// ══════════════════════════════════════════════════════════════
// ║  TYPE BREAKDOWN (D3)                                     ║
// ══════════════════════════════════════════════════════════════
const TYPE_DATA = [
  {id:"large_airport",label:"Large",color:"#2C7BE5"},
  {id:"medium_airport",label:"Medium",color:"#F4A261"},
  {id:"small_airport",label:"Small",color:"#E9C46A"},
  {id:"heliport",label:"Heliport",color:"#6CB4EE"},
  {id:"seaplane_base",label:"Seaplane",color:"#2A9D8F"},
  {id:"closed",label:"Closed",color:"#E76F51"},
  {id:"balloonport",label:"Balloonport",color:"#D4E8F7"}
];

function drawTypeChart() {
  const cont = document.getElementById('type-filter-cont').value;
  const size = document.getElementById('type-filter-size').value;
  const wrap = document.getElementById('type-chart');
  const w = wrap.clientWidth - 40;
  const h = 360;
  if (w < 100) { setTimeout(drawTypeChart, 200); return; }

  let data = TYPE_DATA.map(t => {
    let count = 0;
    AIRPORTS.forEach(a => {
      if (cont && a.cont !== cont) return;
      if (a.type === t.id) count++;
    });
    if (size === 'LARGE' && !['large_airport'].includes(t.id)) count = 0;
    else if (size === 'MEDIUM' && !['medium_airport'].includes(t.id)) count = 0;
    else if (size === 'SMALL' && !['small_airport','heliport','seaplane_base','balloonport'].includes(t.id)) count = 0;
    else if (size === 'CLOSED' && t.id !== 'closed') count = 0;
    return { ...t, count };
  }).filter(d => d.count > 0);

  if (data.length === 0) data = [{id:"none",label:"No data",color:"#ccc",count:1}];

  d3.select(wrap).selectAll('svg').remove();

  const svg = d3.select(wrap).append('svg')
    .attr('width', w)
    .attr('height', h);

  const tooltip = document.getElementById('type-tooltip');

  const x = d3.scaleBand()
    .domain(data.map(d => d.label))
    .range([0, w - 60])
    .padding(0.3);

  const y = d3.scaleLinear()
    .domain([0, d3.max(data, d => d.count) * 1.15 || 1])
    .range([h - 60, 20]);

  const g = svg.append('g').attr('transform', `translate(30,10)`);

  // Bars
  g.selectAll('rect')
    .data(data)
    .enter().append('rect')
    .attr('x', d => x(d.label))
    .attr('y', h - 60)
    .attr('width', x.bandwidth())
    .attr('height', 0)
    .attr('fill', d => d.color)
    .attr('rx', 3)
    .style('cursor', 'pointer')
    .on('mouseover', function(ev, d) {
      d3.select(this).attr('opacity', 0.8);
      tooltip.style.opacity = 1;
      tooltip.innerHTML = `<strong>${d.label}</strong><br>Count: ${d.count}`;
    })
    .on('mousemove', function(ev) {
      const r = wrap.getBoundingClientRect();
      tooltip.style.left = (ev.clientX - r.left + 15) + 'px';
      tooltip.style.top = (ev.clientY - r.top - 10) + 'px';
    })
    .on('mouseout', function() {
      d3.select(this).attr('opacity', 1);
      tooltip.style.opacity = 0;
    })
    .transition()
    .duration(500)
    .delay((d,i) => i * 80)
    .attr('y', d => y(d.count))
    .attr('height', d => h - 60 - y(d.count));

  // Labels
  g.selectAll('text.xl')
    .data(data)
    .enter().append('text')
    .attr('x', d => x(d.label) + x.bandwidth() / 2)
    .attr('y', h - 40)
    .attr('text-anchor', 'middle')
    .attr('font-size', 11)
    .attr('fill', '#5A6B7F')
    .text(d => d.label);

  // Count
  g.selectAll('text.yl')
    .data(data)
    .enter().append('text')
    .attr('x', d => x(d.label) + x.bandwidth() / 2)
    .attr('y', d => y(d.count) - 8)
    .attr('text-anchor', 'middle')
    .attr('font-size', 12)
    .attr('font-weight', '700')
    .attr('fill', '#202c39')
    .text(d => d.count);
}

