<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',Arial,Helvetica,sans-serif;background:var(--bg-light);color:var(--text-dark);line-height:1.7;overflow-x:hidden}
:root{--primary:#2ca4dc;--primary-dark:#1a7ab5;--navy:#0B1D3A;--accent:#F4A261;--gold:#E9C46A;--bg-light:#F4F7FA;--bg-white:#FFFFFF;--text-dark:#202c39;--text-light:#5A6B7F;--border:#D4E0E8;--table-stripe:#F0F6FC}
a{color:var(--primary);text-decoration:none}a:hover{text-decoration:underline}img{max-width:100%}
.fade-in{opacity:0;transform:translateY(40px);transition:opacity .8s ease-out,transform .8s ease-out}
.fade-in.visible{opacity:1;transform:translateY(0)}
.slide-up{opacity:0;transform:translateY(60px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
.slide-up.visible{opacity:1;transform:translateY(0)}
.scale-in{opacity:0;transform:scale(.85);transition:opacity .7s ease-out,transform .7s cubic-bezier(.16,1,.3,1)}
.scale-in.visible{opacity:1;transform:scale(1)}
.stagger>*{opacity:0;transform:translateY(30px);transition:opacity .6s ease-out,transform .6s ease-out}
.stagger.visible>*{opacity:1;transform:translateY(0)}
.stagger.visible>*:nth-child(1){transition-delay:.05s}
.stagger.visible>*:nth-child(2){transition-delay:.15s}
.stagger.visible>*:nth-child(3){transition-delay:.25s}
.stagger.visible>*:nth-child(4){transition-delay:.35s}
.stagger.visible>*:nth-child(5){transition-delay:.45s}
.stagger.visible>*:nth-child(6){transition-delay:.55s}
.stagger.visible>*:nth-child(7){transition-delay:.65s}
.stagger.visible>*:nth-child(8){transition-delay:.75s}
table{width:100%;border-collapse:collapse;margin:12px 0 20px;background:var(--bg-white)}
table th{background:var(--navy);color:#fff;padding:10px 14px;text-align:left;font-size:13px;text-transform:uppercase;letter-spacing:.5px;border:1px solid #1a2d4a}
table td{padding:9px 14px;border:1px solid var(--border);font-size:13px;vertical-align:top}
table tr:nth-child(even) td{background:var(--table-stripe)}
table tr:hover td{background:#e3f0f7}
.iata-badge{display:inline-block;background:var(--primary);color:#fff;padding:2px 9px;border-radius:3px;font-size:11px;font-weight:700;letter-spacing:.3px}
.wrap{max-width:1100px;margin:0 auto;padding:0 20px}
.section{padding:60px 0}
.section-title{font-size:26px;font-weight:700;color:var(--text-dark);padding:0 0 12px;border-bottom:3px solid var(--primary);margin-bottom:24px}
.hero{background:linear-gradient(180deg,#060d1a 0%,#0a1628 40%,#0d1f36 100%);padding:0;text-align:center;position:relative;overflow:hidden;border-bottom:4px solid var(--primary);min-height:520px;display:flex;align-items:center;justify-content:center}
.hero::before{content:'';position:absolute;top:0;left:0;right:0;height:6px;background:repeating-linear-gradient(90deg,var(--primary) 0px,var(--primary) 30px,transparent 30px,transparent 60px);z-index:20}
.hero-svg-bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1}
.hero-content{position:relative;z-index:10;padding:40px 20px}
.hero h1{color:#fff;font-size:40px;font-weight:800;letter-spacing:1px;margin-bottom:8px;text-shadow:0 2px 20px rgba(0,0,0,.5)}
.hero .subtitle{color:#a0b8cc;font-size:17px;font-weight:600;margin-bottom:30px;letter-spacing:.5px}
.hero .subtitle span{color:var(--gold)}
.hero-stats{display:flex;justify-content:center;gap:50px;flex-wrap:wrap;margin-top:20px}
.hero-stat{text-align:center}
.hero-stat .num{font-size:34px;font-weight:800;color:var(--gold);text-shadow:0 0 20px rgba(233,196,106,.3)}
.hero-stat .lbl{font-size:12px;color:#8899aa;text-transform:uppercase;letter-spacing:1px;margin-top:2px}
.scroll-indicator{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);color:#667;font-size:12px;letter-spacing:1px;text-transform:uppercase;animation:bounceDown 2s ease-in-out infinite;z-index:10}
.scroll-indicator::after{content:'\\2193';display:block;text-align:center;font-size:18px;margin-top:2px}
@keyframes bounceDown{0%,100%{opacity:.4;transform:translateX(-50%) translateY(0)}50%{opacity:1;transform:translateX(-50%) translateY(6px)}}
@keyframes beaconPulse{0%,100%{opacity:1}50%{opacity:.3}}
@keyframes lightTwinkle{0%,100%{opacity:.8}50%{opacity:.4}}
.beacon-anim{animation:beaconPulse 1.5s ease-in-out infinite;transform-origin:center}
.light-anim-1{animation:lightTwinkle 2s ease-in-out infinite}
.light-anim-2{animation:lightTwinkle 2.3s ease-in-out infinite .3s}
.light-anim-3{animation:lightTwinkle 1.8s ease-in-out infinite .7s}
.stat-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.stat-card{background:var(--bg-white);border:1px solid var(--border);padding:24px 16px;text-align:center;position:relative}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--primary)}
.stat-card .num{font-size:36px;font-weight:800;color:var(--primary)}
.stat-card .lbl{font-size:13px;color:var(--text-light);text-transform:uppercase;letter-spacing:1px;margin-top:4px}
.stat-card .desc{font-size:11px;color:#889;margin-top:6px;font-style:italic}
.chart-wrap{background:var(--bg-white);border:1px solid var(--border);padding:20px;min-height:400px;position:relative;overflow:hidden}
.chart-wrap svg{display:block;margin:0 auto}
.chart-tooltip{position:absolute;background:var(--navy);color:#fff;padding:8px 14px;border-radius:4px;font-size:12px;pointer-events:none;opacity:0;transition:opacity .2s;z-index:100;line-height:1.5;max-width:220px}
.search-box{max-width:650px;margin:0 auto;display:flex;gap:0}
.search-box input{flex:1;padding:14px 18px;font-size:16px;border:3px solid var(--primary);border-right:none;outline:none;background:var(--bg-white);color:var(--text-dark);font-family:'Open Sans',sans-serif}
.search-box input:focus{border-color:var(--accent)}
.search-box button{padding:14px 22px;background:var(--primary);color:#fff;font-size:16px;font-weight:700;border:3px solid var(--primary);cursor:pointer;transition:background .15s;font-family:'Open Sans',sans-serif}
.search-box button:hover{background:var(--primary-dark)}
.search-filters{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:14px}
.search-filters select{padding:8px 12px;font-size:13px;border:2px solid var(--border);background:var(--bg-white);font-family:'Open Sans',sans-serif;color:var(--text-dark);min-width:150px}
.search-filters select:focus{border-color:var(--primary);outline:none}
.search-results{margin-top:16px;max-height:500px;overflow-y:auto}
.airport-hero{background:linear-gradient(135deg,var(--navy),#142b4f);padding:36px 0;border-bottom:4px solid var(--primary)}
.airport-hero .codes{font-size:22px;color:var(--primary);font-weight:700;margin-bottom:4px;letter-spacing:1px}
.airport-hero h1{color:#fff;font-size:30px;margin-bottom:4px}
.airport-hero .meta{color:#8899aa;font-size:13px}
.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:20px 0}
@media(max-width:768px){.profile-grid{grid-template-columns:1fr}}
.map-wrap{height:360px;border:2px solid var(--border);margin:16px 0;position:relative}
.map-style-btn{position:absolute;top:10px;right:10px;z-index:1000;display:flex;gap:4px}
.map-style-btn button{padding:6px 12px;font-size:11px;font-weight:700;border:2px solid var(--primary);background:#fff;color:var(--text-dark);cursor:pointer;font-family:'Open Sans',sans-serif;transition:all .15s}
.map-style-btn button.active{background:var(--primary);color:#fff}
.map-style-btn button:hover{background:var(--primary);color:#fff}
.country-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.country-card{background:var(--bg-white);border:1px solid var(--border);padding:18px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:all .15s}
.country-card:hover{border-color:var(--primary);transform:scale(1.02);box-shadow:0 4px 16px rgba(44,164,220,.15)}
.country-card .flag{font-size:36px;line-height:1}
.country-card .info{flex:1}
.country-card .name{font-size:15px;font-weight:600;color:var(--text-dark)}
.country-card .count{font-size:12px;color:var(--text-light)}
.country-card .count strong{color:var(--primary)}
.dist-form{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
@media(max-width:600px){.dist-form{grid-template-columns:1fr}}
.dist-form label{display:block;font-size:13px;font-weight:700;color:var(--text-dark);margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px}
.dist-form select{width:100%;padding:10px 12px;font-size:14px;border:2px solid var(--border);background:var(--bg-white);font-family:'Open Sans',sans-serif}
.dist-form select:focus{border-color:var(--primary);outline:none}
.btn-calc{padding:14px 40px;background:var(--primary);color:#fff;font-size:16px;font-weight:700;border:3px solid var(--primary);cursor:pointer;transition:all .15s;font-family:'Open Sans',sans-serif;display:block;margin:0 auto}
.btn-calc:hover{background:var(--primary-dark)}
.dist-result{background:var(--bg-white);border:2px solid var(--primary);padding:24px;display:none;margin-top:16px;position:relative}
.dist-result.visible{display:block}
.dist-result h3{font-size:18px;color:var(--text-dark);margin-bottom:12px;text-align:center}
.dist-val{display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:center;margin-top:16px}
.dist-val .val{font-size:32px;font-weight:800;color:var(--primary)}
.dist-val .lbl{font-size:12px;color:var(--text-light);text-transform:uppercase;letter-spacing:1px}
.globe-svg-wrap{text-align:center;margin-bottom:10px}
.purchase-box{background:linear-gradient(135deg,#f8f9fa,#eef1f5);border:2px solid var(--border);padding:30px;text-align:center;margin:30px 0}
.purchase-box h3{font-size:20px;color:var(--text-dark);margin-bottom:8px}
.purchase-box p{font-size:14px;color:var(--text-light);margin-bottom:16px}
.card-icons{display:flex;justify-content:center;gap:20px;font-size:28px;color:#556;margin-bottom:12px}
.card-icons span{background:var(--bg-white);border:1px solid var(--border);padding:8px 16px;border-radius:4px}
footer{background:var(--navy);color:#8899aa;padding:36px 0 24px;margin-top:40px;border-top:4px solid var(--primary);font-size:13px;text-align:center}
footer strong{color:#ccdbe8}
footer a{color:var(--primary)}
footer .footer-inner>*{margin-bottom:8px}
@media(max-width:768px){
  .hero h1{font-size:28px}.hero .subtitle{font-size:15px}.hero-stats{gap:24px}
  .hero-stat .num{font-size:26px}.stat-cards{grid-template-columns:1fr 1fr}
  .section{padding:36px 0}.search-box{flex-direction:column}
  .search-box input{border-right:3px solid var(--primary)}
  .search-filters select{min-width:120px}
}
.story-text{font-size:16px;color:var(--text-light);max-width:700px;margin:0 auto;text-align:center;line-height:1.9}
.story-text strong{color:var(--text-dark)}
.globe-deco{text-align:center;font-size:80px;margin-bottom:10px;opacity:.6}
.chart-controls{text-align:center;margin-bottom:14px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.chart-controls select{padding:8px 12px;font-size:13px;border:2px solid var(--border);background:var(--bg-white);font-family:'Open Sans',sans-serif;color:var(--text-dark);min-width:160px}
.chart-controls select:focus{border-color:var(--primary);outline:none}
.back-btn{display:inline-block;margin:0 auto 10px;padding:6px 18px;border:2px solid var(--primary);color:var(--primary);font-size:12px;font-weight:700;cursor:pointer;background:var(--bg-white);transition:all .15s;font-family:'Open Sans',sans-serif}
.back-btn:hover{background:var(--primary);color:#fff}
.chart-legend{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:12px;font-size:12px;color:var(--text-light)}
.chart-legend span{display:inline-flex;align-items:center;gap:4px}
.chart-legend .dot{width:10px;height:10px;border-radius:50%;display:inline-block}
</style>
</head>
<body>

<!-- ═══ HERO ═══ -->
<div class="hero" id="hero">
  <svg class="hero-svg-bg" viewBox="0 0 1920 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <!-- Sky gradient -->
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#060d1a"/>
        <stop offset="30%" stop-color="#0a1628"/>
        <stop offset="60%" stop-color="#0d1f36"/>
        <stop offset="100%" stop-color="#162a45"/>
      </linearGradient>
      <!-- Horizon glow -->
      <radialGradient id="cityGlow" cx="50%" cy="45%" r="50%">
        <stop offset="0%" stop-color="#c8aa78" stop-opacity="0.12"/>
        <stop offset="50%" stop-color="#c8aa78" stop-opacity="0.04"/>
        <stop offset="100%" stop-color="#c8aa78" stop-opacity="0"/>
      </radialGradient>
      <!-- Ground gradient -->
      <linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1a2a3a"/>
        <stop offset="40%" stop-color="#1e2e3e"/>
        <stop offset="100%" stop-color="#16222e"/>
      </linearGradient>
      <!-- Runway gradient -->
      <linearGradient id="rwyGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2a2a3a"/>
        <stop offset="50%" stop-color="#3a3a4a"/>
        <stop offset="100%" stop-color="#4a4a54"/>
      </linearGradient>
      <!-- Taxiway gradient -->
      <linearGradient id="taxiGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2a2a38"/>
        <stop offset="100%" stop-color="#252532"/>
      </linearGradient>
      <!-- Terminal windows -->
      <linearGradient id="windowLit" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFE8A0"/>
        <stop offset="100%" stop-color="#FFD060"/>
      </linearGradient>
      <!-- Fog -->
      <linearGradient id="fogGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#060d1a" stop-opacity="0"/>
        <stop offset="40%" stop-color="#060d1a" stop-opacity="0.15"/>
        <stop offset="100%" stop-color="#060d1a" stop-opacity="0.35"/>
      </linearGradient>
      <!-- Beacon glow -->
      <radialGradient id="beaconGlow">
        <stop offset="0%" stop-color="#FF2222"/>
        <stop offset="40%" stop-color="#FF2222" stop-opacity="0.4"/>
        <stop offset="100%" stop-color="#FF2222" stop-opacity="0"/>
      </radialGradient>
      <!-- Landing light cone -->
      <radialGradient id="landingLightCone" cx="50%" cy="0%" r="50%">
        <stop offset="0%" stop-color="#FFFFCC" stop-opacity="0.15"/>
        <stop offset="100%" stop-color="#FFFFCC" stop-opacity="0"/>
      </radialGradient>
      <!-- Navigation light glows -->
      <radialGradient id="redNavGlow">
        <stop offset="0%" stop-color="#FF3333"/>
        <stop offset="50%" stop-color="#FF3333" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#FF3333" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="greenNavGlow">
        <stop offset="0%" stop-color="#33FF33"/>
        <stop offset="50%" stop-color="#33FF33" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#33FF33" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="whiteStrobeGlow">
        <stop offset="0%" stop-color="#FFFFFF"/>
        <stop offset="40%" stop-color="#FFFFFF" stop-opacity="0.4"/>
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
      </radialGradient>
      <!-- Edge light glow -->
      <radialGradient id="edgeLightGlow">
        <stop offset="0%" stop-color="#FF8C00"/>
        <stop offset="50%" stop-color="#FF8C00" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#FF8C00" stop-opacity="0"/>
      </radialGradient>
      <!-- Threshold light glow -->
      <radialGradient id="thresholdGlow">
        <stop offset="0%" stop-color="#00FF66"/>
        <stop offset="50%" stop-color="#00FF66" stop-opacity="0.4"/>
        <stop offset="100%" stop-color="#00FF66" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- Sky -->
    <rect width="1920" height="600" fill="url(#sky)"/>

    <!-- Stars (subtle) -->
    <g opacity="0.6">
      <circle cx="100" cy="30" r="0.8" fill="#c8dcff" class="light-anim-1"/>
      <circle cx="300" cy="55" r="1" fill="#c8dcff" class="light-anim-2"/>
      <circle cx="500" cy="20" r="0.7" fill="#c8dcff" class="light-anim-3"/>
      <circle cx="750" cy="45" r="0.9" fill="#c8dcff" class="light-anim-1"/>
      <circle cx="950" cy="25" r="1.1" fill="#c8dcff" class="light-anim-2"/>
      <circle cx="1200" cy="50" r="0.6" fill="#c8dcff" class="light-anim-3"/>
      <circle cx="1400" cy="35" r="0.9" fill="#c8dcff" class="light-anim-1"/>
      <circle cx="1600" cy="60" r="0.8" fill="#c8dcff" class="light-anim-2"/>
      <circle cx="1800" cy="40" r="1" fill="#c8dcff" class="light-anim-3"/>
      <circle cx="200" cy="90" r="0.7" fill="#c8dcff" class="light-anim-1"/>
      <circle cx="600" cy="100" r="0.6" fill="#c8dcff" class="light-anim-2"/>
      <circle cx="1100" cy="80" r="0.9" fill="#c8dcff" class="light-anim-3"/>
      <circle cx="1500" cy="95" r="0.8" fill="#c8dcff" class="light-anim-1"/>
      <circle cx="1750" cy="110" r="0.7" fill="#c8dcff" class="light-anim-2"/>
      <!-- More stars -->
      <circle cx="50" cy="150" r="0.5" fill="#aabbdd" opacity="0.4"/>
      <circle cx="180" cy="170" r="0.6" fill="#aabbdd" opacity="0.3"/>
      <circle cx="420" cy="130" r="0.4" fill="#aabbdd" opacity="0.5"/>
      <circle cx="680" cy="160" r="0.5" fill="#aabbdd" opacity="0.3"/>
      <circle cx="850" cy="140" r="0.6" fill="#aabbdd" opacity="0.4"/>
      <circle cx="1050" cy="155" r="0.4" fill="#aabbdd" opacity="0.3"/>
      <circle cx="1300" cy="145" r="0.5" fill="#aabbdd" opacity="0.5"/>
      <circle cx="1550" cy="165" r="0.6" fill="#aabbdd" opacity="0.3"/>
      <circle cx="1700" cy="135" r="0.4" fill="#aabbdd" opacity="0.4"/>
      <circle cx="1880" cy="150" r="0.5" fill="#aabbdd" opacity="0.3"/>
    </g>

    <!-- City glow on horizon -->
    <rect x="0" y="180" width="1920" height="120" fill="url(#cityGlow)"/>

    <!-- Ground -->
    <rect x="0" y="228" width="1920" height="372" fill="url(#ground)"/>

    <!-- ===== RUNWAY ===== -->
    <polygon points="864,228 956,228 1150,528 770,528" fill="url(#rwyGrad)" stroke="#555555" stroke-width="1"/>

    <!-- Runway centerline dashes -->
    <line x1="960" y1="260" x2="960" y2="275" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
    <line x1="955" y1="290" x2="965" y2="305" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
    <line x1="950" y1="320" x2="970" y2="335" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
    <line x1="945" y1="350" x2="975" y2="365" stroke="rgba(255,255,255,0.6)" stroke-width="2"/>
    <line x1="940" y1="380" x2="980" y2="395" stroke="rgba(255,255,255,0.6)" stroke-width="2"/>
    <line x1="935" y1="410" x2="985" y2="425" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
