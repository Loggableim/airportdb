<SiteFooter />

<script>
(function(){
  const $ = (id) => document.getElementById(id);
  const makeSlug = (name) => {
    if (!name) return '';
    return name.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/['']/g,'').replace(/[–—]/g,'-').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'').slice(0,80);
  };
  let airports = null;

  async function ensureData() {
    if (airports) return airports;
    const r = await fetch('/data/airports-light.json');
    airports = await r.json();
    return airports;
  }

  let timer = null;
  window.runSearch = function() {
    clearTimeout(timer);
    timer = setTimeout(_doSearch, 180);
  };

  async function _doSearch() {
    const q = $('qsearch').value.toLowerCase().trim();
    const cont = $('qcont').value;
    const results = $('sresults');
    const tbody = $('sresults-tbody');
    if (!q && !cont) { results.style.display = 'none'; return; }
    const data = await ensureData();
    const matches = [];
    for (const a of data) {
      if (cont && a.z !== cont) continue;
      if (q) {
        const hay = ((a.i||'') + ' ' + (a.o||'') + ' ' + a.n + ' ' + (a.m||'') + ' ' + (a.c||'')).toLowerCase();
        if (!hay.includes(q)) continue;
      }
      matches.push(a);
      if (matches.length >= 50) break;
    }
    if (!matches.length) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:#64748b">No airports match your search.</td></tr>';
    } else {
      tbody.innerHTML = matches.map(a => {
        const cs = makeSlug(a.c);
        const ns = makeSlug(a.n);
        const link = a.i ? `/airports/${cs}/${ns}-${a.i.toLowerCase()}/` : '#';
        const tlabel = (a.t||'').replace(/_/g,' ');
        return `<tr onclick="location.href='${link}'"><td>${a.i ? '<span style="display:inline-block;background:#2ca4dc;color:#fff;padding:2px 8px;border-radius:3px;font-size:11px;font-weight:700">' + a.i + '</span>' : '—'}</td><td>${a.o || '—'}</td><td>${a.n}</td><td>${a.m || '—'}</td><td>${a.c}</td><td>${tlabel}</td></tr>`;
      }).join('');
    }
    results.style.display = 'block';
  }
})();
</script>
</body>
</html>
