<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// ══════════════════════════════════════════════════════════════
// ║  HERO — AIRPORT GAME (Canvas 2D)                       ║
// ══════════════════════════════════════════════════════════════
(function airportGame() {
  const canvas = document.getElementById('hero-canvas');
  const hero = document.getElementById('hero');
  const ctx = canvas.getContext('2d');
  let W, H;
  
  function resize() {
    const rect = hero.getBoundingClientRect();
    W = canvas.width = rect.width || hero.offsetWidth;
    H = canvas.height = rect.height || hero.offsetHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  // ── Stars ──
  const stars = [];
  for (let i = 0; i < 80; i++) {
    stars.push({
      x: Math.random(), y: Math.random(),
      r: Math.random() * 1.5 + 0.3,
      speed: Math.random() * 0.02 + 0.003,
      phase: Math.random() * Math.PI * 2
    });
  }

  // ── Runway geometry (perspective: wider at bottom, narrow at top) ──
  function getRunwayPath() {
    const cx = W / 2; // center
    const botY = H * 0.85; // near end
    const topY = H * 0.3; // far end (horizon)
    const botW = W * 0.45; // width at near end
    const topW = W * 0.06; // width at far end
    return {
      cx, botY, topY, botW, topW,
      // Runway center line (vanishing point at horizon center)
      leftBot: cx - botW/2, leftTop: cx - topW/2,
      rightBot: cx + botW/2, rightTop: cx + topW/2
    };
  }

  // ── Tower position ──
  function getTowerPos() {
    // Right side of runway, halfway up
    const cx = W / 2;
    const rw = getRunwayPath();
    return { x: rw.rightBot + 15, y: rw.botY * 0.7 };
  }

  // ── Draw runway ──
  function drawRunway(rp, lightsOn) {
    // Runway surface (dark gray with perspective gradient)
    ctx.beginPath();
    ctx.moveTo(rp.leftBot, rp.botY);
    ctx.lineTo(rp.leftTop, rp.topY);
    ctx.lineTo(rp.rightTop, rp.topY);
    ctx.lineTo(rp.rightBot, rp.botY);
    ctx.closePath();
    const grad = ctx.createLinearGradient(0, rp.topY, 0, rp.botY);
    grad.addColorStop(0, '#2a2a3a');
    grad.addColorStop(0.3, '#3a3a4a');
    grad.addColorStop(1, '#4a4a5a');
    ctx.fillStyle = grad;
    ctx.fill();
    ctx.strokeStyle = '#555';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    // Runway center line (dashed, perspective)
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.setLineDash([8, 12]);
    ctx.beginPath();
    ctx.moveTo(rp.cx, rp.topY);
    ctx.lineTo(rp.cx, rp.botY);
    ctx.stroke();
    ctx.setLineDash([]);

    // Runway edge lights (yellow dots)
    const nLights = 30;
    for (let i = 0; i < nLights; i++) {
      const t = i / nLights;
      const leftX = rp.leftBot + (rp.leftTop - rp.leftBot) * t;
      const rightX = rp.rightBot + (rp.rightTop - rp.rightBot) * t;
      const y = rp.botY + (rp.topY - rp.botY) * t;
      // Left row
      ctx.beginPath();
      ctx.arc(leftX, y, 2 + t * 0.5, 0, Math.PI * 2);
      ctx.fillStyle = lightsOn ? '#FFA500' : '#884400';
      ctx.shadowBlur = lightsOn ? 6 : 0;
      ctx.shadowColor = '#FFA500';
      ctx.fill();
      // Right row
      ctx.beginPath();
      ctx.arc(rightX, y, 2 + t * 0.5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.shadowBlur = 0;

    // Threshold lights (green at near end)
    for (let i = 0; i < 10; i++) {
      const x = rp.leftBot + (rp.rightBot - rp.leftBot) * (i / 10);
      ctx.beginPath();
      ctx.arc(x, rp.botY - 2, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = '#00FF66';
      ctx.shadowBlur = 5;
      ctx.shadowColor = '#00FF66';
      ctx.fill();
    }
    ctx.shadowBlur = 0;
  }

  // ── Taxiway ──
  function drawTaxiway(rp) {
    // Parallel taxiway left of runway
    const lx = rp.leftBot - W * 0.12;
    const rx = rp.leftBot - W * 0.08;
    ctx.beginPath();
    ctx.moveTo(lx, rp.botY);
    ctx.lineTo(rp.leftTop - W * 0.06, rp.topY);
    ctx.lineTo(rp.leftTop - W * 0.04, rp.topY);
    ctx.lineTo(rp.leftBot - W * 0.06, rp.botY);
    ctx.closePath();
    ctx.fillStyle = '#2a2a3a';
    ctx.fill();
    ctx.strokeStyle = '#444';
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // ── Draw tower ──
  function drawTower(lightOn) {
    const tp = getTowerPos();
    const s = Math.min(W, 1000) / 1000;
    // Base
    ctx.fillStyle = '#1a2a3a';
    ctx.fillRect(tp.x - 8 * s, tp.y + 10 * s, 16 * s, -40 * s);
    // Top platform
    ctx.fillStyle = '#2a3a4a';
    ctx.fillRect(tp.x - 12 * s, tp.y - 28 * s, 24 * s, 4 * s);
    // Antenna
    ctx.strokeStyle = '#666';
    ctx.lineWidth = 1.5 * s;
    ctx.beginPath();
    ctx.moveTo(tp.x, tp.y - 28 * s);
    ctx.lineTo(tp.x, tp.y - 40 * s);
    ctx.stroke();
    // Blinking red light
    ctx.beginPath();
    ctx.arc(tp.x, tp.y - 40 * s, 3 * s, 0, Math.PI * 2);
    ctx.shadowBlur = lightOn ? 15 : 0;
    ctx.shadowColor = '#FF0000';
    ctx.fillStyle = lightOn ? '#FF0000' : '#880000';
    ctx.fill();
    ctx.shadowBlur = 0;
  }

  // ── Terminal building ──
  function drawTerminal(rp) {
    const tx = rp.leftBot - W * 0.2;
    const s = Math.min(W, 1000) / 1000;
    // Main building
    ctx.fillStyle = '#1a2a3a';
    ctx.fillRect(tx, rp.botY - 30 * s, 40 * s, 25 * s);
    // Roof
    ctx.fillStyle = '#2a3a4a';
    ctx.fillRect(tx - 2 * s, rp.botY - 33 * s, 44 * s, 5 * s);
    // Windows (lit)
    ctx.fillStyle = '#FFE4A0';
    for (let i = 0; i < 6; i++) {
      const wx = tx + 4 * s + i * 6 * s;
      const wy = rp.botY - 26 * s + (i % 2) * 10 * s;
      ctx.fillRect(wx, wy, 3 * s, 5 * s);
    }
  }

  // ── Draw airplane (detailed game-style) ──
  function drawPlane(x, y, scale, angle, color, lights) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.scale(scale, scale);
    
    // Shadow/glow
    ctx.shadowColor = 'rgba(255,255,255,0.15)';
    ctx.shadowBlur = 10;

    // Fuselage
    ctx.beginPath();
    ctx.moveTo(16, 0);
    ctx.lineTo(-14, -4);
    ctx.lineTo(-14, 4);
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
    ctx.lineWidth = 0.5;
    ctx.stroke();

    // Wings (upper)
    ctx.beginPath();
    ctx.moveTo(4, -1);
    ctx.lineTo(-4, -10);
    ctx.lineTo(-10, -10);
    ctx.lineTo(-6, -1);
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
    ctx.stroke();

    // Wings (lower)
    ctx.beginPath();
    ctx.moveTo(4, 1);
    ctx.lineTo(-4, 10);
    ctx.lineTo(-10, 10);
    ctx.lineTo(-6, 1);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // Tail (upper)
    ctx.beginPath();
    ctx.moveTo(-10, 0);
    ctx.lineTo(-16, -6);
    ctx.lineTo(-18, -6);
    ctx.lineTo(-12, 0);
    ctx.closePath();
    ctx.fill();
    // Tail (lower)
    ctx.beginPath();
    ctx.moveTo(-10, 0);
    ctx.lineTo(-16, 6);
    ctx.lineTo(-18, 6);
    ctx.lineTo(-12, 0);
    ctx.closePath();
    ctx.fill();

    // Cockpit window
    ctx.beginPath();
    ctx.moveTo(12, 0);
    ctx.lineTo(6, -2);
    ctx.lineTo(6, 2);
    ctx.closePath();
    ctx.fillStyle = 'rgba(200,230,255,0.5)';
    ctx.fill();

    // Wing lights (navigation)
    if (lights) {
      // Red left, green right
      ctx.shadowBlur = 0;
      ctx.beginPath();
      ctx.arc(-6, -10, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = '#FF0000';
      ctx.fill();
      ctx.beginPath();
      ctx.arc(-6, 10, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = '#00FF00';
      ctx.fill();
    }

    ctx.shadowBlur = 0;
    ctx.restore();
  }

  // ── Planes ──
  const PLANE_COLORS = ['#e8e8f0', '#f0e8d0', '#d0e8f0', '#f0d8d8', '#d8f0d8'];
  
  function createPlane() {
    const rw = getRunwayPath();
    const types = ['takeoff', 'landing', 'taxi', 'circling'];
    const type = types[Math.floor(Math.random() * types.length)];
    
    let x, y, angle, speed, progress;
    
    switch (type) {
      case 'takeoff':
        // Start at bottom of runway, accelerate up
        progress = Math.random() * 0.4;
        x = rw.cx + (Math.random() - 0.5) * 4;
        y = rw.botY - progress * (rw.botY - rw.topY);
        angle = 0;
        speed = 0.003 + Math.random() * 0.003;
        break;
      case 'landing':
        // Approach from top
        progress = Math.random() * 0.5;
        x = rw.cx + (Math.random() - 0.5) * 6;
        y = rw.topY + progress * (rw.botY - rw.topY);
        angle = 0.03;
        speed = 0.004 + Math.random() * 0.003;
        break;
      case 'taxi':
        // On taxiway
        progress = Math.random();
        const twX = rw.leftBot - W * 0.10;
        x = twX + (Math.random() - 0.5) * 10;
        y = rw.botY * 0.5 + Math.random() * rw.botY * 0.3;
        angle = 0;
        speed = 0.001 + Math.random() * 0.002;
        break;
      default: // circling
        progress = Math.random();
        const cx = rw.cx + W * 0.25;
        const cy = rw.topY - H * 0.15;
        const rad = 80 + Math.random() * 40;
        angle = progress * Math.PI * 2;
        x = cx + Math.cos(angle) * rad;
        y = cy + Math.sin(angle * 1.5) * rad * 0.5;
        speed = 0.002 + Math.random() * 0.002;
    }
    
    return {
      type, x, y, angle, speed,
      progress: progress || 0,
      color: PLANE_COLORS[Math.floor(Math.random() * PLANE_COLORS.length)],
      alive: true,
      scale: 0.8 + Math.random() * 0.4,
      timer: 0
    };
  }

  // ── Game loop state ──
  let planes = [];
  // Spawn initial planes
  for (let i = 0; i < 4; i++) {
    const p = createPlane();
    p.progress = i * 0.25;
    planes.push(p);
  }
  let frameId = null;
  let active = true;

  // ── Visibility pause ──
  const observer = new IntersectionObserver((entries) => {
    active = entries[0].isIntersecting;
    if (!active && frameId) {
      cancelAnimationFrame(frameId);
      frameId = null;
    } else if (active) {
      frame();
    }
  }, { threshold: 0.1 });
  observer.observe(hero);

  function frame() {
    if (!active) { frameId = null; return; }

    const lightsOn = Math.floor(Date.now() / 400) % 2 === 0;
    const towerLight = Math.floor(Date.now() / 800) % 2 === 0;
    const rp = getRunwayPath();

    // Semi-transparent clear for motion blur
    ctx.fillStyle = 'rgba(6,13,26,0.08)';
    ctx.fillRect(0, 0, W, H);

    // Stars
    stars.forEach(s => {
      const t = Math.sin(Date.now() * s.speed + s.phase) * 0.3 + 0.7;
      ctx.beginPath();
      ctx.arc(s.x * W, s.y * H, s.r * t, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(200,220,255,${t * 0.7})`;
      ctx.fill();
    });

    // Ground fog effect
    ctx.fillStyle = 'rgba(6,13,26,0.3)';
    ctx.fillRect(0, H * 0.75, W, H * 0.25);

    // Draw static elements
    drawTaxiway(rp);
    drawRunway(rp, lightsOn);
    drawTerminal(rp);
    drawTower(towerLight);

    // Update and draw planes
    planes = planes.filter(p => p.alive);

    if (planes.length < 3 && Math.random() < 0.01) {
      planes.push(createPlane());
    }

    planes.forEach(p => {
      p.timer++;

      switch (p.type) {
        case 'takeoff': {
          // Accelerate up runway
          p.progress += p.speed;
          if (p.progress > 1.2) { p.progress = 0; p.timer = 0; }
          const nt = Math.min(p.progress, 1);
          y = rp.botY - nt * (rp.botY - rp.topY);
          const lateralOffset = Math.sin(p.timer * 0.5) * 1.5;
          x = rp.cx + lateralOffset;
          angle = -0.05 * Math.sin(p.timer * 0.3);
          // Lift off past 70%
          if (nt > 0.7) {
            p.scale *= 0.998;
            angle = -0.15 - (nt - 0.7) * 0.5;
            x += (nt - 0.7) * 20 * (p.x > rp.cx ? 1 : -1);
          }
          break;
        }
        case 'landing': {
          p.progress += p.speed;
          if (p.progress > 1.3) { p.progress = -0.3; p.timer = 0; }
          const lt = Math.max(p.progress, 0);
          y = rp.topY + lt * (rp.botY - rp.topY);
          x = rp.cx + (Math.random() - 0.5) * 6 * (1 - lt);
          angle = lt < 0.4 ? -0.12 + lt * 0.3 : 0.02;
          p.scale = 0.6 + lt * 1.0;
          break;
        }
        case 'taxi': {
          p.progress += p.speed;
          if (p.progress > 1) p.progress = 0;
          const twX = rp.leftBot - W * 0.10;
          x = twX + Math.sin(p.progress * Math.PI * 2) * 5;
          y = rp.botY - p.progress * (rp.botY - rp.topY) * 1.1;
          angle = 0;
          p.scale = 0.7 + 0.3 * (1 - p.progress);
          break;
        }
        default: { // circling
          p.progress += p.speed;
          const cx = rp.cx + W * 0.25;
          const cy = rp.topY - H * 0.10;
          const rad = 60 + W * 0.05;
          const a = p.progress * Math.PI * 2;
          x = cx + Math.cos(a) * rad;
          y = cy + Math.sin(a * 1.3) * rad * 0.4;
          angle = -Math.atan2(Math.sin(a * 1.3) * 0.4, Math.cos(a)) + Math.PI / 2;
          // Shrink with distance (depth cue)
          const depthFactor = 0.6 + 0.4 * (1 - (y / rp.botY));
          p.scale = (0.8 + 0.4 * Math.sin(a * 0.5)) * depthFactor;
          break;
        }
      }

      drawPlane(x, y, p.scale, angle, p.color, p.timer % 60 < 30);
    });

    frameId = requestAnimationFrame(frame);
  }

  // Initial fill
  ctx.fillStyle = '#060d1a';
  ctx.fillRect(0, 0, W, H);
  frame();
})();

// ══════════════════════════════════════════════════════════════
// ║  COUNTER ANIMATION                                       ║
// ══════════════════════════════════════════════════════════════
(function countUp() {
  const els = document.querySelectorAll('[data-count]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target;
        const target = parseInt(el.dataset.count);
        const duration = 1500;
        const start = performance.now();
        function step(now) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target).toLocaleString();
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  els.forEach(el => observer.observe(el));
})();

// ══════════════════════════════════════════════════════════════
// ║  CONTINENT EXPLORER (D3.js Bubble Chart)                ║
// ══════════════════════════════════════════════════════════════
const CONT_DATA = [
  {id:"NA",label:"North America", total:39581, iata:2950, color:"#2C7BE5"},
  {id:"EU",label:"Europe",       total:12489, iata:927,  color:"#E9C46A"},
  {id:"AS",label:"Asia",         total:12719, iata:1903, color:"#F4A261"},
  {id:"SA",label:"South America", total:12262, iata:921, color:"#6CB4EE"},
  {id:"AF",label:"Africa",       total:4226,  iata:1065, color:"#E76F51"},
  {id:"OC",label:"Oceania",      total:4221,  iata:1287, color:"#2A9D8F"},
  {id:"AN",label:"Antarctica",   total:47,    iata:3,    color:"#D4E8F7"}
];

const CONT_COUNTRIES = {
  NA:[{n:"United States",c:32518},{n:"Canada",c:8513},{n:"Mexico",c:2694},{n:"Puerto Rico",c:329},{n:"Greenland",c:191}],
  EU:[{n:"France",c:1768},{n:"United Kingdom",c:1593},{n:"Germany",c:1432},{n:"Italy",c:1114},{n:"Spain",c:507}],
  AS:[{n:"Japan",c:3747},{n:"Russia",c:1808},{n:"China",c:776},{n:"India",c:649},{n:"Indonesia",c:728}],
  SA:[{n:"Brazil",c:7947},{n:"Argentina",c:995},{n:"Venezuela",c:898},{n:"Colombia",c:736},{n:"Chile",c:356}],
  AF:[{n:"South Africa",c:674},{n:"Egypt",c:216},{n:"Madagascar",c:208},{n:"Morocco",c:175},{n:"Kenya",c:171}],
  OC:[{n:"Australia",c:2789},{n:"New Zealand",c:529},{n:"Papua New Guinea",c:309},{n:"Fiji",c:136},{n:"Solomon Islands",c:110}],
  AN:[{n:"Antarctica",c:47}]
};

let currentView = 'continents'; // 'continents' or 'countries'

function drawContinentBubbles() {
  const wrap = document.getElementById('continent-chart');
  const w = wrap.clientWidth - 40;
  const h = 420;
  if (w < 100) { setTimeout(drawContinentBubbles, 200); return; }

  d3.select(wrap).selectAll('svg').remove();

  const svg = d3.select(wrap).append('svg')
    .attr('width', w)
    .attr('height', h);

  const pack = d3.pack().size([w-40, h-40]).padding(8);
  const root = d3.hierarchy({children: CONT_DATA}).sum(d => d.total);
  const nodes = pack(root).leaves();

  const g = svg.append('g')
    .attr('transform', `translate(20,20)`);

  const tooltip = document.getElementById('continent-tooltip');

  // Bubbles
  const circles = g.selectAll('circle')
    .data(nodes)
    .enter().append('circle')
    .attr('r', d => d.r)
    .attr('fill', d => d.data.color)
    .attr('stroke', '#fff')
    .attr('stroke-width', 2)
    .attr('opacity', 0)
    .attr('cx', d => d.x)
    .attr('cy', d => d.y)
    .style('cursor', 'pointer')
    .on('mouseover', function(ev, d) {
      d3.select(this).attr('stroke', '#333').attr('stroke-width', 3);
      const cd = d.data;
      tooltip.style.opacity = 1;
      tooltip.innerHTML = `<strong>${cd.label}</strong><br>Total: ${cd.total.toLocaleString()}<br>IATA: ${cd.iata.toLocaleString()}`;
    })
    .on('mousemove', function(ev) {
      const r = wrap.getBoundingClientRect();
      tooltip.style.left = (ev.clientX - r.left + 15) + 'px';
      tooltip.style.top = (ev.clientY - r.top - 10) + 'px';
    })
    .on('mouseout', function() {
      d3.select(this).attr('stroke', '#fff').attr('stroke-width', 2);
      tooltip.style.opacity = 0;
    })
    .on('click', function(ev, d) {
      drillContinent(d.data.id);
    });

  // Entrance
  circles.transition()
    .duration(600)
    .delay((d,i) => i * 100)
    .ease(d3.easeElasticOut)
    .attr('opacity', 0.85);

  // Labels
  const labels = g.selectAll('text.cont-label')
    .data(nodes)
    .enter().append('text')
    .attr('class', 'cont-label')
    .attr('x', d => d.x)
    .attr('y', d => d.y)
    .attr('text-anchor', 'middle')
    .attr('dy', '0.35em')
    .attr('font-size', d => Math.min(d.r * 0.35, 14))
    .attr('font-weight', '700')
    .attr('fill', '#fff')
    .attr('opacity', 0)
    .text(d => d.data.id);

  labels.transition()
    .duration(600)
    .delay((d,i) => i * 100 + 300)
    .attr('opacity', 1);

  // Count labels under name
  const countLabels = g.selectAll('text.cont-count')
    .data(nodes)
    .enter().append('text')
    .attr('class', 'cont-count')
    .attr('x', d => d.x)
    .attr('y', d => d.y + 12)
    .attr('text-anchor', 'middle')
    .attr('font-size', d => Math.min(d.r * 0.2, 10))
    .attr('fill', 'rgba(255,255,255,0.7)')
    .attr('opacity', 0)
    .text(d => d.data.total.toLocaleString());

  countLabels.transition()
    .duration(600)
    .delay((d,i) => i * 100 + 500)
    .attr('opacity', 1);

  // Legend
  const legend = document.getElementById('continent-legend');
  legend.innerHTML = CONT_DATA.map(c => 
    `<span><span class="dot" style="background:${c.color}"></span>${c.label}</span>`
  ).join('');
}

function drillContinent(id) {
  currentView = 'countries';
  document.getElementById('continent-back').style.display = 'block';
  const countries = CONT_COUNTRIES[id] || [{n:"No data",c:0}];
  const cont = CONT_DATA.find(c => c.id === id);
  const wrap = document.getElementById('continent-chart');
  const w = wrap.clientWidth - 40;
  const h = 420;

  d3.select(wrap).selectAll('svg').remove();

  const svg = d3.select(wrap).append('svg')
    .attr('width', w)
    .attr('height', h);

  const pack = d3.pack().size([w-40, h-40]).padding(6);
  const root = d3.hierarchy({children: countries.map(c => ({label:c.n, total:c.c, color:cont ? cont.color : '#888'}))})
    .sum(d => d.total);
  const nodes = pack(root).leaves();

  const g = svg.append('g').attr('transform', `translate(20,20)`);
  const tooltip = document.getElementById('continent-tooltip');

  g.selectAll('circle')
    .data(nodes)
    .enter().append('circle')
    .attr('r', 0)
    .attr('fill', d => d.data.color)
    .attr('stroke', '#fff')
    .attr('stroke-width', 2)
    .attr('cx', d => d.x)
    .attr('cy', d => d.y)
    .style('cursor', 'pointer')
    .on('mouseover', function(ev, d) {
      d3.select(this).attr('stroke', '#333').attr('stroke-width', 3);
      tooltip.style.opacity = 1;
      tooltip.innerHTML = `<strong>${d.data.label}</strong><br>Airports: ${d.total.toLocaleString()}`;
    })
    .on('mousemove', function(ev) {
      const r = wrap.getBoundingClientRect();
      tooltip.style.left = (ev.clientX - r.left + 15) + 'px';
      tooltip.style.top = (ev.clientY - r.top - 10) + 'px';
    })
    .on('mouseout', function() {
      d3.select(this).attr('stroke', '#fff').attr('stroke-width', 2);
      tooltip.style.opacity = 0;
    })
    .transition()
    .duration(500)
    .delay((d,i) => i * 80)
    .ease(d3.easeElasticOut)
    .attr('r', d => d.r);

  g.selectAll('text.cn-label')
    .data(nodes)
    .enter().append('text')
    .attr('class', 'cn-label')
    .attr('x', d => d.x)
    .attr('y', d => d.y)
    .attr('text-anchor', 'middle')
    .attr('dy', '0.35em')
    .attr('font-size', d => Math.min(d.r * 0.3, 13))
    .attr('font-weight', '600')
    .attr('fill', '#222')
    .text(d => d.data.label);

  // Update legend
  const legend = document.getElementById('continent-legend');
  legend.innerHTML = `<span style="font-weight:600;color:var(--primary)">${cont ? cont.label : id}</span> — Top countries by airport count`;
}

function resetContinentView() {
  currentView = 'continents';
  document.getElementById('continent-back').style.display = 'none';
  document.getElementById('continent-tooltip').style.opacity = 0;
  drawContinentBubbles();
}

