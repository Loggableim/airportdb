</section>

<!-- DISTANCE -->
<section class="section" style="background:var(--light)">
  <div class="wrap">
    <h2 class="section-title">Airport Distance Calculator</h2>
    <p class="section-desc">Calculate the great-circle distance between any two airports.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:500px;margin-bottom:16px">
      <div><label style="display:block;font-size:12px;font-weight:600;color:var(--slate);margin-bottom:4px">From</label><select id="dist-from" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:6px;font-family:inherit"></select></div>
      <div><label style="display:block;font-size:12px;font-weight:600;color:var(--slate);margin-bottom:4px">To</label><select id="dist-to" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:6px;font-family:inherit"></select></div>
    </div>
    <button onclick="calcDistance()" style="padding:12px 32px;background:var(--primary);color:#fff;font-size:15px;font-weight:600;border:none;border-radius:6px;cursor:pointer;font-family:inherit">Calculate Distance</button>
    <div id="dist-result" style="display:none;margin-top:16px;padding:20px;background:var(--white);border:1px solid var(--border);border-radius:8px">
      <div id="route-info" style="text-align:center;font-size:14px;margin-bottom:12px"></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:center">
        <div><div id="dist-km" style="font-size:28px;font-weight:700;color:var(--primary)">0</div><div style="font-size:11px;color:var(--gray);text-transform:uppercase">Kilometers</div></div>
        <div><div id="dist-mi" style="font-size:28px;font-weight:700;color:var(--primary)">0</div><div style="font-size:11px;color:var(--gray);text-transform:uppercase">Miles</div></div>
      </div>
      <p style="text-align:center;font-size:12px;color:var(--gray);margin-top:12px">Calculated using the Haversine formula</p>
    </div>
  </div>
</section>

<!-- PROMO -->
<section class="section" style="text-align:center">
  <div class="wrap" style="max-width:600px">
    <h2 class="section-title">Get the Complete Database</h2>
    <p class="section-desc">85,545 airports with IATA/ICAO codes, coordinates, elevation, type, and country data. CSV, JSON, or SQL format. Instant download.</p>
    <div style="margin:20px 0;font-size:32px;font-weight:800;color:var(--navy)">$29.99</div>
    <div style="color:var(--gray);font-size:13px">One-time purchase · Regular updates · Commercial use allowed</div>
  </div>
</section>

