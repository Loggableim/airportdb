---
import countries from '../_data/countries.js';
import continents from '../_data/continents.json' assert { type: 'json' };
import blogPosts from '../data/blog-posts.js';
import { blogCategories } from '../data/blog-categories.js';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Use IATA-airport counts (sum across all countries)
const totalIataAirports = countries.reduce((s,c) => s + c.iata, 0);
const totalCountries = countries.length;
const totalAllAirports = countries.reduce((s,c) => s + c.total, 0);
const topCountries = [...countries].sort((a,b) => b.iata - a.iata).slice(0, 12);

// Continent order for display
const continentOrder = ['NA', 'SA', 'EU', 'AS', 'AF', 'OC', 'AN'];
const continentList = continentOrder.map(id => continents[id]).filter(Boolean);

// Get latest 4 blog posts for preview
const recentPosts = [...blogPosts].sort((a,b) => new Date(b.date) - new Date(a.date)).slice(0, 4);

// Most popular airports (by score s in airports-light)
const airportsLite = await import('../../public/data/airports-light.json', { assert: { type: 'json' } }).then(m => m.default);
const popularAirports = airportsLite
  .filter(a => a.i && a.s > 0)
  .sort((a,b) => (b.s||0) - (a.s||0))
  .slice(0, 10);

// Compute type counts from all countries (large/medium/small)
const totalLarge = countries.reduce((s,c) => s + (c.large||0), 0);
const totalMedium = countries.reduce((s,c) => s + (c.medium||0), 0);
const totalSmall = countries.reduce((s,c) => s + (c.small||0), 0);

// Tools definition
const tools = [
  { href: '/tools/distance-calculator/', icon: '📏', title: 'Distance Calculator', desc: 'Great-circle distance between any two airports with map, flight time & CO₂.' },
  { href: '/tools/iata-icao-lookup/', icon: '🔍', title: 'IATA/ICAO Lookup', desc: 'Search and convert codes across all 9,056 airports worldwide.' },
  { href: '/tools/nearest-airport/', icon: '📍', title: 'Nearest Airport', desc: 'Find the closest airports to any location with GPS support.' },
  { href: '/tools/timezone-lookup/', icon: '🕐', title: 'Timezone Lookup', desc: 'Live local time, IANA timezone & DST for any airport.' },
  { href: '/tools/airport-map/', icon: '🗺️', title: 'Airport Map', desc: 'Browse all airports on an interactive world map.' },
];

const pageTitle = `World Airport Database — ${totalIataAirports.toLocaleString()} IATA Airports, ${totalCountries} Countries`;
const pageDesc = `The most comprehensive open airport database. ${totalIataAirports.toLocaleString()} airports with IATA codes across ${totalCountries} countries. Search codes, explore airport profiles, and use travel tools.`;
const pageUrl = 'https://world-airport-database.com/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={pageUrl}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content="https://world-airport-database.com/logo-icon.svg">
  <meta property="og:site_name" content="World Airport Database">
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"WebSite","name":"World Airport Database","url":"https://world-airport-database.com/",
    "potentialAction":{"@type":"SearchAction","target":"https://world-airport-database.com/search?q={search_term_string}","query-input":"required name=search_term_string"},
    "publisher":{"@type":"Organization","name":"World Airport Database","url":"https://world-airport-database.com/"},
    "inLanguage":"en"
  })}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',Arial,sans-serif;background:#fff;color:#1a1a2e;line-height:1.6;-webkit-font-smoothing:antialiased}
    a{color:#2563eb;text-decoration:none}a:hover{text-decoration:underline}
    img{max-width:100%}

    :root{--primary:#2ca4dc;--primary-dark:#1d4ed8;--navy:#0B1D3A;--slate:#334155;--gray:#64748b;--light:#f1f5f9;--border:#e2e8f0;--white:#fff;--green:#22c55e}

    .wrap{max-width:1280px;margin:0 auto;padding:0 20px}

    /* Hero */
    .hero{background:linear-gradient(160deg,#0B1D3A 0%,#1e3a5f 50%,#1a1a2e 100%);padding:64px 0 72px;color:#fff;position:relative;overflow:hidden}
    .hero::before{content:'';position:absolute;top:0;right:0;width:600px;height:600px;background:radial-gradient(circle,rgba(44,164,220,.15) 0%,transparent 70%);pointer-events:none}
    .hero-content{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center;position:relative;z-index:1}
    .hero h1{font-size:46px;font-weight:900;letter-spacing:-1.4px;margin-bottom:14px;line-height:1.1}
    .hero h1 .accent{color:#60a5fa}
    .hero .sub{color:rgba(255,255,255,.75);font-size:17px;margin-bottom:28px;max-width:620px;line-height:1.55}
    .hero-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:640px}
    .hero-stat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:16px 12px;text-align:center;backdrop-filter:blur(4px)}
    .hero-stat .num{font-size:24px;font-weight:800;color:#60a5fa;display:block;line-height:1.2;letter-spacing:-.5px}
    .hero-stat .lbl{font-size:10px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:1px;margin-top:4px;font-weight:600}
    .hero-art{text-align:center}
    .hero-art img{width:240px;height:auto;filter:drop-shadow(0 8px 24px rgba(44,164,220,.3))}
    @media(max-width:768px){
      .hero-content{grid-template-columns:1fr;text-align:center}
      .hero h1{font-size:32px}
      .hero-stats{grid-template-columns:repeat(2,1fr);margin:0 auto}
      .hero-art{display:none}
    }

    /* Quick search */
    .search-card{background:var(--white);border-radius:14px;padding:24px;margin:-40px auto 0;max-width:1240px;box-shadow:0 12px 40px rgba(0,0,0,.1);position:relative;z-index:2;border:1px solid var(--border)}
    .search-card h2{font-size:14px;color:var(--slate);margin-bottom:14px;text-transform:uppercase;letter-spacing:1px;font-weight:700}
    .search-row{display:grid;grid-template-columns:1fr auto auto;gap:10px;margin-bottom:12px}
    .search-row input{padding:14px 16px;font-size:15px;border:2px solid var(--border);border-radius:8px;outline:none;font-family:inherit;width:100%}
    .search-row input:focus{border-color:var(--primary)}
    .search-row select{padding:14px 14px;font-size:14px;border:2px solid var(--border);border-radius:8px;background:#fff;font-family:inherit;cursor:pointer;min-width:140px}
    .search-row button{padding:14px 28px;background:var(--primary);color:#fff;font-size:15px;font-weight:700;border:none;border-radius:8px;cursor:pointer;font-family:inherit;transition:background .15s;white-space:nowrap}
    .search-row button:hover{background:#2390c2}
    .search-results{max-height:400px;overflow-y:auto;margin-top:12px;display:none;border:1px solid var(--border);border-radius:8px}
    .search-results table{width:100%;border-collapse:collapse}
    .search-results th{background:var(--light);color:var(--slate);padding:8px 12px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;position:sticky;top:0;z-index:1}
    .search-results td{padding:8px 12px;border-bottom:1px solid var(--border);font-size:13px}
    .search-results tr:hover td{background:#f8fafc;cursor:pointer}
    @media(max-width:640px){.search-row{grid-template-columns:1fr}.search-row button{width:100%}}

    /* Sections */
    .section{padding:64px 0}
    .section+.section{border-top:1px solid var(--border)}
    .section-alt{background:#f8fafc}
    .section-title{font-size:30px;font-weight:800;color:var(--navy);margin-bottom:6px;letter-spacing:-.6px}
    .section-title .accent{color:var(--primary)}
    .section-desc{font-size:15px;color:var(--gray);margin-bottom:28px;max-width:640px}
    .section-header{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px}
    .section-header .section-title{margin-bottom:0}
    .section-header a{font-size:14px;color:var(--primary);font-weight:600}

    /* Tools grid */
    .tools-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:8px}
    .tool-card{background:#fff;border:2px solid var(--border);border-radius:12px;padding:22px;text-decoration:none;color:inherit;transition:all .2s;display:block;position:relative;overflow:hidden}
    .tool-card:hover{border-color:var(--primary);text-decoration:none;transform:translateY(-2px);box-shadow:0 8px 24px rgba(44,164,220,.12)}
    .tool-card .icon{font-size:32px;display:block;margin-bottom:10px}
    .tool-card h3{font-size:16px;color:var(--navy);margin-bottom:6px;font-weight:700}
    .tool-card p{font-size:13px;color:var(--gray);line-height:1.5}

    /* Continent table */
    .cont-table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.04)}
    .cont-table th{background:var(--navy);color:#fff;padding:14px 18px;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.5px;font-weight:600}
    .cont-table th.num{text-align:right}
    .cont-table td{padding:14px 18px;border-bottom:1px solid var(--border);font-size:14px}
    .cont-table td.num{text-align:right;font-weight:700;color:var(--navy)}
    .cont-table td a{color:var(--navy);font-weight:600}
    .cont-table .bar{height:10px;border-radius:5px;min-width:8px}
    .cont-table tr:last-child td{border-bottom:none}
    .cont-table tr:hover td{background:#f8fafc}

    /* Type breakdown */
    .type-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
    .type-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:18px;text-align:center}
    .type-card .num{font-size:28px;font-weight:800;color:var(--primary);display:block}
    .type-card .lbl{font-size:12px;color:var(--gray);text-transform:uppercase;letter-spacing:.5px;margin-top:4px;font-weight:600}
    .type-card .sub{font-size:11px;color:#94a3b8;margin-top:2px}

    /* Country grid */
    .country-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
    .country-card{display:flex;align-items:center;gap:14px;padding:16px 18px;background:#fff;border:1px solid var(--border);border-radius:10px;color:var(--navy);text-decoration:none;transition:all .15s}
    .country-card:hover{border-color:var(--primary);text-decoration:none;box-shadow:0 4px 14px rgba(44,164,220,.1);transform:translateY(-1px)}
    .country-card .emoji{font-size:28px;line-height:1}
    .country-card .name{font-size:14px;font-weight:700}
    .country-card .count{font-size:11px;color:var(--gray);margin-top:2px}

    /* Popular airports */
    .airport-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
    .airport-chip{display:flex;align-items:center;gap:8px;padding:10px 14px;background:#fff;border:1px solid var(--border);border-radius:8px;text-decoration:none;color:var(--navy);transition:all .15s}
    .airport-chip:hover{border-color:var(--primary);text-decoration:none;background:#f8fafc}
    .airport-chip .code{background:var(--primary);color:#fff;padding:2px 8px;border-radius:3px;font-size:11px;font-weight:700;letter-spacing:.5px;font-family:'SF Mono',monospace}
    .airport-chip .name{font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

    /* Database promo */
    .db-promo{background:linear-gradient(135deg,#0B1D3A 0%,#142b4f 100%);color:#fff;border-radius:16px;padding:40px;text-align:center;position:relative;overflow:hidden}
    .db-promo::before{content:'';position:absolute;top:-100px;right:-100px;width:300px;height:300px;background:radial-gradient(circle,rgba(44,164,220,.2) 0%,transparent 70%);pointer-events:none}
    .db-promo h2{color:#fff;font-size:28px;margin-bottom:8px;position:relative;z-index:1}
    .db-promo p{color:rgba(255,255,255,.7);font-size:15px;margin-bottom:24px;position:relative;z-index:1;max-width:520px;margin-left:auto;margin-right:auto}
    .db-promo-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;position:relative;z-index:1}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:8px;font-size:14px;font-weight:700;text-decoration:none;cursor:pointer;border:none;font-family:inherit;transition:all .15s}
    .btn-primary{background:var(--primary);color:#fff}
    .btn-primary:hover{background:#2390c2;text-decoration:none;transform:translateY(-1px)}
    .btn-green{background:var(--green);color:#fff}
    .btn-green:hover{background:#16a34a;text-decoration:none;transform:translateY(-1px)}
    .btn-outline{background:transparent;color:var(--primary);border:2px solid var(--primary)}
    .btn-outline:hover{background:var(--primary);color:#fff;text-decoration:none}

    /* Blog teaser */
    .blog-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:8px}
    .blog-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:20px;text-decoration:none;color:inherit;display:block;transition:all .15s}
    .blog-card:hover{border-color:var(--primary);text-decoration:none;box-shadow:0 4px 14px rgba(44,164,220,.1)}
    .blog-card .cat{font-size:11px;color:var(--primary);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-bottom:6px}
    .blog-card h3{font-size:16px;color:var(--navy);margin-bottom:6px;font-weight:700;line-height:1.3}
    .blog-card .excerpt{font-size:13px;color:var(--gray);line-height:1.5;margin-bottom:10px}
    .blog-card .date{font-size:11px;color:#94a3b8}

    /* Categories cloud */
    .cat-cloud{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:8px}
    .cat-cloud-item{padding:18px 20px;background:#fff;border:1px solid var(--border);border-radius:10px;text-decoration:none;color:var(--navy);transition:all .15s}
    .cat-cloud-item:hover{border-color:var(--primary);text-decoration:none;transform:translateY(-1px);box-shadow:0 4px 12px rgba(44,164,220,.08)}
    .cat-cloud-item .cat-icon{font-size:24px;margin-bottom:6px;display:block}
    .cat-cloud-item h3{font-size:14px;font-weight:700;margin-bottom:3px}
    .cat-cloud-item .meta{font-size:11px;color:var(--gray)}

    @media(max-width:768px){
      .section{padding:40px 0}
      .section-title{font-size:24px}
    }
  </style>
</head>
<body>

<SiteNav active="home" />

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div class="hero-content">
      <div>
        <h1>The World's Most Comprehensive <span class="accent">Airport Database</span></h1>
        <p class="sub">{totalIataAirports.toLocaleString()} IATA-coded airports across {totalCountries} countries. Open data, free download, professional travel tools, and detailed airport profiles with maps, timezones, and live data.</p>
        <div class="hero-stats">
          <div class="hero-stat"><span class="num">{totalIataAirports.toLocaleString()}</span><span class="lbl">IATA Airports</span></div>
          <div class="hero-stat"><span class="num">{totalCountries}</span><span class="lbl">Countries</span></div>
          <div class="hero-stat"><span class="num">{continentList.length}</span><span class="lbl">Continents</span></div>
          <div class="hero-stat"><span class="num">{totalLarge.toLocaleString()}</span><span class="lbl">Large Airports</span></div>
        </div>
      </div>
      <div class="hero-art">
        <img src="/logo-icon.svg" alt="World Airport Database Globe" width="240" height="240">
      </div>
    </div>
  </div>
</section>

<!-- QUICK SEARCH -->
<div class="wrap">
  <div class="search-card">
    <h2>🔍 Quick Airport Search</h2>
    <div class="search-row">
      <input type="text" id="qsearch" placeholder="Search by name, IATA, ICAO, city, or country..." aria-label="Airport search" oninput="runSearch()" onkeydown="if(event.key==='Enter'){event.preventDefault();}">
      <select id="qcont" onchange="runSearch()" aria-label="Filter by continent">
        <option value="">All Continents</option>
        <option value="NA">North America</option>
        <option value="SA">South America</option>
        <option value="EU">Europe</option>
        <option value="AS">Asia</option>
        <option value="AF">Africa</option>
        <option value="OC">Oceania</option>
        <option value="AN">Antarctica</option>
      </select>
      <button onclick="runSearch()" type="button">Search</button>
    </div>
    <div class="search-results" id="sresults">
      <table>
        <thead><tr><th>IATA</th><th>ICAO</th><th>Name</th><th>City</th><th>Country</th><th>Type</th></tr></thead>
        <tbody id="sresults-tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- POPULAR AIRPORTS -->
<section class="section">
  <div class="wrap">
    <div class="section-header">
      <h2 class="section-title">Popular <span class="accent">Airports</span></h2>
      <a href="/countries/">All countries →</a>
    </div>
    <p class="section-desc">The world's most-trafficked airports. Click any to see the full airport profile, nearby airports, and live tools.</p>
    <div class="airport-strip">
      {popularAirports.map(a => (
        <a href={`/airports/${(a.c||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-')}/${(a.n||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').slice(0,60)}-${a.i.toLowerCase()}/`} class="airport-chip">
          <span class="code">{a.i}</span>
          <span class="name">{a.n}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- TOOLS -->
<section class="section section-alt">
  <div class="wrap">
    <div class="section-header">
      <h2 class="section-title">Powerful <span class="accent">Travel Tools</span></h2>
      <a href="/tools/">All tools →</a>
    </div>
    <p class="section-desc">Everything you need to plan air travel. Built on real airport data with live maps, GPS support, and timezone intelligence.</p>
    <div class="tools-grid">
      {tools.map(t => (
        <a href={t.href} class="tool-card">
          <span class="icon">{t.icon}</span>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CONTINENTS -->
<section class="section">
  <div class="wrap">
    <h2 class="section-title">Airports by <span class="accent">Continent</span></h2>
    <p class="section-desc">Distribution of IATA-coded airports across the world's seven continents.</p>
    <table class="cont-table">
      <thead>
        <tr>
          <th>Continent</th>
          <th class="num">Airports</th>
          <th class="num">Share</th>
          <th>Distribution</th>
        </tr>
      </thead>
      <tbody>
        {continentList.map(c => {
          const maxTotal = Math.max(...continentList.map(x => x.total));
          const width = (c.total / maxTotal * 100).toFixed(1);
          const colors = {NA:'#2563eb',SA:'#6CB4EE',EU:'#E9C46A',AS:'#F4A261',AF:'#E76F51',OC:'#2A9D8F',AN:'#94a3b8'};
          return (
            <tr>
              <td><a href={`/countries/`}>{c.name}</a></td>
              <td class="num">{c.total.toLocaleString()}</td>
              <td class="num">{((c.total/totalIataAirports)*100).toFixed(1)}%</td>
              <td><div class="bar" style={`width:${width}%;background:${colors[c.id] || '#94a3b8'}`}></div></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>

<!-- TYPES + COUNTRIES -->
<section class="section section-alt">
  <div class="wrap">
    <h2 class="section-title">Airport <span class="accent">Size Categories</span></h2>
    <p class="section-desc">Airports classified by size based on traffic, infrastructure, and operational capacity.</p>
    <div class="type-grid">
      <div class="type-card">
        <span class="num">{totalLarge.toLocaleString()}</span>
        <span class="lbl">Large</span>
        <span class="sub">International hubs</span>
      </div>
      <div class="type-card">
        <span class="num">{totalMedium.toLocaleString()}</span>
        <span class="lbl">Medium</span>
        <span class="sub">Regional airports</span>
      </div>
      <div class="type-card">
        <span class="num">{totalSmall.toLocaleString()}</span>
        <span class="lbl">Small</span>
        <span class="sub">Domestic & GA</span>
      </div>
      <div class="type-card">
        <span class="num">{totalIataAirports.toLocaleString()}</span>
        <span class="lbl">Total IATA</span>
        <span class="sub">Worldwide</span>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-header">
      <h2 class="section-title">Top <span class="accent">Countries</span> by Airports</h2>
      <a href="/countries/">View all {totalCountries} →</a>
    </div>
    <p class="section-desc">The countries with the most IATA-coded airports. Click any country to explore its full profile.</p>
    <div class="country-grid">
      {topCountries.map(c => (
        <a href={`/countries/${c.slug}/`} class="country-card">
          <span class="emoji">🛫</span>
          <div>
            <div class="name">{c.name}</div>
            <div class="count">{c.iata.toLocaleString()} IATA · {c.total.toLocaleString()} airports</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- DATABASE -->
<section class="section section-alt">
  <div class="wrap">
    <div class="db-promo">
      <h2>📦 Download the Complete Database</h2>
      <p>{totalIataAirports.toLocaleString()} airports with IATA/ICAO codes, coordinates, elevation, type, and country data. CSV, JSON, and SQL formats. Free for personal and commercial use.</p>
      <div class="db-promo-btns">
        <a href="/download/" class="btn btn-green">⬇ Free Download</a>
        <a href="/data/world-airports.csv" class="btn btn-primary" download>📄 CSV</a>
        <a href="/data/airports.json" class="btn btn-primary" download>📋 JSON</a>
        <a href="/data/world-airports.sql" class="btn btn-primary" download>🗄️ SQL</a>
        <a href="/download/" class="btn btn-outline">💝 Donate</a>
      </div>
    </div>
  </div>
</section>

<!-- BLOG TEASER -->
<section class="section">
  <div class="wrap">
    <div class="section-header">
      <h2 class="section-title">Latest from the <span class="accent">Blog</span></h2>
      <a href="/blog/">View all {blogPosts.length} posts →</a>
    </div>
    <p class="section-desc">Airport guides, IATA code insights, travel tips, and aviation news.</p>
    <div class="blog-grid">
      {recentPosts.map(p => (
        <a href={`/blog/${p.slug}/`} class="blog-card">
          <div class="cat">{p.category.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</div>
          <h3>{p.title}</h3>
          <div class="excerpt">{p.excerpt}</div>
          <div class="date">{new Date(p.date).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'})}</div>
