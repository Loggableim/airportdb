// ══════════════════════════════════════════════════════════════
// ║  DISTANCE CALCULATOR                                     ║
// ══════════════════════════════════════════════════════════════
(function initDistance() {
  const fromSel = document.getElementById('dist-from');
  const toSel = document.getElementById('dist-to');
  AIRPORTS.forEach(a => {
    const opt1 = document.createElement('option');
    opt1.value = a.iata; opt1.textContent = `${a.iata} — ${a.name}, ${a.country}`;
    fromSel.appendChild(opt1);
    const opt2 = opt1.cloneNode(true);
    toSel.appendChild(opt2);
  });
  fromSel.value = 'FRA';
  toSel.value = 'JFK';
})();

function toRad(deg) { return deg * Math.PI / 180; }

function calcDistance() {
  const fromIATA = document.getElementById('dist-from').value;
  const toIATA = document.getElementById('dist-to').value;
  const from = AIRPORTS.find(a => a.iata === fromIATA);
  const to = AIRPORTS.find(a => a.iata === toIATA);
  if (!from || !to) return;

  const R = 6371;
  const dLat = toRad(to.lat - from.lat);
  const dLon = toRad(to.lon - from.lon);
  const a = Math.sin(dLat/2)**2 + Math.cos(toRad(from.lat)) * Math.cos(toRad(to.lat)) * Math.sin(dLon/2)**2;
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  const km = Math.round(R * c);
  const mi = Math.round(km * 0.621371);

  document.getElementById('dist-km').textContent = km.toLocaleString();
  document.getElementById('dist-mi').textContent = mi.toLocaleString();
  document.getElementById('route-info').innerHTML = `<strong>${from.name} (${from.iata})</strong> &#9992; <strong>${to.name} (${to.iata})</strong>`;
  document.getElementById('dist-result').classList.add('visible');

  drawGlobeArc(from.lat, from.lon, to.lat, to.lon);
}

function drawGlobeArc(lat1, lon1, lat2, lon2) {
  const svg = document.getElementById('globe-svg');
  const cx = 0, cy = 0, r = 100;
  let html = '';

  function toSphere(lat, lon) {
    const phi = toRad(90 - lat);
    const theta = toRad(lon);
    return { x: r * Math.sin(phi) * Math.cos(theta), y: -r * Math.cos(phi), visible: phi < Math.PI/2 };
  }

  // Globe
  html += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#e8f0f8" stroke="#b0c4d8" stroke-width="1.5"/>`;
  // Continents (simplified)
  [[0,50,-40,100],[30,20,-20,60],[-30,-60,-80,-30],[40,-120,-50,-70],[50,120,20,150]].forEach(b => {
    html += `<ellipse cx="${b[2]}" cy="${b[0]}" rx="${(b[3]-b[2])*0.2}" ry="${(b[1]-b[0])*0.15}" fill="#c8d8e8" opacity="0.4"/>`;
  });

  // Arc
  const steps = 40;
  const pts = [];
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const lat = lat1 + (lat2 - lat1) * t;
    const lon = lon1 + (lon2 - lon1) * t;
    const p = toSphere(lat, lon);
    pts.push(p);
  }
  let path = pts.map((p,i) => `${i===0?'M':'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
  html += `<path d="${path}" fill="none" stroke="#e76f51" stroke-width="2" stroke-dasharray="4,3" opacity="0.8"/>`;

  // Endpoints
  const p1 = toSphere(lat1, lon1);
  const p2 = toSphere(lat2, lon2);
  html += `<circle cx="${p1.x.toFixed(1)}" cy="${p1.y.toFixed(1)}" r="3" fill="#2ca4dc" stroke="#fff" stroke-width="1"/>`;
  html += `<circle cx="${p2.x.toFixed(1)}" cy="${p2.y.toFixed(1)}" r="3" fill="#e76f51" stroke="#fff" stroke-width="1"/>`;

  svg.innerHTML = html;
}

// ══════════════════════════════════════════════════════════════
// ║  TYPE BREAKDOWN (D3)                                     ║
// ══════════════════════════════════════════════════════════════
const TYPE_DATA = [
  {id:"large_airport",label:"Large",color:"#2C7BE5"},
  {id:"medium_airport",label:"Medium",color:"#F4A261"},
  {id:"small_airport",label:"Small",color:"#E9C46A"},
  {id:"heliport",label:"Heliport",color:"#6CB4EE"},
  {id:"seaplane_base",label:"Seaplane",color:"#2A9D8F"},
  {id:"closed",label:"Closed",color:"#E76F51"},
  {id:"balloonport",label:"Balloonport",color:"#D4E8F7"}
];

function drawTypeChart() {
  const cont = document.getElementById('type-filter-cont').value;
  const size = document.getElementById('type-filter-size').value;
  const wrap = document.getElementById('type-chart');
  const w = wrap.clientWidth - 40;
  const h = 360;
  if (w < 100) { setTimeout(drawTypeChart, 200); return; }

  let data = TYPE_DATA.map(t => {
    let count = 0;
    AIRPORTS.forEach(a => {
      if (cont && a.cont !== cont) return;
      if (a.type === t.id) count++;
    });
    if (size === 'LARGE' && !['large_airport'].includes(t.id)) count = 0;
    else if (size === 'MEDIUM' && !['medium_airport'].includes(t.id)) count = 0;
    else if (size === 'SMALL' && !['small_airport','heliport','seaplane_base','balloonport'].includes(t.id)) count = 0;
    else if (size === 'CLOSED' && t.id !== 'closed') count = 0;
    return { ...t, count };
  }).filter(d => d.count > 0);

  if (data.length === 0) data = [{id:"none",label:"No data",color:"#ccc",count:1}];

  d3.select(wrap).selectAll('svg').remove();

  const svg = d3.select(wrap).append('svg')
    .attr('width', w)
    .attr('height', h);

  const tooltip = document.getElementById('type-tooltip');

  const x = d3.scaleBand()
    .domain(data.map(d => d.label))
    .range([0, w - 60])
    .padding(0.3);

  const y = d3.scaleLinear()
    .domain([0, d3.max(data, d => d.count) * 1.15 || 1])
    .range([h - 60, 20]);

  const g = svg.append('g').attr('transform', `translate(30,10)`);

  // Bars
  g.selectAll('rect')
    .data(data)
    .enter().append('rect')
    .attr('x', d => x(d.label))
    .attr('y', h - 60)
    .attr('width', x.bandwidth())
    .attr('height', 0)
    .attr('fill', d => d.color)
    .attr('rx', 3)
    .style('cursor', 'pointer')
    .on('mouseover', function(ev, d) {
      d3.select(this).attr('opacity', 0.8);
      tooltip.style.opacity = 1;
      tooltip.innerHTML = `<strong>${d.label}</strong><br>Count: ${d.count}`;
    })
    .on('mousemove', function(ev) {
      const r = wrap.getBoundingClientRect();
      tooltip.style.left = (ev.clientX - r.left + 15) + 'px';
      tooltip.style.top = (ev.clientY - r.top - 10) + 'px';
    })
    .on('mouseout', function() {
      d3.select(this).attr('opacity', 1);
      tooltip.style.opacity = 0;
    })
    .transition()
    .duration(500)
    .delay((d,i) => i * 80)
    .attr('y', d => y(d.count))
    .attr('height', d => h - 60 - y(d.count));

  // Labels
  g.selectAll('text.xl')
    .data(data)
    .enter().append('text')
    .attr('x', d => x(d.label) + x.bandwidth() / 2)
    .attr('y', h - 40)
    .attr('text-anchor', 'middle')
    .attr('font-size', 11)
    .attr('fill', '#5A6B7F')
    .text(d => d.label);

  // Count
  g.selectAll('text.yl')
    .data(data)
    .enter().append('text')
    .attr('x', d => x(d.label) + x.bandwidth() / 2)
    .attr('y', d => y(d.count) - 8)
    .attr('text-anchor', 'middle')
    .attr('font-size', 12)
    .attr('font-weight', '700')
    .attr('fill', '#202c39')
    .text(d => d.count);
}

drawTypeChart();

