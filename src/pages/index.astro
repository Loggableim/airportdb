function filterSearch() {
  const q = document.getElementById('iata-search-input').value.toLowerCase().trim();
  const cont = document.getElementById('filter-continent').value;
  const type = document.getElementById('filter-type').value;
  const cntr = document.getElementById('filter-country').value;
  const tbody = document.getElementById('search-tbody');
  tbody.innerHTML = '';
  let count = 0;
  AIRPORTS.forEach(a => {
    if (cont && a.cont !== cont) return;
    if (type && a.type !== type) return;
    if (cntr && a.country !== cntr) return;
    if (q && !a.iata.toLowerCase().includes(q) && !a.icao.toLowerCase().includes(q) &&
        !a.name.toLowerCase().includes(q) && !a.city.toLowerCase().includes(q)) return;
    if (count >= 200) return;
    count++;
    const tr = document.createElement('tr');
    const link = `/airports/${(a.country||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'')||'unknown'}/${a.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'').slice(0,60)}-${a.iata.toLowerCase()}/`;
    tr.innerHTML = `<td><a href="${link}" class="iata-badge" style="background:var(--primary)">${a.iata}</a></td><td>${a.icao}</td><td><a href="${link}">${a.name}</a></td><td>${a.city}</td><td>${a.country}</td><td>${a.type}</td>`;
    tbody.appendChild(tr);
  });
  if (count === 0) {
    const tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="6" style="text-align:center;padding:30px;color:#889">No airports match your search. Try different filters.</td>';
    tbody.appendChild(tr);
  }
}

function clearSearch() {
  document.getElementById('iata-search-input').value = '';
  document.getElementById('filter-continent').value = '';
  document.getElementById('filter-type').value = '';
  document.getElementById('filter-country').value = '';
  filterSearch();
}

// Initial load
filterSearch();

