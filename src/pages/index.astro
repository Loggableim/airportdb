// ── SCROLL ANIMATIONS ──
function initScroll() {
  const obs = new IntersectionObserver(e=>{e.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');entry.target.querySelectorAll('[data-count]').forEach(el=>{const t=parseInt(el.getAttribute('data-count'));if(t&&!el.dataset.animated){el.dataset.animated='1';const d=2000,s=performance.now();(function step(n){const p=Math.min((n-s)/d,1),e=1-Math.pow(1-p,3);el.textContent=Math.floor(e*t).toLocaleString();if(p<1)requestAnimationFrame(step);else el.textContent=t.toLocaleString()})(s)}})}})},{threshold:.2});
  document.querySelectorAll('.fade-in,.slide-up,.scale-in,.stagger').forEach(e=>obs.observe(e));
  // Hero count-ups
  document.querySelectorAll('.hero-stat .num').forEach(el=>{const t=parseInt(el.getAttribute('data-count'));if(t){setTimeout(()=>{const d=1500,s=performance.now();(function step(n){const p=Math.min((n-s)/d,1),e=1-Math.pow(1-p,3);el.textContent=Math.floor(e*t).toLocaleString();if(p<1)requestAnimationFrame(step)})(s)},300)}});
}

// ── SEARCH ──
function populateCountryFilter() {
  const s=document.getElementById('filter-country'),countries=[...new Set(uniAirports.map(a=>a.country))].sort();
  countries.forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;s.appendChild(o)});
}
function filterSearch(){
  const q=document.getElementById('iata-search-input').value.toLowerCase().trim();
  const fc=document.getElementById('filter-continent').value;
  const ft=document.getElementById('filter-type').value;
  const fco=document.getElementById('filter-country').value;
  let list=uniAirports;
  if(fc)list=list.filter(a=>a.cont===fc);
  if(ft)list=list.filter(a=>a.type===ft);
  if(fco)list=list.filter(a=>a.country===fco);
  if(q)list=list.filter(a=>a.iata.toLowerCase().includes(q)||a.icao.toLowerCase().includes(q)||a.name.toLowerCase().includes(q)||a.city.toLowerCase().includes(q)||a.country.toLowerCase().includes(q));
  renderSearch(list);
}
function clearSearch(){document.getElementById('iata-search-input').value='';document.getElementById('filter-continent').value='';document.getElementById('filter-type').value='';document.getElementById('filter-country').value='';filterSearch()}
function renderSearch(list){
  const tbody=document.getElementById('search-tbody');tbody.innerHTML='';
  list.slice(0,100).forEach(ap=>{
    const tr=document.createElement('tr');
    tr.innerHTML=`<td><span class="iata-badge">${ap.iata}</span></td><td>${ap.icao}</td><td>${ap.name}</td><td>${ap.city}</td><td>${ap.country}</td><td>${ap.type.replace(/_/g,' ')}</td>`;
    tbody.appendChild(tr);
  });
}

// ── MAP ──
let map=null,lightLayer=null,darkLayer=null;
function initMap(){
  map=L.map('fra-map',{zoomControl:true}).setView([50.033,8.561],8);
  lightLayer=L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',{attribution:'&copy; <a href="https://carto.com/">CARTO</a>',maxZoom:19}).addTo(map);
  darkLayer=L.tileLayer('https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png',{attribution:'&copy; <a href="https://stadiamaps.com/">Stadia Maps</a>',maxZoom:19});
  L.marker([50.033,8.561]).addTo(map).bindPopup('<b>Frankfurt Airport (FRA)</b><br>EDDF').openPopup();
  // Nearby markers
  [[48.353,11.786,'MUC'],[50.865,7.142,'CGN'],[48.689,9.221,'STR'],[49.498,11.078,'NUE'],[49.948,7.263,'HHN']].forEach(m=>{L.circleMarker([m[0],m[1]],{radius:6,color:'#F4A261',fillColor:'#E9C46A',fillOpacity:.8}).addTo(map).bindPopup(`<b>${m[2]}</b>`)});
}
function switchMapStyle(style){
  if(style==='dark'){map.removeLayer(lightLayer);map.addLayer(darkLayer);document.getElementById('map-light-btn').classList.remove('active');document.getElementById('map-dark-btn').classList.add('active')}
  else{map.removeLayer(darkLayer);map.addLayer(lightLayer);document.getElementById('map-dark-btn').classList.remove('active');document.getElementById('map-light-btn').classList.add('active')}
}

// ── COUNTRY GRID ──
function renderCountries(){
  const g=document.getElementById('country-grid');
  COUNTRY_DATA.forEach(c=>{const d=document.createElement('div');d.className='country-card';d.innerHTML=`<div class="flag">${c.flag}</div><div class="info"><div class="name">${c.name}</div><div class="count"><strong>${c.airports.toLocaleString()}</strong> airports &middot; <strong>${c.iata}</strong> IATA</div></div>`;g.appendChild(d)});
}

// ── DISTANCE CALC ──
function populateDist(){
  const f=document.getElementById('dist-from'),t=document.getElementById('dist-to');
  uniAirports.forEach(ap=>{const l=`${ap.iata} — ${ap.name}, ${ap.country}`;f.innerHTML+=`<option value="${ap.iata}">${l}</option>`;t.innerHTML+=`<option value="${ap.iata}">${l}</option>`});
  f.value='FRA';t.value='JFK';
}
function haversine(l1,o1,l2,o2){const R=6371,dL=(l2-l1)*Math.PI/180,dO=(o2-o1)*Math.PI/180,a=Math.sin(dL/2)**2+Math.cos(l1*Math.PI/180)*Math.cos(l2*Math.PI/180)*Math.sin(dO/2)**2;return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))}
function calcDistance(){
  const fc=document.getElementById('dist-from').value,tc=document.getElementById('dist-to').value;
  const f=uniAirports.find(a=>a.iata===fc),t=uniAirports.find(a=>a.iata===tc);if(!f||!t)return;
  const km=haversine(f.lat,f.lon,t.lat,t.lon),mi=km*0.621371;
  document.getElementById('dist-km').textContent=Math.round(km).toLocaleString();
  document.getElementById('dist-mi').textContent=Math.round(mi).toLocaleString();
  document.getElementById('route-info').textContent=`${f.name} (${fc}) → ${t.name} (${tc})`;
  document.getElementById('dist-result').classList.add('visible');
  drawGlobe(f,t);
}
function drawGlobe(from,to){
  const svg=document.getElementById('globe-svg');svg.innerHTML='';
  const cx=0,cy=0,R=95;
  // Globe circle
  const g=document.createElementNS('http://www.w3.org/2000/svg','g');
  svg.appendChild(g);
  const circle=document.createElementNS('http://www.w3.org/2000/svg','circle');
  circle.setAttribute('cx',cx);circle.setAttribute('cy',cy);circle.setAttribute('r',R);
  circle.setAttribute('fill','#0B1D3A');circle.setAttribute('stroke','#2ca4dc');circle.setAttribute('stroke-width','2');
  g.appendChild(circle);
  // Grid lines
  for(let i=-2;i<=2;i++){const el=document.createElementNS('http://www.w3.org/2000/svg','ellipse');el.setAttribute('cx',cx);el.setAttribute('cy',cy);el.setAttribute('rx',R);el.setAttribute('ry',Math.abs(R*i/3));el.setAttribute('fill','none');el.setAttribute('stroke','rgba(44,164,220,0.2)');el.setAttribute('stroke-width','.5');g.appendChild(el)}
  for(let i=-2;i<=2;i++){const el=document.createElementNS('http://www.w3.org/2000/svg','ellipse');el.setAttribute('cx',cx);el.setAttribute('cy',cy);el.setAttribute('rx',Math.abs(R*i/3));el.setAttribute('ry',R);el.setAttribute('fill','none');el.setAttribute('stroke','rgba(44,164,220,0.2)');el.setAttribute('stroke-width','.5');g.appendChild(el)}
  // Convert lat/lon to SVG coords (simple orthographic)
  function toXY(lat,lon){const phi=lat*Math.PI/180,lam=lon*Math.PI/180;return{x:R*Math.cos(phi)*Math.sin(lam),y:-R*Math.sin(phi)}}
  const p1=toXY(from.lat,from.lon),p2=toXY(to.lat,to.lon);
  // Start marker (green)
  const m1=document.createElementNS('http://www.w3.org/2000/svg','circle');
  m1.setAttribute('cx',p1.x);m1.setAttribute('cy',p1.y);m1.setAttribute('r',5);
  m1.setAttribute('fill','#2A9D8F');m1.setAttribute('stroke','#fff');m1.setAttribute('stroke-width','2');
  g.appendChild(m1);
  // End marker (red)
  const m2=document.createElementNS('http://www.w3.org/2000/svg','circle');
  m2.setAttribute('cx',p2.x);m2.setAttribute('cy',p2.y);m2.setAttribute('r',5);
  m2.setAttribute('fill','#E76F51');m2.setAttribute('stroke','#fff');m2.setAttribute('stroke-width','2');
  g.appendChild(m2);
  // Great circle arc (intermediate points)
  const steps=50;let d='';const pts=[];
  for(let i=0;i<=steps;i++){
    const f=i/steps;
    const lat=from.lat+(to.lat-from.lat)*f,lon=from.lon+(to.lon-from.lon)*f;
    const p=toXY(lat,lon);pts.push(p);
    d+=i===0?`M${p.x},${p.y}`:`L${p.x},${p.y}`;
  }
  const arc=document.createElementNS('http://www.w3.org/2000/svg','path');
  arc.setAttribute('d',d);arc.setAttribute('fill','none');
  arc.setAttribute('stroke','#F4A261');arc.setAttribute('stroke-width','2');
  arc.setAttribute('stroke-dasharray','6,4');
  g.appendChild(arc);
  // Flying plane along the arc
  let idx=0;
  const plane=document.createElementNS('http://www.w3.org/2000/svg','text');
  plane.setAttribute('font-size','14');plane.setAttribute('text-anchor','middle');
  plane.textContent='✈';
  g.appendChild(plane);
  if(window.__globeInterval)clearInterval(window.__globeInterval);
  window.__globeInterval=setInterval(()=>{
    idx=(idx+1)%pts.length;
    plane.setAttribute('x',pts[idx].x);
    plane.setAttribute('y',pts[idx].y-10);
  },100);
}

// ── D3 BUBBLE CHART ──
let currentContView=null;
function drawBubbles(data,labels){
  const wrap=document.getElementById('continent-chart');wrap.innerHTML='<div class="chart-tooltip" id="continent-tooltip"></div>';
  const w=wrap.clientWidth||900,h=420,m=40,tt=document.getElementById('continent-tooltip');
  const svg=d3.select('#continent-chart').append('svg').attr('width',w).attr('height',h).style('overflow','visible');
  const g=svg.append('g').attr('transform',`translate(${m},${m}`);
  const innerW=w-m*2,innerH=h-m*2;
  // Grid
  g.append('g').selectAll('line').data(d3.range(0,innerW,40)).enter().append('line').attr('x1',d=>d).attr('x2',d=>d).attr('y1',0).attr('y2',innerH).attr('stroke','#e8edf2').attr('stroke-width',1);
  g.append('g').selectAll('line').data(d3.range(0,innerH,40)).enter().append('line').attr('y1',d=>d).attr('y2',d=>d).attr('x1',0).attr('x2',innerW).attr('stroke','#e8edf2').attr('stroke-width',1);
  // Pack
  const pack=d3.pack().size([innerW,innerH]).padding(8);
  const root=d3.hierarchy({children:data.map(d=>({...d,value:d.total}))}).sum(d=>d.value);
  const nodes=pack(root).leaves();
  // Circles
  g.selectAll('circle').data(nodes).enter().append('circle')
    .attr('cx',d=>d.x).attr('cy',d=>d.y).attr('r',0)
    .attr('fill',d=>d.data.color).attr('stroke','#fff').attr('stroke-width',2).attr('opacity',.85)
    .on('mouseover',function(ev,d){d3.select(this).attr('opacity',1).attr('stroke','#333').attr('stroke-width',3);tt.style.opacity=1;tt.innerHTML=`<strong>${d.data.label}</strong><br>Total: ${d.data.total.toLocaleString()}<br>IATA: ${(d.data.iata||0).toLocaleString()}`})
    .on('mousemove',function(ev){tt.style.left=(ev.offsetX+15)+'px';tt.style.top=(ev.offsetY-10)+'px'})
    .on('mouseout',function(){d3.select(this).attr('opacity',.85).attr('stroke','#fff').attr('stroke-width',2);tt.style.opacity=0})
    .on('click',function(ev,d){if(CONT_COUNTRIES[d.data.id])drillContinent(d.data.id)})
    .transition().duration(1200).delay((d,i)=>i*120).ease(d3.easeElasticOut.amplitude(.5)).attr('r',d=>d.r);
  // Labels
  g.selectAll('.cont-label').data(nodes).enter().append('text').attr('class','cont-label')
    .attr('x',d=>d.x).attr('y',d=>d.y-4).attr('text-anchor','middle')
    .attr('font-size',d=>Math.max(10,Math.min(d.r/3.5,16))).attr('font-weight','700').attr('fill','#fff').attr('opacity',0)
    .text(d=>d.data.id).transition().duration(600).delay((d,i)=>i*120+500).attr('opacity',1);
  g.selectAll('.cont-val').data(nodes).enter().append('text').attr('class','cont-val')
    .attr('x',d=>d.x).attr('y',d=>d.y+14).attr('text-anchor','middle')
    .attr('font-size',d=>Math.max(8,Math.min(d.r/5,12))).attr('fill','rgba(255,255,255,.8)').attr('opacity',0)
    .text(d=>d.data.total.toLocaleString()).transition().duration(600).delay((d,i)=>i*120+700).attr('opacity',1);
  // Legend
  const leg=document.getElementById('continent-legend');
  leg.innerHTML=data.map(d=>`<span style="display:flex;align-items:center;gap:4px"><span style="width:12px;height:12px;background:${d.color};display:inline-block;border-radius:50%"></span>${d.label}</span>`).join('');
}
function drillContinent(id){
  const data=CONT_COUNTRIES[id];
  document.getElementById('continent-back').style.display='block';
  const colored=CONT_DATA.find(c=>c.id===id);
  drawBubbles(data.map((d,i)=>({...d,label:d.n,color:colored.color,id:d.n.substring(0,2)})));
}
function resetContinentView(){
  document.getElementById('continent-back').style.display='none';
  drawBubbles(CONT_DATA);
}

// ── D3 TYPE BREAKDOWN ──
function drawTypeChart(){
  const cont=document.getElementById('type-filter-cont').value;
  const size=document.getElementById('type-filter-size').value;
  let data=TYPE_BY_CONT[cont]||TYPE_BY_CONT.ALL;
  let entries=Object.entries(data).map(([type,count])=>({type,count,color:TYPE_DATA_COLORS[type]||'#2C7BE5'}));
  if(size==='LARGE')entries=entries.filter(d=>d.type==='large_airport');
  else if(size==='MEDIUM')entries=entries.filter(d=>d.type==='medium_airport');
  else if(size==='SMALL')entries=entries.filter(d=>['small_airport','seaplane_base','heliport','balloonport'].includes(d.type));
  else if(size==='CLOSED')entries=entries.filter(d=>d.type==='closed');
  entries.sort((a,b)=>b.count-a.count);
  const wrap=document.getElementById('type-chart');wrap.innerHTML='<div class="chart-tooltip" id="type-tooltip"></div>';
  const w=wrap.clientWidth||900,h=380,m={top:20,right:100,bottom:30,left:140},iw=w-m.left-m.right,ih=h-m.top-m.bottom,tt=document.getElementById('type-tooltip');
  const svg=d3.select('#type-chart').append('svg').attr('width',w).attr('height',h).style('overflow','visible');
  const g=svg.append('g').attr('transform',`translate(${m.left},${m.top})`);
  const xM=d3.max(entries,d=>d.count)||1;
  const xS=d3.scaleLinear().domain([0,xM*1.08]).range([0,iw]);
  const yS=d3.scaleBand().domain(entries.map(d=>d.type)).range([0,ih]).padding(.25);
  g.selectAll('rect').data(entries).enter().append('rect')
    .attr('y',d=>yS(d.type)).attr('x',0).attr('width',0).attr('height',yS.bandwidth())
    .attr('fill',d=>d.color).attr('rx',2).attr('opacity',.85)
    .on('mouseover',function(ev,d){d3.select(this).attr('opacity',1);tt.style.opacity=1;tt.innerHTML=`<strong>${d.type.replace(/_/g,' ')}</strong><br>${d.count.toLocaleString()}`})
    .on('mousemove',function(ev){tt.style.left=(ev.offsetX+15)+'px';tt.style.top=(ev.offsetY-10)+'px'})
    .on('mouseout',function(){d3.select(this).attr('opacity',.85);tt.style.opacity=0})
    .transition().duration(800).delay((d,i)=>i*100).ease(d3.easeCubicOut).attr('width',d=>xS(d.count));
  g.selectAll('.ty-lbl').data(entries).enter().append('text').attr('x',-8).attr('y',d=>yS(d.type)+yS.bandwidth()/2)
    .attr('text-anchor','end').attr('dominant-baseline','middle').attr('font-size','12').attr('fill','#202c39')
    .text(d=>d.type.replace(/_/g,' '));
  g.selectAll('.ty-val').data(entries).enter().append('text').attr('x',iw+8).attr('y',d=>yS(d.type)+yS.bandwidth()/2)
    .attr('text-anchor','start').attr('dominant-baseline','middle').attr('font-size','12').attr('font-weight','700')
    .attr('fill','#2ca4dc').attr('opacity',0).text(d=>d.count.toLocaleString())
    .transition().duration(400).delay((d,i)=>i*100+500).attr('opacity',1);
  g.append('g').attr('transform',`translate(0,${ih})`).call(d3.axisBottom(xS).ticks(5).tickFormat(d=>d>=1000?(d/1000).toFixed(0)+'k':d))
    .selectAll('text').attr('font-size','11').attr('fill','#5A6B7F');
}
const TYPE_DATA_COLORS={small_airport:'#2C7BE5',heliport:'#E9C46A',closed:'#E76F51',medium_airport:'#F4A261',seaplane_base:'#6CB4EE',large_airport:'#2A9D8F',balloonport:'#D4E8F7'};

// ── INIT ──
function init(){
  renderSearch(uniAirports);populateCountryFilter();renderCountries();populateDist();initScroll();initMap();
  if(typeof d3!=='undefined'){drawBubbles(CONT_DATA);drawTypeChart()}
  else{document.getElementById('continent-chart').innerHTML='<p style="padding:40px;text-align:center;color:#889">D3.js failed to load</p>';
    document.getElementById('type-chart').innerHTML='<p style="padding:40px;text-align:center;color:#889">D3.js failed to load</p>'}}
document.addEventListener('DOMContentLoaded',init);
</script>
