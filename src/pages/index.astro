<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',Arial,sans-serif;background:#fff;color:#1a1a2e;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:#2563eb;text-decoration:none}a:hover{text-decoration:underline}
img{max-width:100%}

/* Colors */
:root{--primary:#2563eb;--primary-dark:#1d4ed8;--navy:#0f172a;--slate:#334155;--gray:#64748b;--light:#f1f5f9;--border:#e2e8f0;--white:#fff}

/* Layout */
.wrap{max-width:1100px;margin:0 auto;padding:0 20px}

/* Nav */
.nav{background:var(--navy);padding:12 0;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,.1)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.nav a{color:rgba(255,255,255,.8);text-decoration:none;font-size:14px;font-weight:500}
.nav a:hover,.nav a.active{color:#fff}
.nav .logo{color:#fff;font-size:18px;font-weight:700;letter-spacing:-.5px}
.nav .logo span{color:#60a5fa}
.nav-links{display:flex;align-items:center;gap:20px;flex-wrap:wrap}

/* Hero */
.hero{background:linear-gradient(160deg,#0f172a 0%,#1e3a5f 50%,#1a1a2e 100%);padding:60px 0 70px;color:#fff}
.hero h1{font-size:36px;font-weight:800;letter-spacing:-1px;margin-bottom:8px}
.hero .subtitle{color:rgba(255,255,255,.6);font-size:16px;margin-bottom:32px;max-width:560px}
.hero-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:20px;margin-top:32px}
.hero-stat{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:20px;text-align:center}
.hero-stat .num{font-size:28px;font-weight:800;color:#60a5fa;display:block}
.hero-stat .lbl{font-size:11px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:1px;margin-top:4px}

/* Search */
.search-box{max-width:600px;margin-bottom:24px}
.search-box .row{display:flex;gap:0}
.search-box input{flex:1;padding:12px 16px;font-size:15px;border:2px solid var(--border);border-right:none;border-radius:6px 0 0 6px;outline:none;font-family:inherit}
.search-box input:focus{border-color:var(--primary)}
.search-box button{padding:12px 20px;background:var(--primary);color:#fff;font-size:15px;font-weight:600;border:2px solid var(--primary);border-radius:0 6px 6px 0;cursor:pointer;font-family:inherit}
.search-box button:hover{background:var(--primary-dark)}
.search-filters{display:flex;gap:8px;flex-wrap:wrap}
.search-filters select{padding:8px 12px;font-size:13px;border:1px solid rgba(255,255,255,.2);border-radius:6px;background:rgba(255,255,255,.1);color:#fff;font-family:inherit;min-width:140px}
.search-filters select option{background:var(--navy);color:#fff}

/* Sections */
.section{padding:50px 0}
.section+.section{border-top:1px solid var(--border)}
.section-title{font-size:22px;font-weight:700;color:var(--navy);margin-bottom:8px;letter-spacing:-.3px}
.section-desc{font-size:14px;color:var(--gray);margin-bottom:24px}

/* Tables */
table{width:100%;border-collapse:collapse;background:var(--white)}
table th{background:var(--light);color:var(--slate);padding:10px 14px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;border-bottom:2px solid var(--border);font-weight:600}
table td{padding:10px 14px;border-bottom:1px solid var(--border);font-size:14px}
table tr:hover td{background:#f8fafc}
.iata-badge{display:inline-block;background:var(--primary);color:#fff;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:700}

/* Cards / Grids */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:20px}
.card .label{font-size:11px;color:var(--gray);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.card .value{font-size:24px;font-weight:700;color:var(--navy)}
.card .sub{font-size:12px;color:var(--gray);margin-top:2px}

/* Continent table */
.cont-table{width:100%;border-collapse:collapse}
.cont-table th,.cont-table td{padding:12px 16px;text-align:left;border-bottom:1px solid var(--border)}
.cont-table th{background:var(--light);font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--slate);font-weight:600}
.cont-table td{font-size:14px}
.cont-table .num{text-align:right;font-weight:600}
.cont-table .bar{height:8px;border-radius:4px;min-width:40px}
.cont-table tr:hover td{background:#f8fafc}
.cont-table a{color:var(--navy);font-weight:500}
.cont-table a:hover{color:var(--primary)}

/* Type breakdown */
.type-bars{display:grid;gap:12px}
.type-bar{display:flex;align-items:center;gap:12px}
.type-bar .label{width:120px;font-size:13px;color:var(--slate);text-align:right;flex-shrink:0}
.type-bar .bar-wrap{flex:1;background:var(--light);border-radius:4px;height:20px;overflow:hidden}
.type-bar .bar-fill{height:100%;border-radius:4px;min-width:2px}
.type-bar .value{font-size:13px;font-weight:600;color:var(--navy);width:70px;text-align:right;flex-shrink:0}

/* Country grid */
.country-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.country-card{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--white);border:1px solid var(--border);border-radius:8px;color:var(--navy);text-decoration:none;transition:border-color .15s}
.country-card:hover{border-color:var(--primary);text-decoration:none;box-shadow:0 2px 8px rgba(37,99,235,.1)}
.country-card .emoji{font-size:24px}
.country-card .name{font-size:14px;font-weight:600}
.country-card .count{font-size:12px;color:var(--gray)}

/* Footer */
.footer{background:var(--navy);color:rgba(255,255,255,.6);padding:40px 0 24px;font-size:13px}
.footer a{color:rgba(255,255,255,.8);text-decoration:none}
.footer a:hover{color:#fff}
.footer-links{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:16px}
.footer-copy{margin-top:24px;padding-top:16px;border-top:1px solid rgba(255,255,255,.1);font-size:12px;color:rgba(255,255,255,.4)}

/* Responsive */
@media(max-width:768px){
  .hero h1{font-size:26px}
  .hero-stats{grid-template-columns:1fr 1fr}
  .search-box input{font-size:16px}
  .nav .wrap{justify-content:center}
  .type-bar .label{width:90px;font-size:12px}
}
</style>
</head>
