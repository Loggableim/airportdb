const countries=[...new Set(AIRPORTS.map(a=>a.country))].sort();

function filterAirports(){
  const q=document.getElementById('iata-search-input').value.toLowerCase().trim();
  const cont=document.getElementById('filter-continent').value;
  const type=document.getElementById('filter-type').value;
  const cntr=document.getElementById('filter-country').value;
  const tbody=document.getElementById('search-tbody');
  tbody.innerHTML='';
  let count=0;
  AIRPORTS.forEach(a=>{
    if(cont&&a.cont!==cont)return;
    if(type&&a.type!==type)return;
    if(cntr&&a.country!==cntr)return;
    if(q&&!a.iata.toLowerCase().includes(q)&&!a.icao.toLowerCase().includes(q)&&!a.name.toLowerCase().includes(q)&&!a.city.toLowerCase().includes(q))return;
    if(count>=200)return;
    count++;
    const countrySlug=(a.country||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'')||'unknown';
    const nameSlug=a.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'').slice(0,60);
    const link=`/airports/${countrySlug}/${nameSlug}-${a.iata.toLowerCase()}/`;
    const tr=document.createElement('tr');
    tr.innerHTML=`<td><a href="${link}" class="iata-badge">${a.iata}</a></td><td>${a.icao}</td><td><a href="${link}">${a.name}</a></td><td>${a.city}</td><td>${a.country}</td><td>${a.type.replace(/_/g,' ')}</td>`;
    tbody.appendChild(tr);
  });
  if(count===0){const tr=document.createElement('tr');tr.innerHTML='<td colspan="6" style="text-align:center;padding:30px;color:#889">No airports match your search.</td>';tbody.appendChild(tr);}
}

function calcDistance(){
  const fromIATA=document.getElementById('dist-from').value;
  const toIATA=document.getElementById('dist-to').value;
  const from=AIRPORTS.find(a=>a.iata===fromIATA);
  const to=AIRPORTS.find(a=>a.iata===toIATA);
  if(!from||!to)return;
  const R=6371;
  const dLat=(to.lat-from.lat)*Math.PI/180;
  const dLon=(to.lon-from.lon)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(from.lat*Math.PI/180)*Math.cos(to.lat*Math.PI/180)*Math.sin(dLon/2)**2;
  const c=2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
  const km=Math.round(R*c);
  const mi=Math.round(km*0.621371);
  document.getElementById('dist-km').textContent=km.toLocaleString();
  document.getElementById('dist-mi').textContent=mi.toLocaleString();
  document.getElementById('route-info').innerHTML=`<strong>${from.name} (${from.iata})</strong> ✈ <strong>${to.name} (${to.iata})</strong>`;
  document.getElementById('dist-result').style.display='block';
}

// Init
document.addEventListener('DOMContentLoaded',()=>{
  // Populate country filter
  const cntrSel=document.getElementById('filter-country');
  countries.forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;cntrSel.appendChild(o)});
  // Populate distance selects
  const fromSel=document.getElementById('dist-from');
  const toSel=document.getElementById('dist-to');
  AIRPORTS.forEach(a=>{
    const o1=document.createElement('option');o1.value=a.iata;o1.textContent=`${a.iata} — ${a.name}, ${a.country}`;fromSel.appendChild(o1);
    const o2=o1.cloneNode(true);toSel.appendChild(o2);
  });
  fromSel.value='ATL';toSel.value='LHR';
  // Load initial search
  filterAirports();
});
