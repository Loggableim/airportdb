---
const pageTitle = 'Timezone Lookup — World Airport Database';
const pageDesc = 'Look up the current local time, timezone, UTC offset, and DST status for any airport worldwide. Compare times across two airports.';
const pageUrl = 'https://world-airport-database.com/tools/timezone-lookup/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="World Airport Database">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',Arial,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.6}
    :root{--primary:#2ca4dc;--navy:#0B1D3A;--border:#D4E0E8;--stripe:#F0F6FC}
    .wrap{max-width:1100px;margin:0 auto;padding:0 20px}
    .ah{background:linear-gradient(135deg,var(--navy),#142b4f);padding:36px 0;border-bottom:4px solid var(--primary)}
    .ah h1{color:#fff;font-size:28px;margin-bottom:6px}
    .ah .sub{color:#8899aa;font-size:14px}
    .card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:24px;margin:20px 0;box-shadow:0 2px 8px rgba(0,0,0,.04)}
    .card h3{font-size:16px;color:var(--navy);margin-bottom:16px;display:flex;align-items:center;gap:8px}
    .card h4{font-size:14px;color:var(--navy);margin-bottom:10px;display:flex;align-items:center;gap:6px}
    .input-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
    @media(max-width:700px){.input-row{grid-template-columns:1fr}}
    label{display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--navy);margin-bottom:6px}
    select{width:100%;padding:12px 14px;font-size:14px;border:2px solid var(--border);border-radius:8px;font-family:inherit;background:#fff;cursor:pointer;transition:border-color .15s}
    select:focus{border-color:var(--primary);outline:none}
    .search-wrap{position:relative;margin-bottom:10px}
    .search-wrap input{width:100%;padding:12px 14px;font-size:14px;border:2px solid var(--border);border-radius:8px;font-family:inherit;background:#fff;transition:border-color .15s}
    .search-wrap input:focus{border-color:var(--primary);outline:none}
    .search-wrap input::placeholder{color:#999}
    .dropdown{position:absolute;top:100%;left:0;right:0;background:#fff;border:2px solid var(--border);border-top:none;border-radius:0 0 8px 8px;max-height:320px;overflow-y:auto;z-index:50;display:none;box-shadow:0 8px 24px rgba(0,0,0,.12)}
    .dropdown.show{display:block}
    .dropdown-item{padding:10px 14px;cursor:pointer;font-size:13px;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;gap:10px}
    .dropdown-item:hover,.dropdown-item.highlight{background:var(--stripe)}
    .dropdown-item .iata{display:inline-block;background:var(--primary);color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;white-space:nowrap;flex-shrink:0}
    .dropdown-item .info{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .dropdown-item .city{color:#889;font-size:12px}
    .no-results{padding:20px;text-align:center;color:#889;font-size:13px}
    .filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
    .filters select{padding:8px 12px;font-size:13px;border:2px solid var(--border);border-radius:8px;font-family:inherit;background:#fff;cursor:pointer;min-width:140px}
    .filters select:focus{border-color:var(--primary);outline:none}
    .tz-display{display:none;margin-top:8px}
    .tz-display.show{display:block}
    .tz-main{display:flex;align-items:center;gap:20px;padding:16px 20px;background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border:1px solid #bae6fd;border-radius:10px;margin-bottom:14px;flex-wrap:wrap}
    .tz-main .time{font-size:36px;font-weight:800;color:var(--navy);font-variant-numeric:tabular-nums}
    .tz-main .date{font-size:14px;color:#5A6B7F;margin-top:2px}
    .tz-main .badge-group{display:flex;gap:8px;flex-wrap:wrap;margin-left:auto}
    .tz-main .badge{padding:4px 12px;border-radius:6px;font-size:12px;font-weight:600}
    .tz-main .badge.offset{background:var(--navy);color:#fff}
    .tz-main .badge.tz-name{background:#e0e7ff;color:#3730a3}
    .tz-main .badge.dst{background:#fef3c7;color:#92400e}
    .tz-main .badge.dst.active{background:#d1fae5;color:#065f46}
    .tz-main .airport-name{font-size:14px;font-weight:600;color:var(--navy)}
    .tz-main .airport-loc{font-size:12px;color:#5A6B7F}
    .ref-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:12px 0 16px}
    .ref-card{background:var(--stripe);border:1px solid var(--border);border-radius:8px;padding:14px;text-align:center}
    .ref-card .label{font-size:11px;color:#5A6B7F;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
    .ref-card .time{font-size:18px;font-weight:700;color:var(--navy);font-variant-numeric:tabular-nums}
    .ref-card .offset{font-size:11px;color:#889;margin-top:2px}
    .compare-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:start;margin:16px 0}
    @media(max-width:700px){.compare-grid{grid-template-columns:1fr;gap:16px}}
    .compare-side{padding:16px;border-radius:10px;border:1px solid var(--border);position:relative}
    .compare-side .vs-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:#889;margin-bottom:6px}
    .compare-side .big-time{font-size:30px;font-weight:800;color:var(--navy);font-variant-numeric:tabular-nums}
    .compare-side .info-line{font-size:12px;color:#5A6B7F;margin-top:4px}
    .compare-vs{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 0}
    .compare-vs .diff{font-size:20px;font-weight:800;color:var(--primary);background:#e0f2fe;padding:8px 16px;border-radius:8px}
    .compare-vs .diff-label{font-size:11px;color:#889;text-transform:uppercase;letter-spacing:.5px;margin-top:4px}
    .loading{text-align:center;padding:30px;color:#5A6B7F;font-size:14px}
    .error-msg{padding:16px;background:#fff0f0;border:1px solid #e66;border-radius:8px;color:#c33;font-size:13px;margin:10px 0;display:none}
    .compare-btn{display:block;width:100%;padding:14px;background:var(--primary);color:#fff;font-size:15px;font-weight:700;border:none;border-radius:8px;cursor:pointer;font-family:inherit;transition:background .15s;margin-top:12px}
    .compare-btn:hover{background:#2390c2}
    .compare-btn:disabled{background:#b0c4d8;cursor:not-allowed}
    .switch-btn{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:2px solid var(--primary);background:#fff;color:var(--primary);font-size:16px;cursor:pointer;transition:all .15s}
    .switch-btn:hover{background:var(--primary);color:#fff}
    .clear-btn{background:none;border:none;color:var(--primary);cursor:pointer;font-size:12px;font-family:inherit;padding:4px 8px;border-radius:4px}
    .clear-btn:hover{background:var(--stripe)}
    footer{background:var(--navy);color:#8899aa;padding:36px 0 24px;margin-top:40px;border-top:4px solid var(--primary);font-size:13px;text-align:center}
    footer a{color:var(--primary)}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
    .pulse{animation:pulse 1.5s ease-in-out infinite}
  </style>
</head>
<body>

<!-- STICKY NAV -->
<nav style="background:#0f172a;padding:10px 0;position:sticky;top:0;z-index:100">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <a href="/" style="color:#fff;font-size:15px;font-weight:700;text-decoration:none">World<span style="color:#60a5fa">Airport</span>DB</a>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <a href="/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Home</a>
      <a href="/countries/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Countries</a>
      <a href="/blog/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Blog</a>
      <a href="/download/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Database</a>
      <a href="/tools/iata-icao-lookup/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Lookup</a>
      <a href="/tools/distance-calculator/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Distance</a>
      <a href="/tools/nearest-airport/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Nearest</a>
      <a href="/tools/timezone-lookup/" style="color:#60a5fa;text-decoration:none;font-size:13px;font-weight:600">Timezone</a>
      <a href="/tools/airport-map/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Map</a>
    </div>
  </div>
</nav>

<!-- HEADER -->
<div class="ah">
  <div class="wrap">
    <h1>🕐 Timezone Lookup</h1>
    <div class="sub">Find the current local time, UTC offset, IANA timezone, and DST status for any airport worldwide. Compare times across airports.</div>
  </div>
</div>

<div class="wrap">

  <!-- SINGLE LOOKUP -->
  <div class="card">
    <h3>🔍 Single Airport Lookup</h3>
    <label>Search Airport (IATA / ICAO / Name / City)</label>
    <div class="search-wrap">
      <input type="text" id="tz-search" placeholder="e.g. LHR, JFK, Heathrow, London, FRA..." autocomplete="off">
      <div class="dropdown" id="tz-dropdown"></div>
    </div>
    <div class="filters">
      <select id="filter-continent" onchange="applyFilters()">
        <option value="">All Continents</option>
        <option value="NA">North America</option>
        <option value="EU">Europe</option>
        <option value="AS">Asia</option>
        <option value="SA">South America</option>
        <option value="AF">Africa</option>
        <option value="OC">Oceania</option>
        <option value="AN">Antarctica</option>
      </select>
      <select id="filter-type" onchange="applyFilters()">
        <option value="">All Types</option>
        <option value="large_airport">Large Airport</option>
        <option value="medium_airport">Medium Airport</option>
        <option value="small_airport">Small Airport</option>
        <option value="heliport">Heliport</option>
        <option value="seaplane_base">Seaplane Base</option>
        <option value="closed">Closed</option>
      </select>
      <button class="clear-btn" onclick="clearSingleLookup()">✕ Clear</button>
    </div>
    <div id="tz-error" class="error-msg"></div>
    <div id="tz-display" class="tz-display">
      <div class="tz-main">
        <div>
          <div class="airport-name" id="tz-airport-name"></div>
          <div class="airport-loc" id="tz-airport-loc"></div>
          <div class="date" id="tz-date"></div>
          <div class="time" id="tz-time">--:--:--</div>
        </div>
        <div class="badge-group">
          <span class="badge offset" id="tz-offset">UTC±00:00</span>
          <span class="badge tz-name" id="tz-iana">Timezone</span>
          <span class="badge dst" id="tz-dst">DST: --</span>
        </div>
      </div>
      <h4>🌍 Reference Timezones</h4>
      <div class="ref-grid" id="ref-clocks">
        <div class="ref-card"><div class="label">UTC</div><div class="time" id="ref-utc">--:--:--</div><div class="offset">Coordinated Universal Time</div></div>
        <div class="ref-card"><div class="label">New York</div><div class="time" id="ref-ny">--:--:--</div><div class="offset" id="ref-ny-off"></div></div>
        <div class="ref-card"><div class="label">London</div><div class="time" id="ref-lon">--:--:--</div><div class="offset" id="ref-lon-off"></div></div>
        <div class="ref-card"><div class="label">Berlin</div><div class="time" id="ref-ber">--:--:--</div><div class="offset" id="ref-ber-off"></div></div>
        <div class="ref-card"><div class="label">Tokyo</div><div class="time" id="ref-tky">--:--:--</div><div class="offset" id="ref-tky-off"></div></div>
        <div class="ref-card"><div class="label">Sydney</div><div class="time" id="ref-syd">--:--:--</div><div class="offset" id="ref-syd-off"></div></div>
      </div>
    </div>
  </div>

  <!-- COMPARATOR -->
  <div class="card">
    <h3>⚖️ Timezone Comparator</h3>
    <p style="font-size:13px;color:#5A6B7F;margin-bottom:14px">Select two airports to compare their local times side by side.</p>
    <div class="input-row">
      <div>
        <label>Airport A</label>
        <div class="search-wrap">
          <input type="text" id="comp-search-a" placeholder="Search airport..." autocomplete="off">
          <div class="dropdown" id="comp-dropdown-a"></div>
        </div>
        <div style="font-size:12px;color:#5A6B7F;margin-top:4px;min-height:18px" id="comp-selected-a"></div>
      </div>
      <div>
        <label>Airport B</label>
        <div class="search-wrap">
          <input type="text" id="comp-search-b" placeholder="Search airport..." autocomplete="off">
          <div class="dropdown" id="comp-dropdown-b"></div>
        </div>
        <div style="font-size:12px;color:#5A6B7F;margin-top:4px;min-height:18px" id="comp-selected-b"></div>
      </div>
    </div>
    <div style="display:flex;justify-content:center;gap:10px;margin:-4px 0 4px">
      <button class="switch-btn" onclick="swapComparator()" title="Swap airports">⇅</button>
    </div>
    <div id="comp-error" class="error-msg"></div>
    <button class="compare-btn" id="compare-btn" onclick="runComparator()">Compare Times</button>
    <div id="comp-results" class="tz-display" style="margin-top:16px">
      <div class="compare-grid">
        <div class="compare-side" id="comp-side-a" style="border-left:4px solid var(--primary)">
          <div class="vs-label">Airport A</div>
          <div class="big-time" id="comp-time-a">--:--:--</div>
          <div class="info-line" id="comp-info-a"></div>
        </div>
        <div class="compare-vs">
          <div class="diff" id="comp-diff">0h 0m</div>
          <div class="diff-label">Time Difference</div>
        </div>
        <div class="compare-side" id="comp-side-b" style="border-left:4px solid #F4A261">
          <div class="vs-label">Airport B</div>
          <div class="big-time" id="comp-time-b">--:--:--</div>
          <div class="info-line" id="comp-info-b"></div>
        </div>
      </div>
      <h4>🌍 Reference Timezones</h4>
      <div class="ref-grid" id="ref-clocks-comp">
        <div class="ref-card"><div class="label">UTC</div><div class="time" id="ref-comp-utc">--:--:--</div><div class="offset">Coordinated Universal Time</div></div>
        <div class="ref-card"><div class="label">New York</div><div class="time" id="ref-comp-ny">--:--:--</div><div class="offset" id="ref-comp-ny-off"></div></div>
        <div class="ref-card"><div class="label">London</div><div class="time" id="ref-comp-lon">--:--:--</div><div class="offset" id="ref-comp-lon-off"></div></div>
        <div class="ref-card"><div class="label">Berlin</div><div class="time" id="ref-comp-ber">--:--:--</div><div class="offset" id="ref-comp-ber-off"></div></div>
        <div class="ref-card"><div class="label">Tokyo</div><div class="time" id="ref-comp-tky">--:--:--</div><div class="offset" id="ref-comp-tky-off"></div></div>
        <div class="ref-card"><div class="label">Sydney</div><div class="time" id="ref-comp-syd">--:--:--</div><div class="offset" id="ref-comp-syd-off"></div></div>
      </div>
    </div>
  </div>

  <a href="/" style="display:inline-block;margin:20px 0;color:var(--primary);font-weight:600;font-size:14px;text-decoration:none">&larr; Back to World Airport Database</a>
</div>

<footer>
  <div class="wrap">
    <div><strong>World Airport Database since 2008</strong> — based on open data from <a href="https://ourairports.com/" target="_blank">OurAirports</a></div>
    <div style="margin-top:8px">Not affiliated with IATA or ICAO.</div>
    <div style="margin-top:10px"><a href="/impressum/">Impressum</a></div>
  </div>
</footer>

<script>
// ─── Data ───────────────────────────────────────────────────────────────────
let ALL_AIRPORTS = [];
let TZ_CACHE = new Map();

// ─── Country → IANA Timezone Map (fallback) ─────────────────────────────────
const COUNTRY_TZ = {
