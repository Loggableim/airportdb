function initCompSearch(inputId, dropdownId, selectedId, storeKey) {
  const input = document.getElementById(inputId);
  const dd = document.getElementById(dropdownId);
  const selected = document.getElementById(selectedId);
  let timer = null;

  input.addEventListener('input', function() {
    clearTimeout(timer);
    const val = this.value.trim();
    if (val.length < 1) {
      dd.classList.remove('show');
      return;
    }
    timer = setTimeout(() => {
      const results = filterAirportsForComp(val);
      if (results.length === 0) {
        dd.innerHTML = '<div class="no-results">No airports found</div>';
        dd.classList.add('show');
        return;
      }
      dd.innerHTML = results.map(ap => {
        const iata = ap.i || '—';
        const city = ap.m || '';
        const country = ap.c || '';
        return '<div class="dropdown-item" onclick="selectCompAirport(\'' + ap.i + '\', \'' + inputId + '\', \'' + dropdownId + '\', \'' + selectedId + '\', \'' + storeKey + '\')">' +
          '<span class="iata">' + iata + '</span>' +
          '<span class="info">' + escapeHtml(ap.n || '') +
            (city ? '<span class="city">, ' + escapeHtml(city) + ', ' + escapeHtml(country) + '</span>' : '') +
          '</span>' +
          '</div>';
      }).join('');
      dd.classList.add('show');
    }, 150);
  });

  input.addEventListener('blur', function() {
    setTimeout(() => dd.classList.remove('show'), 200);
  });

  input.addEventListener('focus', function() {
    if (this.value.trim().length > 0) {
      const results = filterAirportsForComp(this.value.trim());
      if (results.length > 0) {
        dd.innerHTML = results.map(ap => {
          const iata = ap.i || '—';
          const city = ap.m || '';
          const country = ap.c || '';
          return '<div class="dropdown-item" onclick="selectCompAirport(\'' + ap.i + '\', \'' + inputId + '\', \'' + dropdownId + '\', \'' + selectedId + '\', \'' + storeKey + '\')">' +
            '<span class="iata">' + iata + '</span>' +
            '<span class="info">' + escapeHtml(ap.n || '') +
              (city ? '<span class="city">, ' + escapeHtml(city) + ', ' + escapeHtml(country) + '</span>' : '') +
            '</span>' +
            '</div>';
        }).join('');
        dd.classList.add('show');
      }
    }
  });
}

function filterAirportsForComp(query) {
  const q = query.toLowerCase().trim();
  if (!allData.length) return [];
  return allData.filter(a =>
    (a.i && a.i.toLowerCase().includes(q)) ||
    (a.o && a.o.toLowerCase().includes(q)) ||
    (a.n && a.n.toLowerCase().includes(q)) ||
    (a.m && a.m.toLowerCase().includes(q)) ||
    (a.c && a.c.toLowerCase().includes(q))
  ).slice(0, 50);
}

function selectCompAirport(iata, inputId, dropdownId, selectedId, storeKey) {
  const ap = allData.find(a => a.i === iata);
  if (!ap) return;
  
  if (storeKey === 'A') {
    compAirportA = ap;
  } else {
    compAirportB = ap;
  }
  
  document.getElementById(inputId).value = ap.i + ' — ' + (ap.n || '');
  document.getElementById(dropdownId).classList.remove('show');
  document.getElementById(selectedId).textContent = '📍 ' + (ap.m || '') + (ap.m && ap.c ? ', ' : '') + ap.c;
  document.getElementById('compare-btn').disabled = !(compAirportA && compAirportB);
  
  // Auto-compare if both selected
  if (compAirportA && compAirportB) {
    runComparator();
  }
}

function swapComparator() {
  const temp = compAirportA;
  compAirportA = compAirportB;
  compAirportB = temp;
  
  const inputA = document.getElementById('comp-search-a');
  const inputB = document.getElementById('comp-search-b');
  const selA = document.getElementById('comp-selected-a');
  const selB = document.getElementById('comp-selected-b');
  
  inputA.value = compAirportA ? compAirportA.i + ' — ' + (compAirportA.n || '') : '';
  inputB.value = compAirportB ? compAirportB.i + ' — ' + (compAirportB.n || '') : '';
  selA.textContent = compAirportA ? '📍 ' + (compAirportA.m || '') + (compAirportA.m && compAirportA.c ? ', ' : '') + compAirportA.c : '';
  selB.textContent = compAirportB ? '📍 ' + (compAirportB.m || '') + (compAirportB.m && compAirportB.c ? ', ' : '') + compAirportB.c : '';
  
  if (compAirportA && compAirportB) {
    runComparator();
  }
}

let compInterval = null;

function runComparator() {
  if (!compAirportA || !compAirportB) {
    document.getElementById('comp-error').textContent = 'Please select both airports.';
    document.getElementById('comp-error').style.display = 'block';
    return;
  }
  document.getElementById('comp-error').style.display = 'none';
  
  const tzA = resolveTimezone(compAirportA);
  const tzB = resolveTimezone(compAirportB);
  const results = document.getElementById('comp-results');
  results.classList.add('show');
  
  if (compInterval) clearInterval(compInterval);
  
  function tick() {
    const now = new Date();
    
    // Side A
    document.getElementById('comp-time-a').textContent = formatInTimezone(tzA, now);
    const infoA = compAirportA.n + ' (' + compAirportA.i + ')' +
      ' · ' + formatOffsetDisplay(getOffsetMinutes(tzA)) +
      ' · ' + tzA.replace(/_/g, ' ');
    document.getElementById('comp-info-a').textContent = infoA;
    
    // Side B
    document.getElementById('comp-time-b').textContent = formatInTimezone(tzB, now);
    const infoB = compAirportB.n + ' (' + compAirportB.i + ')' +
      ' · ' + formatOffsetDisplay(getOffsetMinutes(tzB)) +
      ' · ' + tzB.replace(/_/g, ' ');
    document.getElementById('comp-info-b').textContent = infoB;
    
    // Difference
    const diff = timeDiffMinutes(tzA, tzB);
    document.getElementById('comp-diff').textContent = formatTimeDiff(diff);
    
    // Reference clocks
    updateRefClocks('ref-comp-');
  }
  
  tick();
  compInterval = setInterval(tick, 1000);
}

// ─── Init ────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async function() {
  // Load data
  allData = await loadAirports();
  
  // Single search
  const searchInput = document.getElementById('tz-search');
  let searchTimer = null;
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimer);
    const val = this.value.trim();
    if (val.length === 0) {
      document.getElementById('tz-dropdown').classList.remove('show');
      return;
    }
    searchTimer = setTimeout(() => doSearch(val), 150);
  });
  searchInput.addEventListener('blur', function() {
    setTimeout(() => document.getElementById('tz-dropdown').classList.remove('show'), 200);
  });
  searchInput.addEventListener('focus', function() {
    if (this.value.trim().length > 0) {
      doSearch(this.value.trim());
    }
  });
  searchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      const dd = document.getElementById('tz-dropdown');
      const first = dd.querySelector('.dropdown-item');
      if (first) first.click();
    }
  });
  
  // Comparator searches
  initCompSearch('comp-search-a', 'comp-dropdown-a', 'comp-selected-a', 'A');
  initCompSearch('comp-search-b', 'comp-dropdown-b', 'comp-selected-b', 'B');
  
  // Init ref clocks
  updateRefClocks('ref-');
  updateRefClocks('ref-comp-');
  
  // Global tick for ref clocks every second
  setInterval(() => {
    updateRefClocks('ref-');
    updateRefClocks('ref-comp-');
  }, 1000);
});
</script>
