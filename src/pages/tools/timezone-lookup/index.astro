// ─── Timezone Resolution ──────────────────────────────────────────────────────
function getCountryTimezone(country, lon) {
  const entry = COUNTRY_TZ[country];
  if (!entry) return null;
  // Single zone (object with .zone)
  if (entry.zone) return entry.zone;
  // Array of zone ranges
  for (const r of entry) {
    if (r.lonMin !== undefined && (lon < r.lonMin || lon >= r.lonMax)) continue;
    if (r.latMin !== undefined && (lat => {
      // lat check uses the function param
      return false;
    })(0)) continue;
    if (r.latMin !== undefined) continue; // handled below
    return r.zone;
  }
  // Fallback: match with lat ranges if specified
  for (const r of entry) {
    if (r.lonMin !== undefined && (lon < r.lonMin || lon >= r.lonMax)) continue;
    if (r.latMin !== undefined) {
      // This would need the actual lat passed in
      continue;
    }
    return r.zone;
  }
  return entry[0]?.zone || null;
}

function getCountryTimezoneWithLat(country, lat, lon) {
  const entry = COUNTRY_TZ[country];
  if (!entry) return null;
  if (entry.zone) return entry.zone;
  for (const r of entry) {
    if (r.lonMin !== undefined && (lon < r.lonMin || lon >= r.lonMax)) continue;
    if (r.latMin !== undefined && (lat < r.latMin || lat >= (r.latMax || 90))) continue;
    return r.zone;
  }
  return entry[0]?.zone || null;
}

function resolveTimezone(ap) {
  const key = ap.i + '|' + ap.y + '|' + ap.x;
  if (TZ_CACHE.has(key)) return TZ_CACHE.get(key);
  
  // Try country-based lookup
  let tzName = getCountryTimezoneWithLat(ap.c, ap.y, ap.x);
  
  // Fallback: longitude-based offset → Etc/GMT+X
  if (!tzName) {
    const offsetHours = Math.round(-ap.x / 15);
    const sign = offsetHours >= 0 ? '+' : '';
    tzName = 'Etc/GMT' + sign + offsetHours;
  }
  
  TZ_CACHE.set(key, tzName);
  return tzName;
}

function formatOffset(tzName, date) {
  try {
    const opts = { timeZone: tzName, timeZoneName: 'shortOffset' };
    const parts = new Intl.DateTimeFormat('en', opts).formatToParts(date);
    const tzPart = parts.find(p => p.type === 'timeZoneName');
    return tzPart ? tzPart.value : '';
  } catch(e) {
    return '';
  }
}

function computeUtcOffset(tzName, date) {
  try {
    const opts = { timeZone: tzName, timeZoneName: 'shortOffset', hour: '2-digit', minute: '2-digit', hour12: false };
    const parts = new Intl.DateTimeFormat('en', opts).formatToParts(date);
    const tzPart = parts.find(p => p.type === 'timeZoneName');
    return tzPart ? tzPart.value : '';
  } catch(e) {
    return '';
  }
}

function isDST(tzName, date) {
  try {
    const opts = { timeZone: tzName, timeZoneName: 'long' };
    const parts = new Intl.DateTimeFormat('en', opts).formatToParts(date);
    const tzPart = parts.find(p => p.type === 'timeZoneName');
    if (!tzPart) return false;
    const names = ['daylight', 'summer', 'dst'];
    const lower = tzPart.value.toLowerCase();
    return names.some(n => lower.includes(n));
  } catch(e) {
    return false;
  }
}

function formatInTimezone(tzName, date) {
  try {
    const opts = { timeZone: tzName, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, hourCycle: 'h23' };
    return new Intl.DateTimeFormat('en', opts).format(date);
  } catch(e) {
    return '--:--:--';
  }
}

function formatDateInTimezone(tzName, date) {
  try {
    const opts = { timeZone: tzName, weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    return new Intl.DateTimeFormat('en', opts).format(date);
  } catch(e) {
    return '';
  }
}

function getOffsetMinutes(tzName) {
  try {
    const now = new Date();
    const utc = new Date(now.toLocaleString('en', { timeZone: 'UTC' }));
    const local = new Date(now.toLocaleString('en', { timeZone: tzName }));
    return Math.round((local - utc) / 60000);
  } catch(e) {
    return 0;
  }
}

function formatOffsetDisplay(minutes) {
  const sign = minutes >= 0 ? '+' : '-';
  const abs = Math.abs(minutes);
  const h = Math.floor(abs / 60);
  const m = abs % 60;
  return 'UTC' + sign + String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
}

function timeDiffMinutes(tzA, tzB) {
  return getOffsetMinutes(tzB) - getOffsetMinutes(tzA);
}

function formatTimeDiff(minutes) {
  const sign = minutes >= 0 ? '+' : '-';
  const abs = Math.abs(minutes);
  const h = Math.floor(abs / 60);
  const m = abs % 60;
  if (h > 0) return sign + h + 'h ' + m + 'm';
  return sign + m + 'm';
}

// ─── Ref Timezone Constants ──────────────────────────────────────────────────
const REF_TZS = [
  { id: 'utc',  label: 'UTC',          tz: 'UTC' },
  { id: 'ny',   label: 'New York',     tz: 'America/New_York' },
  { id: 'lon',  label: 'London',       tz: 'Europe/London' },
  { id: 'ber',  label: 'Berlin',       tz: 'Europe/Berlin' },
  { id: 'tky',  label: 'Tokyo',        tz: 'Asia/Tokyo' },
  { id: 'syd',  label: 'Sydney',       tz: 'Australia/Sydney' },
];

function updateRefClocks(prefix) {
  const now = new Date();
  REF_TZS.forEach(({ id, tz }) => {
    const timeEl = document.getElementById(prefix + id);
    if (timeEl) {
      timeEl.textContent = formatInTimezone(tz, now);
    }
    const offEl = document.getElementById(prefix + id + '-off');
    if (offEl) {
      offEl.textContent = formatOffsetDisplay(getOffsetMinutes(tz));
    }
  });
}

// ─── Airport Data Loading ────────────────────────────────────────────────────
async function loadAirports() {
  if (ALL_AIRPORTS.length > 0) return ALL_AIRPORTS;
  const res = await fetch('/data/airports.json');
  const data = await res.json();
  // Only airports with IATA code
  ALL_AIRPORTS = data.filter(a => a.i && a.i.length > 0);
  return ALL_AIRPORTS;
}

// ─── Search / Dropdown ───────────────────────────────────────────────────────
let activeContinent = '';
let activeType = '';
let singleAirport = null;      // selected airport for single lookup
let compAirportA = null;
let compAirportB = null;

// Stores
let searchTimer = null;
let allData = [];

function applyFilters() {
  activeContinent = document.getElementById('filter-continent').value;
  activeType = document.getElementById('filter-type').value;
  const input = document.getElementById('tz-search');
  if (input.value.trim().length > 0) {
    doSearch(input.value.trim());
  } else {
    const dd = document.getElementById('tz-dropdown');
    dd.classList.remove('show');
  }
}

function filterAirports(query) {
  const q = query.toLowerCase().trim();
  if (!allData.length) return [];
  let results = allData;
  if (activeContinent) {
    results = results.filter(a => a.z === activeContinent);
  }
  if (activeType) {
    results = results.filter(a => a.t === activeType);
  }
  if (q.length > 0) {
    results = results.filter(a =>
      (a.i && a.i.toLowerCase().includes(q)) ||
      (a.o && a.o.toLowerCase().includes(q)) ||
      (a.n && a.n.toLowerCase().includes(q)) ||
      (a.m && a.m.toLowerCase().includes(q)) ||
      (a.c && a.c.toLowerCase().includes(q))
    );
  }
  // Sort: exact IATA match first, then by name
  results.sort((a, b) => {
    const aExact = a.i && a.i.toLowerCase() === q ? 0 : 1;
    const bExact = b.i && b.i.toLowerCase() === q ? 0 : 1;
    if (aExact !== bExact) return aExact - bExact;
    return (a.n || '').localeCompare(b.n || '');
  });
  return results.slice(0, 80);
}

function doSearch(query) {
  const dd = document.getElementById('tz-dropdown');
  const results = filterAirports(query);
  if (results.length === 0 || query.length === 0) {
    dd.classList.remove('show');
    return;
  }
  dd.innerHTML = results.map(ap => {
    const iata = ap.i || '—';
    const icao = ap.o || '—';
    const city = ap.m || '';
    const country = ap.c || '';
    const type = (ap.t || '').replace(/_/g, ' ');
    return '<div class="dropdown-item" onclick="selectAirport(\'' + ap.i + '\')">' +
      '<span class="iata">' + iata + '</span>' +
      '<span class="info">' + escapeHtml(ap.n || '') +
        (city ? '<span class="city">, ' + escapeHtml(city) + ', ' + escapeHtml(country) + '</span>' : '') +
      '</span>' +
      '<span style="margin-left:auto;font-size:11px;color:#889">' + type + '</span>' +
      '</div>';
  }).join('');
  dd.classList.add('show');
}

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function selectAirport(iata) {
  const ap = allData.find(a => a.i === iata);
  if (!ap) return;
  singleAirport = ap;
  document.getElementById('tz-search').value = ap.i + ' — ' + (ap.n || '');
  document.getElementById('tz-dropdown').classList.remove('show');
  showSingleTimezone(ap);
}

function clearSingleLookup() {
  singleAirport = null;
  document.getElementById('tz-search').value = '';
  document.getElementById('tz-dropdown').classList.remove('show');
  document.getElementById('tz-display').classList.remove('show');
  document.getElementById('tz-error').style.display = 'none';
}

let refInterval = null;

async function showSingleTimezone(ap) {
  const errorEl = document.getElementById('tz-error');
  errorEl.style.display = 'none';
  
  const tzName = resolveTimezone(ap);
  const display = document.getElementById('tz-display');
  display.classList.add('show');
  
  document.getElementById('tz-airport-name').textContent = ap.n + ' (' + ap.i + ')';
  document.getElementById('tz-airport-loc').textContent = (ap.m || '') + (ap.m && ap.c ? ', ' : '') + ap.c;
  
  // Start live clock
  if (refInterval) clearInterval(refInterval);
  
  function tick() {
    const now = new Date();
    document.getElementById('tz-time').textContent = formatInTimezone(tzName, now);
    document.getElementById('tz-date').textContent = formatDateInTimezone(tzName, now);
    
    const offset = computeUtcOffset(tzName, now);
    const offsetMin = getOffsetMinutes(tzName);
    document.getElementById('tz-offset').textContent = formatOffsetDisplay(offsetMin);
    
    const shortName = tzName.replace(/_/g, ' ');
    document.getElementById('tz-iana').textContent = shortName;
    
    const dst = isDST(tzName, now);
    const dstEl = document.getElementById('tz-dst');
    dstEl.textContent = dst ? 'DST: Active' : 'DST: Inactive';
    dstEl.className = 'badge dst' + (dst ? ' active' : '');
    
    updateRefClocks('ref-');
  }
  
  tick();
  refInterval = setInterval(tick, 1000);
}

