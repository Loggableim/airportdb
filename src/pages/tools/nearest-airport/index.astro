---
const pageTitle = 'Nearest Airport Finder — Find Closest Airports by Location | World Airport Database';
const pageDesc = 'Find the nearest airports to any location worldwide. Use your current location, search by city, or enter coordinates. Interactive map with distance visualization.';
const pageUrl = 'https://world-airport-database.com/tools/nearest-airport/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="World Airport Database">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'Inter',Arial,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.6;-webkit-font-smoothing:antialiased}
    :root{--primary:#2ca4dc;--primary-dark:#2390c2;--navy:#0B1D3A;--slate:#334155;--gray:#5A6B7F;--light:#F0F6FC;--border:#D4E0E8;--white:#fff;--success:#10b981;--error:#ef4444}
    .wrap{max-width:1100px;margin:0 auto;padding:0 20px}

    /* Sticky Nav */
    .nav{background:#0f172a;padding:10px 0;position:sticky;top:0;z-index:1000;border-bottom:1px solid rgba(255,255,255,.1)}
    .nav .wrap{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}
    .nav .logo{color:#fff;font-size:15px;font-weight:700;text-decoration:none;letter-spacing:-.5px;white-space:nowrap}
    .nav .logo span{color:#60a5fa}
    .nav-links{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
    .nav-links a{color:rgba(255,255,255,.7);text-decoration:none;font-size:13px;transition:color .15s}
    .nav-links a:hover,.nav-links a.active{color:#fff}

    /* Hero */
    .ah{background:linear-gradient(135deg,var(--navy),#142b4f);padding:36px 0;border-bottom:4px solid var(--primary)}
    .ah h1{color:#fff;font-size:28px;margin-bottom:6px;font-weight:800;letter-spacing:-.5px}
    .ah .sub{color:#8899aa;font-size:14px}

    /* Cards */
    .card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:24px;margin:20px 0;box-shadow:0 2px 8px rgba(0,0,0,.04)}
    .card h3{font-size:16px;color:var(--navy);margin-bottom:16px;display:flex;align-items:center;gap:8px}

    /* Controls */
    .input-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
    .input-row.three{grid-template-columns:1fr 1fr auto}
    @media(max-width:600px){.input-row,.input-row.three{grid-template-columns:1fr}}
    label{display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--navy);margin-bottom:6px}
    input,select{width:100%;padding:12px 14px;font-size:14px;border:2px solid var(--border);border-radius:8px;font-family:inherit;background:#fff;transition:border-color .15s}
    input:focus,select:focus{border-color:var(--primary);outline:none}
    select{cursor:pointer;appearance:auto}
    input[type="number"]{-moz-appearance:textfield}
    input[type="number"]::-webkit-outer-spin-button,input[type="number"]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}

    .btn-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;font-size:14px;font-weight:600;border:none;border-radius:8px;cursor:pointer;font-family:inherit;transition:all .15s;text-decoration:none}
    .btn-primary{background:var(--primary);color:#fff}
    .btn-primary:hover{background:var(--primary-dark)}
    .btn-secondary{background:var(--light);color:var(--navy);border:1px solid var(--border)}
    .btn-secondary:hover{background:#e3f0f7;border-color:var(--primary)}
    .btn-success{background:var(--success);color:#fff}
    .btn-success:hover{background:#059669}
    .btn-outline{background:transparent;color:var(--primary);border:2px solid var(--primary)}
    .btn-outline:hover{background:var(--primary);color:#fff}
    .btn-sm{padding:6px 12px;font-size:12px;border-radius:6px}
    .btn-block{width:100%}
    .btn:disabled{opacity:.5;cursor:not-allowed}

    .loc-status{font-size:13px;color:var(--gray);margin:8px 0 0;min-height:20px}
    .loc-status.success{color:var(--success)}
    .loc-status.error{color:var(--error)}

    /* Filter toggle */
    .filter-row{display:flex;align-items:center;gap:12px;margin-bottom:16px;flex-wrap:wrap}
    .toggle-wrap{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--gray)}
    .toggle{cursor:pointer;position:relative;width:44px;height:24px;background:var(--border);border-radius:12px;border:none;transition:background .2s;flex-shrink:0}
    .toggle.active{background:var(--primary)}
    .toggle::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;background:#fff;border-radius:50%;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
    .toggle.active::after{transform:translateX(20px)}

    /* Loading */
    .loading{display:none;text-align:center;padding:40px 20px;color:var(--gray)}
    .loading.show{display:block}
    .spinner{display:inline-block;width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin .7s linear infinite;margin-bottom:12px}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* Error */
    .error-box{display:none;padding:16px 20px;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;color:var(--error);font-size:14px;margin:16px 0}
    .error-box.show{display:block}

    /* Results Layout */
    .results-wrap{display:none;gap:20px;margin-top:20px}
    .results-wrap.show{display:grid;grid-template-columns:1fr 320px}
    @media(max-width:860px){.results-wrap.show{grid-template-columns:1fr}}

    .results-main{min-width:0}
    .results-sidebar{order:-1}
    @media(max-width:860px){.results-sidebar{order:0}}

    /* Results Header */
    .results-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:16px}
    .results-header h3{font-size:16px;color:var(--navy);margin:0}
    .results-header .info{font-size:13px;color:var(--gray)}

    /* Map */
    #map{height:450px;border-radius:12px;border:2px solid var(--border);margin-top:16px}
    @media(max-width:600px){#map{height:300px}}

    /* Table */
    .table-wrap{overflow-x:auto;border-radius:8px;border:1px solid var(--border);margin-bottom:16px}
    table{width:100%;border-collapse:collapse;background:#fff;font-size:14px}
    thead{background:var(--navy)}
    th{color:#fff;padding:10px 12px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;white-space:nowrap}
    th:last-child{text-align:right}
    td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:middle}
    tr:last-child td{border-bottom:none}
    tr:hover td{background:#f8fafc}
    tr.highlight td{background:#e0f2fe !important}
    .iata-badge{display:inline-block;background:var(--primary);color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;letter-spacing:.3px}
    .no-iata{color:#99a;font-size:11px}
    .dist-num{font-weight:700;color:var(--primary)}
    .td-actions{white-space:nowrap;text-align:right}
    .rank-num{font-size:13px;font-weight:600;color:var(--gray);width:30px;display:inline-block;text-align:center}

    /* Sidebar List */
    .sidebar-list{list-style:none;padding:0;margin:0;max-height:520px;overflow-y:auto;scrollbar-width:thin}
    .sidebar-list::-webkit-scrollbar{width:5px}
    .sidebar-list::-webkit-scrollbar-track{background:var(--light)}
    .sidebar-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
    .sidebar-item{padding:10px 12px;border-bottom:1px solid var(--light);cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:10px}
    .sidebar-item:last-child{border-bottom:none}
    .sidebar-item:hover{background:var(--light)}
    .sidebar-item.active{background:#e0f2fe;border-left:3px solid var(--primary)}
    .sidebar-rank{width:24px;height:24px;border-radius:50%;background:var(--light);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--gray);flex-shrink:0}
    .sidebar-item.active .sidebar-rank{background:var(--primary);color:#fff}
    .sidebar-info{flex:1;min-width:0}
    .sidebar-name{font-size:13px;font-weight:600;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .sidebar-meta{font-size:11px;color:var(--gray);margin-top:2px}
    .sidebar-dist{font-size:12px;font-weight:600;color:var(--primary);white-space:nowrap}

    /* Links in table */
    .airport-link{color:var(--navy);text-decoration:none;font-weight:500}
    .airport-link:hover{color:var(--primary);text-decoration:underline}
    .city-link{color:var(--gray);text-decoration:none;font-size:12px}
    .city-link:hover{color:var(--primary);text-decoration:underline}

    /* Footer */
    footer{background:var(--navy);color:#8899aa;padding:36px 0 24px;margin-top:48px;border-top:4px solid var(--primary);font-size:13px;text-align:center}
    footer a{color:var(--primary);text-decoration:none}
    footer a:hover{text-decoration:underline}

    /* Misc */
    .note{background:#eef6fb;border:1px solid #bae6fd;border-radius:8px;padding:14px 16px;font-size:13px;color:var(--slate);margin:12px 0}
    .back-link{display:inline-block;margin:20px 0;color:var(--primary);font-weight:600;font-size:14px;text-decoration:none}
    .back-link:hover{text-decoration:underline}
    .flex-center{display:flex;align-items:center;gap:6px}
  </style>
</head>
