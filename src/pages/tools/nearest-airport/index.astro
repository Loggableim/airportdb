<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// ─── Haversine Formula ─────────────────────────────────────────────
const R_EARTH = 6371;

function haversine(lat1, lon1, lat2, lon2) {
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2
    + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180)
    * Math.sin(dLon / 2) ** 2;
  return R_EARTH * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// ─── State ─────────────────────────────────────────────────────────
let airportsData = null;
let mapInstance = null;
let mapMarkers = [];
let mapLines = [];
let currentLat = null;
let currentLon = null;
let iataOnly = true;
let activeSidebarIdx = -1;
let userMarker = null;
let userCircle = null;

// ─── Load Data ─────────────────────────────────────────────────────
async function loadAirports() {
  if (airportsData) return airportsData;
  const res = await fetch('/data/airports.json');
  if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
  airportsData = await res.json();
  return airportsData;
}

// ─── Geolocation ───────────────────────────────────────────────────
function useMyLocation() {
  const btn = document.getElementById('loc-btn');
  const status = document.getElementById('loc-status');
  if (!navigator.geolocation) {
    status.className = 'loc-status error';
    status.textContent = '❌ Geolocation is not supported by your browser.';
    return;
  }
  btn.disabled = true;
  btn.textContent = '⏳ Locating…';
  status.className = 'loc-status';
  status.textContent = 'Requesting location…';

  navigator.geolocation.getCurrentPosition(
    (pos) => {
      currentLat = pos.coords.latitude;
      currentLon = pos.coords.longitude;
      document.getElementById('lat-input').value = currentLat.toFixed(6);
      document.getElementById('lon-input').value = currentLon.toFixed(6);
      document.getElementById('city-select').value = '';
      status.className = 'loc-status success';
      const acc = pos.coords.accuracy ? ` (±${pos.coords.accuracy.toFixed(0)}m)` : '';
      status.textContent = `✅ Location acquired: ${currentLat.toFixed(4)}°${currentLat >= 0 ? 'N' : 'S'}, ${currentLon.toFixed(4)}°${currentLon >= 0 ? 'E' : 'W'}${acc}`;
      btn.disabled = false;
      btn.textContent = '📡 Use My Location';
      findNearest();
    },
    (err) => {
      status.className = 'loc-status error';
      const msgs = {
        1: 'Permission denied. Please allow location access or enter coordinates manually.',
        2: 'Position unavailable. Try again or enter coordinates manually.',
        3: 'Location request timed out. Try again or enter coordinates manually.',
      };
      status.textContent = '❌ ' + (msgs[err.code] || err.message);
      btn.disabled = false;
      btn.textContent = '📡 Use My Location';
    },
    { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
  );
}

// ─── IATA Filter Toggle ────────────────────────────────────────────
function toggleIataFilter() {
  iataOnly = !iataOnly;
  document.getElementById('iata-toggle').classList.toggle('active', iataOnly);
  // Re-run search if results are visible
  if (currentLat !== null && currentLon !== null) {
    findNearest();
  }
}

// ─── Main Search ───────────────────────────────────────────────────
async function findNearest() {
  const latEl = document.getElementById('lat-input');
  const lonEl = document.getElementById('lon-input');
  const citySel = document.getElementById('city-select');
  const loading = document.getElementById('loading');
  const errorEl = document.getElementById('error');
  const wrap = document.getElementById('results-wrap');

  errorEl.classList.remove('show');
  wrap.classList.remove('show');

  let lat, lon;

  // City select overrides manual input
  if (citySel.value) {
    const parts = citySel.value.split('|');
    lat = parseFloat(parts[0]);
    lon = parseFloat(parts[1]);
    latEl.value = lat;
    lonEl.value = lon;
  } else {
    lat = parseFloat(latEl.value);
    lon = parseFloat(lonEl.value);
  }

  if (isNaN(lat) || isNaN(lon)) {
    showError('Please enter valid latitude and longitude values, or select a city, or use your current location.');
    return;
  }
  if (lat < -90 || lat > 90) { showError('Latitude must be between -90 and 90.'); return; }
  if (lon < -180 || lon > 180) { showError('Longitude must be between -180 and 180.'); return; }

  currentLat = lat;
  currentLon = lon;

  loading.classList.add('show');
  try {
    const data = await loadAirports();
    loading.classList.remove('show');

    // Filter: optionally only airports with IATA code
    let filtered = data;
    if (iataOnly) {
      filtered = data.filter(ap => ap.i && ap.i.length > 0);
    }

    // Calculate distances
    const withDist = filtered.map(ap => ({
      ...ap,
      d_km: haversine(lat, lon, ap.y, ap.x)
    }));
    withDist.sort((a, b) => a.d_km - b.d_km);
    const top10 = withDist.slice(0, 10);

    if (top10.length === 0) {
      showError('No airports found matching your criteria.');
      return;
    }

    renderResults(lat, lon, top10);
    renderMap(lat, lon, top10);
  } catch (e) {
    loading.classList.remove('show');
    showError('Error loading airport data: ' + e.message);
  }
}

// ─── Render Results Table + Sidebar ────────────────────────────────
function renderResults(lat, lon, airports) {
  const tbody = document.getElementById('results-tbody');
  const sidebar = document.getElementById('sidebar-list');
  const info = document.getElementById('results-info');
  const wrap = document.getElementById('results-wrap');

  // Location label
  const citySel = document.getElementById('city-select');
  const cityName = citySel.options[citySel.selectedIndex]?.text || '';
  const latDir = lat >= 0 ? 'N' : 'S';
  const lonDir = lon >= 0 ? 'E' : 'W';
  const locLabel = (cityName && cityName !== '— Choose a city —')
    ? cityName
    : `${lat.toFixed(4)}°${latDir}, ${lon.toFixed(4)}°${lonDir}`;
  info.textContent = `📍 ${locLabel} · ${airports.length} result${airports.length !== 1 ? 's' : ''}`;

  // Table rows
  tbody.innerHTML = airports.map((ap, i) => {
    const km = ap.d_km.toFixed(1);
    const mi = (ap.d_km * 0.621371).toFixed(1);
    const iataCode = ap.i || '';
    const airportSlug = ap.i
      ? `/airports/${ap.i}/`
      : `/airports/?q=${encodeURIComponent(ap.n)}`;
    return `<tr data-idx="${i}">
      <td><span class="rank-num">${i + 1}</span></td>
      <td>${iataCode
        ? `<span class="iata-badge">${iataCode}</span>`
        : '<span class="no-iata">—</span>'}</td>
      <td><a href="${airportSlug}" class="airport-link">${escHtml(ap.n || 'Unknown')}</a></td>
      <td>${escHtml(ap.m || '—')}, ${escHtml(ap.c || 'Unknown')}</td>
      <td style="text-align:right"><span class="dist-num">${km}</span></td>
      <td style="text-align:right">${mi}</td>
      <td class="td-actions">
        <button class="btn btn-outline btn-sm" onclick="highlightAirport(${i}); showOnMap(${i})" title="Show on map">🗺️</button>
        ${iataCode ? `<a href="${airportSlug}" class="btn btn-secondary btn-sm" title="View airport details">🔗</a>` : ''}
      </td>
    </tr>`;
  }).join('');

  // Sidebar list
  sidebar.innerHTML = airports.map((ap, i) => {
    const km = ap.d_km.toFixed(1);
    const iataCode = ap.i || '';
    return `<li class="sidebar-item" data-idx="${i}" onclick="highlightAirport(${i})">
      <span class="sidebar-rank">${i + 1}</span>
      <div class="sidebar-info">
        <div class="sidebar-name">${iataCode ? iataCode + ' · ' : ''}${escHtml(ap.n || 'Unknown')}</div>
        <div class="sidebar-meta">${escHtml(ap.m || '—')}, ${escHtml(ap.c || '')}</div>
      </div>
      <span class="sidebar-dist">${km} km</span>
    </li>`;
  }).join('');

  wrap.classList.add('show');
  activeSidebarIdx = -1;
}

// ─── Map Rendering ─────────────────────────────────────────────────
function renderMap(lat, lon, airports) {
  const mapEl = document.getElementById('map');

  // Destroy old map
  if (mapInstance) {
    mapInstance.remove();
    mapInstance = null;
  }
  mapMarkers = [];
  mapLines = [];

  // Init map
  mapInstance = L.map('map').setView([lat, lon], 4);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 18,
  }).addTo(mapInstance);

  // User location marker (blue)
  const userIcon = L.divIcon({
    html: '<div style="background:#3b82f6;width:20px;height:20px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3)"></div>',
    iconSize: [20, 20],
    iconAnchor: [10, 10],
    className: ''
  });
  userMarker = L.marker([lat, lon], { icon: userIcon, zIndexOffset: 1000 })
    .addTo(mapInstance)
    .bindPopup(`<b>📍 Your Location</b><br>${lat.toFixed(4)}, ${lon.toFixed(4)}`);

  // Accuracy circle
  userCircle = L.circle([lat, lon], {
    radius: 5000,
    color: '#3b82f6',
    fillColor: '#3b82f6',
    fillOpacity: 0.08,
    weight: 1,
    opacity: 0.3
  }).addTo(mapInstance);

  // Airport markers
  const colors = ['#2ca4dc', '#2563eb', '#10b981', '#f59e0b', '#ef4444',
                  '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#6366f1'];

  airports.forEach((ap, i) => {
    const color = colors[i % colors.length];
    const iataCode = ap.i || '';
    const slug = iataCode ? `/airports/${iataCode}/` : '#';

    const icon = L.divIcon({
      html: `<div style="background:${color};width:28px;height:28px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700">${i + 1}</div>`,
      iconSize: [28, 28],
      iconAnchor: [14, 14],
      className: ''
    });

    const popupHtml = `<b>#${i + 1}: ${escHtml(ap.n)}</b><br>
      ${iataCode ? `<b>${iataCode}</b> · ` : ''}${escHtml(ap.m || '')}, ${escHtml(ap.c)}<br>
      📏 ${ap.d_km.toFixed(1)} km (${(ap.d_km * 0.621371).toFixed(1)} mi) from your location
      ${iataCode ? `<br><a href="${slug}" target="_blank">🔗 View airport page</a>` : ''}`;

    const marker = L.marker([ap.y, ap.x], { icon: icon })
      .addTo(mapInstance)
      .bindPopup(popupHtml);

    marker._airportIdx = i;
    marker.on('click', () => highlightAirport(i));

    mapMarkers.push(marker);

    // Distance line from user to airport
    const line = L.polyline([[lat, lon], [ap.y, ap.x]], {
      color: color,
      weight: 2,
      opacity: 0.4,
      dashArray: '6, 8'
    }).addTo(mapInstance);
    mapLines.push(line);

    // Distance label at midpoint
    const midLat = (lat + ap.y) / 2;
    const midLon = (lon + ap.x) / 2;
    L.marker([midLat, midLon], {
      icon: L.divIcon({
        html: `<div style="background:rgba(255,255,255,.9);border:1px solid ${color};border-radius:4px;padding:2px 6px;font-size:10px;font-weight:600;color:${color};white-space:nowrap">${ap.d_km.toFixed(0)} km</div>`,
        iconSize: [0, 0],
        iconAnchor: [0, 0],
        className: ''
      }),
      interactive: false
    }).addTo(mapInstance);
  });

  // Fit bounds to show all markers
  const allPoints = [[lat, lon], ...airports.map(ap => [ap.y, ap.x])];
  mapInstance.fitBounds(allPoints, { padding: [50, 50], maxZoom: 10 });

  // Note
  const note = document.getElementById('map-note');
  note.style.display = 'block';
  note.innerHTML = '🖱️ Click an airport on the map or in the list to highlight it. Distance lines shown in dashed colors.';
}

// ─── Highlight Airport (table row + sidebar + map) ─────────────────
function highlightAirport(idx) {
  if (activeSidebarIdx === idx) return;

  // Remove previous highlight
  if (activeSidebarIdx >= 0) {
    const prevRow = document.querySelector(`#results-tbody tr[data-idx="${activeSidebarIdx}"]`);
    if (prevRow) prevRow.classList.remove('highlight');
    const prevItem = document.querySelector(`.sidebar-item[data-idx="${activeSidebarIdx}"]`);
    if (prevItem) prevItem.classList.remove('active');
    // Reset marker opacity
    if (mapMarkers[activeSidebarIdx]) {
      mapMarkers[activeSidebarIdx].setZIndexOffset(0);
      const el = mapMarkers[activeSidebarIdx].getElement();
      if (el) el.style.opacity = '1';
    }
  }

  // Highlight new
  activeSidebarIdx = idx;
  const row = document.querySelector(`#results-tbody tr[data-idx="${idx}"]`);
  if (row) row.classList.add('highlight');
  const item = document.querySelector(`.sidebar-item[data-idx="${idx}"]`);
  if (item) {
    item.classList.add('active');
    item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }
  if (mapMarkers[idx]) {
    mapMarkers[idx].setZIndexOffset(1000);
    mapMarkers[idx].openPopup();
  }
}

// ─── Show on Map (zoom to airport) ─────────────────────────────────
function showOnMap(idx) {
  if (!mapInstance || !mapMarkers[idx]) return;
  const ap = mapMarkers[idx].getLatLng();
  mapInstance.setView(ap, 10, { animate: true });
  highlightAirport(idx);
}

// ─── Helpers ───────────────────────────────────────────────────────
function showError(msg) {
  const el = document.getElementById('error');
  el.textContent = msg;
  el.classList.add('show');
  document.getElementById('loading').classList.remove('show');
}

function escHtml(str) {
  if (typeof str !== 'string') return str;
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// ─── Enter Key / Auto-submit ───────────────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('lat-input').addEventListener('keydown', e => { if (e.key === 'Enter') findNearest(); });
  document.getElementById('lon-input').addEventListener('keydown', e => { if (e.key === 'Enter') findNearest(); });
  document.getElementById('city-select').addEventListener('change', function() {
    if (this.value) findNearest();
  });
});
</script>

</body>
</html>
