  b787:     {fuel:7.5, seats:290, name:"Boeing 787-9 Dreamliner"},
  a350:     {fuel:8.0, seats:330, name:"Airbus A350-900"},
  b777:     {fuel:11.0,seats:350, name:"Boeing 777-300ER"},
  b747:     {fuel:14.0,seats:400, name:"Boeing 747-400"},
  a380:     {fuel:16.0,seats:500, name:"Airbus A380"},
  concorde: {fuel:25.0,seats:100, name:"Concorde"},
};

// Comparison transport modes: kg CO₂ per passenger-km
const COMPARISON={
  car:      {name:"🚗 Car (1 person)",     co2PerKm:0.170},
  carShared:{name:"🚗 Car (4 people)",     co2PerKm:0.043},
  bus:      {name:"🚌 Long-distance Bus",  co2PerKm:0.030},
  train:    {name:"🚆 High-speed Rail",    co2PerKm:0.006},
  ferry:    {name:"⛴️ Ferry",              co2PerKm:0.120},
  motorbike:{name:"🏍️ Motorcycle",         co2PerKm:0.115},
};

AIRPORTS.sort((a,b)=>a.iata.localeCompare(b.iata));

function init(){
  const fromSel=document.getElementById('em-from');
  const toSel=document.getElementById('em-to');
  AIRPORTS.forEach(a=>{
    const opt1=document.createElement('option');
    opt1.value=a.iata;
    opt1.textContent=a.iata+' — '+a.n+', '+a.c;
    fromSel.appendChild(opt1);
    const opt2=opt1.cloneNode(true);
    toSel.appendChild(opt2);
  });
  fromSel.value='LHR';
  toSel.value='JFK';
}

function swapAirports(){
  const from=document.getElementById('em-from');
  const to=document.getElementById('em-to');
  const tmp=from.value;
  from.value=to.value;
  to.value=tmp;
}

function setRoute(from,to){
  document.getElementById('em-from').value=from;
  document.getElementById('em-to').value=to;
  calcEmissions();
}

function haversine(lat1,lon1,lat2,lon2){
  const R=6371;
  const dLat=(lat2-lat1)*Math.PI/180;
  const dLon=(lon2-lon1)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

function calcEmissions(){
  const fromIATA=document.getElementById('em-from').value;
  const toIATA=document.getElementById('em-to').value;
  const acKey=document.getElementById('em-aircraft').value;
  if(!fromIATA||!toIATA||!acKey)return;
  const from=AIRPORTS.find(a=>a.iata===fromIATA);
  const to=AIRPORTS.find(a=>a.iata===toIATA);
  const ac=AIRCRAFT[acKey];
  if(!from||!to||!ac)return;

  const km=haversine(from.y,from.x,to.y,to.x);
  const fuelLiters=km*ac.fuel;
  const co2Total=Math.round(fuelLiters*2.52); // 2.52 kg CO₂ per liter jet fuel
  const co2PerPax=Math.round(co2Total/ac.seats);
  const co2PerKm=Math.round((co2Total/km)*10)/10;
  const trees=Math.round(co2Total/25); // ~25kg CO₂ absorbed per tree per year

  document.getElementById('res-km').textContent=Math.round(km).toLocaleString();
  document.getElementById('res-co2-total').textContent=co2Total.toLocaleString();
  document.getElementById('res-co2-pax').textContent=co2PerPax.toLocaleString();
  document.getElementById('res-co2-km').textContent=co2PerKm;
  document.getElementById('res-fuel').textContent=Math.round(fuelLiters).toLocaleString();
  document.getElementById('res-trees').textContent=trees.toLocaleString();

  document.getElementById('route-info').innerHTML=
    '<span class="airport">'+from.n+' ('+from.iata+')</span>'+
    '<span class="plane">✈</span>'+
    '<span class="airport">'+to.n+' ('+to.iata+')</span>'+
    ' <span style="color:#8899aa;font-size:12px">on '+ac.name+'</span>';

  // Build comparison table
  const tbody=document.getElementById('comparison-body');
  tbody.innerHTML='';
  const modes=Object.entries(COMPARISON);
  // Sort by CO₂ ascending
  modes.sort((a,b)=>a[1].co2PerKm-b[1].co2PerKm);
  modes.forEach(([key,mode])=>{
    const modeCo2=Math.round(mode.co2PerKm*km);
    const ratio=modeCo2>0?Math.round((co2PerPax/modeCo2)*10)/10:'∞';
    const row=document.createElement('tr');
    if(key==='train') row.className='highlight-row';
    row.innerHTML=
      '<td>'+mode.name+'</td>'+
      '<td>'+modeCo2.toLocaleString()+' kg</td>'+
      '<td>'+(ratio==='∞'?'—':ratio+'× '+(ratio>1?'more':'less'))+'</td>';
    tbody.appendChild(row);
  });

  document.getElementById('results').classList.add('show');
  document.getElementById('results').scrollIntoView({behavior:'smooth',block:'start'});
}

document.addEventListener('DOMContentLoaded',init);
</script>
</body>
</html>
