---
import countries from '../_data/countries.js';
import continents from '../_data/continents.json' assert { type: 'json' };
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const totalIata = countries.reduce((s,c) => s + c.iata, 0);
const totalAll = countries.reduce((s,c) => s + c.total, 0);
const totalCountries = countries.length;

const pageTitle = `Download Airport Database — ${totalIata.toLocaleString()} IATA Airports, ${totalCountries} Countries | CSV, JSON, SQL`;
const pageDesc = `Free download of the complete World Airport Database. ${totalIata.toLocaleString()} IATA-coded airports in CSV, JSON, and SQL formats. Support the project via PayPal.`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href="https://world-airport-database.com/download/">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content="https://world-airport-database.com/download/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.7;font-size:15px}
    :root{--primary:#2ca4dc;--primary-dark:#2390c2;--navy:#0B1D3A;--border:#D4E0E8;--card-bg:#fff;--text:#202c39;--text-light:#5A6B7F;--text-muted:#8899aa;--success:#10b981}
    a{color:var(--primary);text-decoration:none;transition:color .15s}
    a:hover{color:#1e85b8}
    .wrap{max-width:1100px;margin:0 auto;padding:0 20px}

    .hero{background:linear-gradient(135deg,#0B1D3A 0%,#142b4f 100%);padding:56px 0 48px;color:#fff;text-align:center;position:relative;overflow:hidden}
    .hero::before{content:'';position:absolute;top:-150px;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(44,164,220,.18) 0%,transparent 70%);pointer-events:none}
    .hero h1{font-size:42px;font-weight:800;letter-spacing:-1px;margin-bottom:10px;position:relative}
    .hero h1 .accent{color:#60a5fa}
    .hero .sub{color:rgba(255,255,255,.7);font-size:16px;max-width:600px;margin:0 auto 18px;position:relative}
    .hero-stats{display:flex;gap:28px;justify-content:center;flex-wrap:wrap;font-size:14px;color:rgba(255,255,255,.6);position:relative}
    .hero-stats strong{color:#60a5fa;font-weight:800;font-size:18px;display:block}

    .section{background:#fff;margin:24px 0;border-radius:14px;padding:32px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
    .section h2{font-size:24px;font-weight:800;color:var(--navy);margin-bottom:6px;display:flex;align-items:center;gap:10px}
    .section .sec-desc{color:var(--text-light);font-size:14px;margin-bottom:20px;max-width:600px}

    /* Free download */
    .free-section{background:linear-gradient(135deg,#f0fdf4 0%,#dcfce7 100%);border:2px solid #86efac;text-align:center}
    .free-section h2{color:#15803d;justify-content:center}
    .free-section .sec-desc{color:#166534;margin-left:auto;margin-right:auto}
    .download-formats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}
    @media(max-width:640px){.download-formats{grid-template-columns:1fr}}
    .format-card{background:#fff;border:2px solid var(--border);border-radius:10px;padding:18px;text-align:center;transition:all .15s;text-decoration:none;color:inherit;display:block}
    .format-card:hover{border-color:var(--primary);text-decoration:none;transform:translateY(-2px);box-shadow:0 6px 20px rgba(44,164,220,.1)}
    .format-card .ic{font-size:32px;margin-bottom:6px}
    .format-card .name{font-weight:700;color:var(--navy);margin-bottom:2px}
    .format-card .desc{font-size:11px;color:var(--text-muted)}
    .format-card .size{font-size:10px;color:var(--text-muted);margin-top:4px;font-family:'SF Mono',monospace}

    /* Donate */
    .donate-section{background:linear-gradient(135deg,#fffbeb 0%,#fef3c7 100%);border:2px solid #fcd34d}
    .donate-section h2{color:#92400e;justify-content:center}
    .donate-section .sec-desc{color:#a16207;margin-left:auto;margin-right:auto}
    .paypal-form{margin:16px 0}
    .paypal-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;background:#FFC439;color:#003087;border:0;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;text-decoration:none;transition:all .15s}
    .paypal-btn:hover{background:#FFB400;text-decoration:none;transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.15)}
    .paypal-btn .pp-logo{font-weight:900;font-size:18px;letter-spacing:-.5px}
    .donate-note{font-size:12px;color:#a16207;margin-top:10px}

    /* Features grid */
    .feature-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:16px}
    .feature{background:#f8fafc;border:1px solid var(--border);border-radius:10px;padding:18px}
    .feature .ic{font-size:24px;margin-bottom:6px;display:block}
    .feature h3{font-size:15px;color:var(--navy);font-weight:700;margin-bottom:4px}
    .feature p{font-size:12.5px;color:var(--text-light);line-height:1.5}
    .feature ul{list-style:none;padding:0;margin:8px 0 0;font-size:12px;color:var(--text)}
    .feature ul li{padding:3px 0;display:flex;align-items:flex-start;gap:6px}
    .feature ul li::before{content:'✓';color:var(--success);font-weight:700;flex-shrink:0}

    /* Preview table */
    .preview-table{width:100%;border-collapse:collapse;font-size:12px;background:#fff;border-radius:8px;overflow:hidden;border:1px solid var(--border);margin-top:12px}
    .preview-table th{background:var(--navy);color:#fff;padding:8px 12px;text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;font-weight:600}
    .preview-table td{padding:6px 12px;border-bottom:1px solid var(--border);font-family:'SF Mono',monospace;font-size:11.5px}
    .preview-table tr:nth-child(even) td{background:#f8fafc}
    .preview-table tr:last-child td{border-bottom:none}

    /* License */
    .license-box{background:#f8fafc;border:1px solid var(--border);border-radius:10px;padding:18px;margin-top:18px}
    .license-box h3{font-size:14px;color:var(--navy);margin-bottom:6px;display:flex;align-items:center;gap:6px}
    .license-box p{font-size:13px;color:var(--text-light)}

    @media(max-width:640px){
      .hero h1{font-size:30px}
      .section{padding:22px 18px;margin:14px 0}
    }
  </style>
</head>
<body>

<SiteNav active="download" />

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <h1>📦 Download Airport <span class="accent">Database</span></h1>
    <p class="sub">The complete open-data airport database — {totalIata.toLocaleString()} IATA airports with codes, coordinates, elevation, type, and country data. Updated regularly.</p>
    <div class="hero-stats">
      <div><strong>{totalIata.toLocaleString()}</strong>IATA Airports</div>
      <div><strong>{totalAll.toLocaleString()}</strong>Total Airports</div>
      <div><strong>{totalCountries}</strong>Countries</div>
      <div><strong>3</strong>Formats</div>
    </div>
  </div>
</section>

<div class="wrap">

  <!-- FREE DOWNLOAD -->
  <div class="section free-section">
    <h2>⬇ Free Download</h2>
    <p class="sec-desc">The complete database is free for personal and commercial use. No registration, no email required. Just download and go.</p>
    <div class="download-formats">
      <a href="/data/world-airports.csv" download class="format-card">
        <div class="ic">📄</div>
        <div class="name">CSV</div>
        <div class="desc">Comma-separated, Excel-ready</div>
        <div class="size">~940 KB · {totalIata.toLocaleString()} rows</div>
      </a>
      <a href="/data/airports.json" download class="format-card">
        <div class="ic">📋</div>
        <div class="name">JSON</div>
        <div class="desc">Web-friendly, perfect for APIs</div>
        <div class="size">~1.9 MB · full data</div>
      </a>
      <a href="/data/world-airports.sql" download class="format-card">
        <div class="ic">🗄️</div>
        <div class="name">SQL</div>
        <div class="desc">MySQL/PostgreSQL schema + inserts</div>
        <div class="size">~2.2 MB · ready to import</div>
      </a>
    </div>
    <p style="font-size:12px;color:#166534;margin-top:8px">License: CC0 (Public Domain Dedication) · Free for any use, including commercial</p>
  </div>

  <!-- DONATE -->
  <div class="section donate-section">
    <h2>💝 Support This Project</h2>
    <p class="sec-desc">This database is free forever, but hosting, updates, and development cost time and money. If it helped you, consider a one-time donation via PayPal.</p>
    <form action="https://www.paypal.com/donate" method="post" target="_blank" class="paypal-form">
      <input type="hidden" name="business" value="rainer@dominik.in">
      <input type="hidden" name="no_recurring" value="0">
      <input type="hidden" name="item_name" value="World Airport Database - Donation">
      <input type="hidden" name="currency_code" value="USD">
      <button type="submit" class="paypal-btn">
        <span class="pp-logo">Pay</span>Pal
      </button>
    </form>
    <p class="donate-note">100% optional. The database stays free regardless. Thank you! 🙏</p>
  </div>

  <!-- WHAT'S INCLUDED -->
  <div class="section">
    <h2>📊 What's Included</h2>
    <p class="sec-desc">Every record contains rich airport data — from major international hubs to small regional airstrips and heliports.</p>
    <div class="feature-grid">
      <div class="feature">
        <span class="ic">🌍</span>
        <h3>Coverage</h3>
        <p>Airports from every country and territory worldwide.</p>
        <ul>
          <li>{totalIata.toLocaleString()} IATA-coded airports</li>
          <li>{totalAll.toLocaleString()} total airports</li>
          <li>{totalCountries} countries & territories</li>
          <li>7 continents including Antarctica</li>
        </ul>
      </div>
      <div class="feature">
        <span class="ic">📑</span>
        <h3>Data Fields</h3>
        <p>Rich per-airport data for every record.</p>
        <ul>
          <li>IATA & ICAO codes</li>
          <li>GPS coordinates (lat/lon)</li>
          <li>Elevation in feet</li>
          <li>Country, region, municipality</li>
          <li>Airport type & size</li>
          <li>Wikipedia link</li>
        </ul>
      </div>
      <div class="feature">
        <span class="ic">🔄</span>
        <h3>Always Current</h3>
        <p>Synced regularly with the OurAirports open dataset.</p>
        <ul>
          <li>Monthly data refreshes</li>
          <li>New airports added</li>
          <li>Code changes tracked</li>
          <li>Versioned releases</li>
        </ul>
      </div>
      <div class="feature">
        <span class="ic">⚖️</span>
        <h3>Open License</h3>
        <p>Truly free — no strings attached.</p>
        <ul>
          <li>Personal use allowed</li>
          <li>Commercial use allowed</li>
          <li>Redistribution allowed</li>
          <li>No attribution required</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- PREVIEW -->
  <div class="section">
    <h2>👀 Data Preview</h2>
    <p class="sec-desc">First 5 rows of the CSV file. The full dataset contains {totalIata.toLocaleString()} rows.</p>
    <table class="preview-table">
      <thead>
        <tr>
          <th>IATA</th>
          <th>ICAO</th>
          <th>Name</th>
          <th>City</th>
          <th>Country</th>
          <th>Lat</th>
          <th>Lon</th>
          <th>Type</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>ATL</td><td>KATL</td><td>Hartsfield Jackson Atlanta Intl</td><td>Atlanta</td><td>United States</td><td>33.6367</td><td>-84.4281</td><td>large</td></tr>
        <tr><td>DXB</td><td>OMDB</td><td>Dubai International</td><td>Dubai</td><td>UAE</td><td>25.2528</td><td>55.3644</td><td>large</td></tr>
        <tr><td>LHR</td><td>EGLL</td><td>London Heathrow</td><td>London</td><td>United Kingdom</td><td>51.4700</td><td>-0.4543</td><td>large</td></tr>
        <tr><td>HND</td><td>RJTT</td><td>Tokyo Haneda</td><td>Tokyo</td><td>Japan</td><td>35.5494</td><td>139.7798</td><td>large</td></tr>
        <tr><td>FRA</td><td>EDDF</td><td>Frankfurt Main</td><td>Frankfurt</td><td>Germany</td><td>50.0267</td><td>8.5431</td><td>large</td></tr>
      </tbody>
    </table>
  </div>

  <!-- LICENSE -->
  <div class="section">
    <h2>⚖️ License & Attribution</h2>
    <p class="sec-desc">Everything you need to know about using this data legally and ethically.</p>
    <div class="license-box">
      <h3>📜 Database License: CC0 (Public Domain)</h3>
      <p>This database is dedicated to the public domain under the <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener">Creative Commons Zero (CC0) license</a>. You can copy, modify, distribute, and use it commercially without asking permission. No attribution required, but appreciated.</p>
    </div>
    <div class="license-box" style="margin-top:12px">
      <h3>📊 Source Data: OurAirports.com</h3>
      <p>The raw data is sourced from <a href="https://ourairports.com/" target="_blank" rel="noopener">OurAirports.com</a>, a community-driven open-data project also licensed under CC0. OurAirports aggregates data from many public sources including national aviation authorities, OpenStreetMap, and user contributions. We process and enrich the data but the underlying facts come from the open-source community.</p>
    </div>
    <div class="license-box" style="margin-top:12px">
      <h3>🏷️ IATA & ICAO Codes</h3>
      <p>The IATA and ICAO codes themselves are factual identifiers assigned by the International Air Transport Association and International Civil Aviation Organization respectively. We are not affiliated with, endorsed by, or sponsored by IATA or ICAO. The codes are factual data and not subject to copyright in their use as identifiers.</p>
    </div>
  </div>

</div>

<SiteFooter />
</body>
</html>
