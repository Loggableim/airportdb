const pageTitle = 'Download Airport Database — World Airport Database';
const pageDesc = 'Download the complete airport database with 85,545 airports. CSV, JSON, and SQL formats. Free download or donate via PayPal.';
const pageUrl = 'https://world-airport-database.com/download/';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:site_name" content="World Airport Database">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Inter',Arial,sans-serif;background:#F4F7FA;color:#202c39;line-height:1.7}
    :root{--primary:#2ca4dc;--navy:#0B1D3A;--border:#D4E0E8;--stripe:#F0F6FC;--green:#22c55e}
    .wrap{max-width:900px;margin:0 auto;padding:0 20px}
    .ah{background:linear-gradient(135deg,var(--navy),#142b4f);padding:40px 0;border-bottom:4px solid var(--primary);text-align:center}
    .ah h1{color:#fff;font-size:32px;margin-bottom:8px}
    .ah .sub{color:#8899aa;font-size:15px;max-width:600px;margin:0 auto}
    .section{padding:40px 0}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin:24px 0}
    .card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:28px;text-align:center;position:relative;overflow:hidden;transition:all .2s}
    .card:hover{border-color:var(--primary);box-shadow:0 4px 20px rgba(44,164,220,.15)}
    .card.featured{border-color:var(--primary);border-width:2px}
    .card.featured::before{content:'MOST POPULAR';position:absolute;top:12px;right:-28px;background:var(--primary);color:#fff;font-size:10px;font-weight:700;padding:4px 32px;transform:rotate(45deg)}
    .card .icon{font-size:40px;margin-bottom:12px}
    .card h3{font-size:18px;color:var(--navy);margin-bottom:6px}
    .card .desc{font-size:13px;color:#5A6B7F;margin-bottom:16px;line-height:1.5}
    .card .price{font-size:28px;font-weight:800;color:var(--navy);margin-bottom:4px}
    .card .price .currency{font-size:16px;font-weight:600}
    .card .note{font-size:11px;color:#8899aa;margin-bottom:16px}
    .card .features{text-align:left;margin:16px 0;padding:0;list-style:none}
    .card .features li{padding:4px 0;font-size:13px;color:#5A6B7F;display:flex;align-items:center;gap:8px}
    .card .features li::before{content:'✓';color:var(--green);font-weight:700}
    .btn{display:inline-block;padding:12px 28px;border-radius:8px;font-size:14px;font-weight:700;text-decoration:none;cursor:pointer;border:none;font-family:inherit;transition:all .15s}
    .btn-primary{background:var(--primary);color:#fff}
    .btn-primary:hover{background:#2390c2;text-decoration:none}
    .btn-free{background:var(--green);color:#fff}
    .btn-free:hover{background:#16a34a;text-decoration:none}
    .btn-outline{background:transparent;color:var(--primary);border:2px solid var(--primary)}
    .btn-outline:hover{background:var(--primary);color:#fff;text-decoration:none}
    .donate-box{background:linear-gradient(135deg,#fff8e1,#fff3cd);border:2px solid #ffc107;border-radius:12px;padding:28px;text-align:center;margin:24px 0}
    .donate-box h3{color:#856404;font-size:20px;margin-bottom:8px}
    .donate-box p{color:#856404;font-size:14px;margin-bottom:16px}
    .formats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0}
    .format{background:#fff;border:1px solid var(--border);border-radius:8px;padding:16px;text-align:center}
    .format .ext{font-size:24px;font-weight:800;color:var(--primary);margin-bottom:4px}
    .format .size{font-size:12px;color:#8899aa}
    .data-preview{background:#fff;border:1px solid var(--border);border-radius:8px;overflow:hidden;margin:16px 0}
    .data-preview table{width:100%;border-collapse:collapse;font-size:12px}
    .data-preview th{background:var(--navy);color:#fff;padding:8px 12px;text-align:left;font-size:11px;text-transform:uppercase}
    .data-preview td{padding:6px 12px;border-bottom:1px solid var(--border)}
    .data-preview tr:nth-child(even) td{background:var(--stripe)}
    .badge{display:inline-block;background:var(--primary);color:#fff;padding:2px 8px;border-radius:3px;font-size:10px;font-weight:700}
    footer{background:var(--navy);color:#8899aa;padding:36px 0 24px;margin-top:40px;border-top:4px solid var(--primary);font-size:13px;text-align:center}
    footer a{color:var(--primary)}
  </style>
</head>
<body>

<nav style="background:#0f172a;padding:10px 0;position:sticky;top:0;z-index:100">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <a href="/" style="color:#fff;font-size:15px;font-weight:700;text-decoration:none">World<span style="color:#60a5fa">Airport</span>DB</a>
    <div style="display:flex;gap:16px;flex-wrap:wrap">
      <a href="/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Home</a>
      <a href="/countries/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Countries</a>
      <a href="/blog/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Blog</a>
      <a href="/tools/distance-calculator/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Distance</a>
      <a href="/tools/iata-icao-lookup/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Lookup</a>
      <a href="/tools/nearest-airport/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Nearest</a>
      <a href="/tools/timezone-lookup/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Timezone</a>
      <a href="/tools/airport-map/" style="color:rgba(255,255,255,.7);text-decoration:none;font-size:13px">Map</a>
    </div>
  </div>
</nav>

<div class="ah">
  <div class="wrap">
    <h1>📦 Download Airport Database</h1>
    <div class="sub">The most comprehensive open airport database. 85,545 airports with IATA/ICAO codes, coordinates, elevation, type, and country data.</div>
  </div>
</div>

<div class="wrap">

  <!-- Free Download -->
  <div class="section" style="text-align:center">
    <h2 style="font-size:24px;color:var(--navy);margin-bottom:8px">Free Download</h2>
    <p style="color:#5A6B7F;font-size:14px;max-width:500px;margin:0 auto 20px">The complete database is available for free. No registration required. If you find it useful, consider donating to support the project.</p>
    <a href="/data/world-airports.csv" download class="btn btn-free" style="font-size:16px;padding:16px 40px">⬇ Download CSV (Free)</a>
    <br><br>
    <a href="/data/airports.json" download class="btn btn-outline" style="margin-right:8px">⬇ JSON</a>
    <a href="/data/world-airports.sql" download class="btn btn-outline">⬇ SQL</a>
  </div>

  <!-- Donate -->
  <div class="donate-box">
    <h3>💝 Support This Project</h3>
    <p>Help us keep the database updated and free for everyone. Any amount is appreciated!</p>
    <form action="https://www.paypal.com/donate" method="post" target="_blank">
      <input type="hidden" name="business" value="rainer@dominik.in">
      <input type="hidden" name="no_recurring" value="0">
      <input type="hidden" name="item_name" value="World Airport Database - Donation">
      <input type="hidden" name="currency_code" value="USD">
      <button type="submit" class="btn btn-primary" style="font-size:16px;padding:14px 36px">💳 Donate via PayPal</button>
    </form>
    <p style="margin-top:12px;font-size:12px;color:#856404">Donations are optional. The database is always free.</p>
  </div>

  <!-- What's Included -->
  <div class="section">
    <h2 style="font-size:22px;color:var(--navy);margin-bottom:16px;text-align:center">What's Included</h2>
    <div class="grid">
      <div class="card">
        <div class="icon">📊</div>
        <h3>85,545 Airports</h3>
        <div class="desc">Every airport from OurAirports dataset, from major international hubs to small airstrips.</div>
        <ul class="features">
          <li>9,056 IATA codes</li>
          <li>Full ICAO codes</li>
          <li>GPS coordinates</li>
          <li>Elevation data</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">🌍</div>
        <h3>247 Countries</h3>
        <div class="desc">Airports from every country and territory worldwide, including remote islands and Antarctica.</div>
        <ul class="features">
          <li>Country & region data</li>
          <li>Continent classification</li>
          <li>Municipality names</li>
          <li>ISO country codes</li>
        </ul>
      </div>
      <div class="card">
        <div class="icon">📋</div>
        <h3>Multiple Formats</h3>
        <div class="desc">Download in the format that works for your project. All formats include the same data.</div>
        <ul class="features">
          <li>CSV — Universal compatibility</li>
          <li>JSON — Developer friendly</li>
          <li>SQL — Direct database import</li>
          <li>Regular updates</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Data Preview -->
  <div class="section">
    <h2 style="font-size:22px;color:var(--navy);margin-bottom:16px;text-align:center">Data Preview</h2>
    <div class="data-preview">
      <table>
        <thead>
          <tr>
            <th>ID</th><th>Ident</th><th>Type</th><th>Name</th><th>Lat</th><th>Lon</th><th>Elev</th><th>Country</th><th>IATA</th><th>ICAO</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>6523</td><td>00A</td><td>heliport</td><td>Total Rf Heliport</td><td>40.07</td><td>-74.93</td><td>11</td><td>United States</td><td></td><td></td></tr>
          <tr><td>3226</td><td>00AA</td><td>small_airport</td><td>Aero B Ranch Airport</td><td>38.70</td><td>-101.47</td><td>3445</td><td>United States</td><td></td><td></td></tr>
          <tr><td>6524</td><td>00AK</td><td>small_airport</td><td>Lowell Field</td><td>59.95</td><td>-151.69</td><td>45</td><td>United States</td><td></td><td></td></tr>
          <tr><td>6525</td><td>00AL</td><td>small_airport</td><td>Epps Airpark</td><td>34.87</td><td>-86.77</td><td>820</td><td>United States</td><td></td><td></td></tr>
          <tr><td>6526</td><td>00AR</td><td>closed</td><td>Newport Hospital & Clinic Heliport</td><td>35.61</td><td>-91.26</td><td>237</td><td>United States</td><td></td><td></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Formats -->
  <div class="section">
    <h2 style="font-size:22px;color:var(--navy);margin-bottom:16px;text-align:center">Available Formats</h2>
    <div class="formats">
      <div class="format">
        <div class="ext">CSV</div>
        <div class="size">~15 MB</div>
        <div style="font-size:11px;color:#8899aa;margin-top:4px">Excel, Google Sheets, R, Pandas</div>
      </div>
      <div class="format">
        <div class="ext">JSON</div>
        <div class="size">~25 MB</div>
        <div style="font-size:11px;color:#8899aa;margin-top:4px">JavaScript, Python, APIs</div>
      </div>
      <div class="format">
        <div class="ext">SQL</div>
        <div class="size">~20 MB</div>
        <div style="font-size:11px;color:#8899aa;margin-top:4px">MySQL, PostgreSQL, SQLite</div>
      </div>
    </div>
  </div>

  <!-- License -->
  <div class="section" style="text-align:center">
    <h2 style="font-size:22px;color:var(--navy);margin-bottom:8px">License & Usage</h2>
    <p style="color:#5A6B7F;font-size:14px;max-width:600px;margin:0 auto">
      Data sourced from <strong>OurAirports</strong> (open data, public domain). Free for personal and commercial use.
      Attribution appreciated but not required. Not affiliated with IATA or ICAO.
    </p>
  </div>

  <a href="/" style="display:inline-block;margin:20px 0;color:var(--primary);font-weight:600;font-size:14px;text-decoration:none">&larr; Back to World Airport Database</a>
</div>

<footer>
  <div class="wrap">
    <div><strong>World Airport Database since 2008</strong> — based on open data from <a href="https://ourairports.com/" target="_blank">OurAirports</a></div>
    <div style="margin-top:8px">Not affiliated with IATA or ICAO.</div>
    <div style="margin-top:10px"><a href="/impressum/">Impressum</a></div>
  </div>
</footer>
</body>
</html>
