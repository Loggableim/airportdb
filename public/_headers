# Security and performance headers for Cloudflare Pages
# Applied to all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static assets — long cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/logo.svg
  Cache-Control: public, max-age=31536000, immutable

/logo-icon.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# Sitemap — 1 hour cache
/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600

# HTML pages — 4 hour cache (CDN edge, browsers revalidate)
/airports/*
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400

/countries/*
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400

/blog/*
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400

/tools/*
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400

# IndexNow key file — no cache
/56a5410313df4206b9233ce24fb89458.txt
  Cache-Control: public, max-age=0, must-revalidate
